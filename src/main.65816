; ============================================================================
; Superman Arcade → SNES Port
; WLA-DX 65816 Assembly — LoROM
; ============================================================================

; === ROM Configuration ===
.MEMORYMAP
DEFAULTSLOT 0
SLOTSIZE $8000
SLOT 0 $8000           ; LoROM: bank 0 at CPU $8000-$FFFF
.ENDME

.ROMBANKSIZE $8000     ; 32KB per bank (LoROM)
.ROMBANKS 2            ; 2 x 32KB = 64KB (expand later)

.EMPTYFILL $00

; ============================================================================
; Bank 0 — Code
; ============================================================================
.bank 0 slot 0
.org $0000

cop_handler:
  rti
brk_handler:
  rti
irq_handler:
  rti

; --- Reset Handler ---
reset:
  sei
  clc
  xce                   ; Enter native mode
  rep #$30              ; 16-bit A/X
  lda #$1FFF
  tcs                   ; Set stack pointer

  jsr init_ppu
  jsr init_input
  jsr init_game_state

  sep #$20              ; 8-bit A
  lda #$81              ; Enable NMI + auto-joypad
  sta $4200             ; NMITIMEN
  rep #$30
  cli

; --- Main Loop ---
main_loop:
  wai
  bra main_loop

; --- NMI Handler ---
nmi_handler:
  php
  rep #$30
  sep #$20
  lda $4210             ; RDNMI - acknowledge NMI
  rep #$30
  inc $0000             ; FRAME_COUNT++
  jsr read_input
  jsr game_tick
  jsr update_ppu
  plp
  rti

; --- Game Tick ---
game_tick:
  php
  rep #$30
  lda $0002             ; GAME_STATE
  cmp #$0000
  beq .title
  cmp #$0001
  beq .play
  bra .done
.title:
  jsr process_title
.play:
  jsr process_player
  jsr process_enemies
  jsr process_physics
  jsr process_collision
  jsr process_scroll
  jsr process_sprites
  jsr process_sound
.done:
  plp
  rts

; --- PPU Init ---
init_ppu:
  php
  sep #$20
  lda #$80
  sta $2100             ; INIDISP: force blank

  lda #$01
  sta $2105             ; BGMODE: mode 1

  lda #$04
  sta $2107             ; BG1SC: tilemap at $0400
  lda #$04
  sta $2108             ; BG2SC: tilemap at $0800
  lda #$00
  sta $210B             ; BG12NBA: tiles at $0000
  lda #$08
  sta $210C             ; BG34NBA: tiles at $4000

  lda #$03
  sta $212C             ; TM: BG1+BG2 main screen

  lda #$01
  sta $420D             ; MEMSEL: fast ROM

  ; Palette: color 0 = white, color 1 = black
  lda #$00
  sta $2121             ; CGADD: color 0
  lda #$FF
  sta $2122             ; CGDATA
  lda #$7F
  sta $2122             ; CGDATA (white = $7FFF)

  lda #$02
  sta $2121             ; CGADD: color 1
  lda #$00
  sta $2122             ; CGDATA
  lda #$00
  sta $2122             ; CGDATA (black = $0000)

  ; Turn on screen (full brightness)
  lda #$0F
  sta $2100             ; INIDISP

  rep #$30
  plp
  rts

; --- Input ---
init_input:
  php
  rep #$30
  stz $0020             ; INPUT_CUR
  stz $0022             ; INPUT_PREV
  plp
  rts

read_input:
  php
  rep #$30
  lda $0020
  sta $0022             ; save previous
  sep #$20
  lda $4218             ; JOY1L
  rep #$30
  and #$00FF
  sta $0020
  plp
  rts

; --- Game State Init ---
init_game_state:
  php
  rep #$30
  stz $0000             ; FRAME_COUNT
  lda #$0001
  sta $0002             ; GAME_STATE = playing
  stz $0003             ; LEVEL
  lda #$0003
  sta $0004             ; LIVES
  stz $0005             ; SCORE
  stz $0007
  stz $0009             ; PLAYER_X
  stz $000B             ; PLAYER_Y
  stz $0040             ; SCROLL_X
  stz $0042             ; SCROLL_Y
  plp
  rts

; --- PPU Update ---
update_ppu:
  php
  sep #$20
  lda $0040
  sta $210D             ; BG1HOFS
  lda $0042
  sta $210E             ; BG1VOFS
  rep #$30
  plp
  rts

; --- Game Processors (stubs) ---
process_title:
  php
  rep #$30
  lda $0020             ; INPUT_CUR
  and #$80              ; START button
  beq .no_start
  lda #$0001
  sta $0002             ; GAME_STATE = playing
.no_start:
  plp
  rts

process_player:   rts
process_enemies:  rts
process_physics:  rts
process_collision: rts
process_scroll:   rts
process_sprites:  rts
process_sound:    rts

; ============================================================================
; LoROM Header + Vectors at $7FC0
; ============================================================================
.org $7FC0

  ; --- Header ($7FC0-$7FDF) ---
  .db "XX"              ; maker code
  .db "SMAN"            ; game code
  .dsb 7, 0             ; reserved
  .db 0                 ; expansion RAM size
  .db 0                 ; special version
  .db 0                 ; sub-cartridge type
  .db "SUPERMAN ARCADE      "  ; title (21 bytes)
  .db $30               ; mapping: LoROM + FastROM
  .db $00               ; cart type: ROM only
  .db $08               ; ROM size: 256KB
  .db $00               ; RAM size: none
  .db $01               ; country: USA
  .db $33               ; licensee code
  .db $00               ; version
  .dw $0000             ; checksum placeholder
  .dw $0000             ; checksum complement placeholder

  ; --- Native mode vectors ($7FE0-$7FEE) ---
  .dw $0000             ; $FFE0: Reserved
  .dw $0000             ; $FFE2: Reserved
  .dw cop_handler       ; $FFE4: COP
  .dw brk_handler       ; $FFE6: BRK
  .dw $0000             ; $FFE8: ABORT
  .dw nmi_handler       ; $FFEA: NMI
  .dw $0000             ; $FFEC: Reserved
  .dw irq_handler       ; $FFEE: IRQ

  ; --- Emulation mode vectors ($7FF0-$7FFE) ---
  .dw $0000             ; $FFF0: Reserved
  .dw $0000             ; $FFF2: Reserved
  .dw cop_handler       ; $FFF4: COP
  .dw $0000             ; $FFF6: BRK
  .dw $0000             ; $FFF8: ABORT
  .dw nmi_handler       ; $FFFA: NMI
  .dw reset             ; $FFFC: RESET
  .dw irq_handler       ; $FFFE: IRQ
