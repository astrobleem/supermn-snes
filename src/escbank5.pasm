    ; LINK + MOVEM.L A0-A4 + MOVEM.W D0-D6 leave 38 bytes below entry SP.
    ; Write the exact big-endian residue from low to high address.
    lda $3C
    sec
    sbc #$0026
    tax
    lda $00
    xba
    sta $400000,x
    inx
    inx
