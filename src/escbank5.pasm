    lda $3A
    xba
    sta $400000,x
    inx
    inx
    lda $38
    xba
    sta $400000,x

    ; MC68000 MOVEM.W memory-to-Dn sign-extends each restored low word.
    ldx #$0000
    ldy #$0007
h2742_sign_extend:
    lda $00,x
    bpl h2742_sign_positive
    lda #$FFFF
    bra h2742_sign_store
h2742_sign_positive:
    lda #$0000
h2742_sign_store:
    sta $02,x
    inx
    inx
    inx
    inx
    dey
    bne h2742_sign_extend
    lda #$0004
    sta $1C
    stz $1E

