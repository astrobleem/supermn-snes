    cld
    ldy #$0036
    lda [$66],y
    xba
    lsr a
    lsr a
    and #$F800
    clc
    adc $82
    php
    sep #$20
    pla
    rep #$30
    and #$00FF
    sta $50
    and #$0002
    sta $60                         ; Z
    lda $50
    and #$0080
    sta $70                         ; N
    lda $50
    and #$0040
    sta $72                         ; V
    lda $50
    and #$0001
    sta $6E                         ; C
    sta $A2                         ; X = C for ADD.W

