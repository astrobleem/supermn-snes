; <<< ESCBANK6_LATE_COMBAT_BODIES <<<

; Bank-local twin of escbank2's esc_ac_charge.  Transpiled bank-$95 bodies use
; 16-bit JSRs, so keep the exact clamp and stack contract local instead of
; crossing banks: A=N, subtract N from the virtual 68K instruction budget,
; clamp at one so the main interpreter loop raises the IRQ at a clean boundary.
esc6_ac_charge:
    rep #$30
    pha
    lda $AC
    sec
    sbc $01,s
    bcc esc6_ac_clamp
    beq esc6_ac_clamp
    sta $AC
    pla
    rts
esc6_ac_clamp:
    lda #$0001
    sta $AC
    pla
    rts

; ============================================================================
; $025110 stage-1 compact-active collision pass.
;
; entry_25110 has already proved A5=$00F00000 and handled the game-mode-$2
; early exit.  The original 68K pass walks 31 fixed 16-byte records and only
; compares records whose word 0 is positive and whose type word at +$0A is
; neither $00BF nor $00BD.  Cache at most sixteen qualifying low pointers in
; interpreter scratch, plus their immutable rectangle edges in transient
; IRAM $0100-$017F, then visit the same (i,j) pairs in ascending order.  This
; range is also h158's non-concurrent DMA staging area; the SA-1 executes the
; two routines serially and neither publishes the staging bytes.  Membership
; and rectangle fields are never written by this pass, so the compact list
; preserves the original pair order and all live dependencies.
;
; A seventeenth active record or fewer than two active records delegates to
; the byte-retained generated loop before any game-state write.  The fast exit
; recreates the generated loop's exhausted D5-D7/A0-A1 state and resumes at
; its fixed $02532C lowering seam in bank $97.
; ============================================================================
    .org $F000
h25110_stage1:
    rep #$30
    .a16
    .i16

    stz $50                  ; active count
    ldx #$3A74
    lda #$001F
    sta $52                  ; 31 records
h25_scan:
    lda $400000,x
    xba
    beq h25_scan_next
    bmi h25_scan_next        ; 68K TST.W / BLE
    lda $40000A,x
    xba
    cmp #$00BF
    beq h25_scan_next
    cmp #$00BD
    beq h25_scan_next
    lda $50
    cmp #$0010
    bcc h25_scan_store
    jmp h25_fallback
h25_scan_store:
    lda $50
    asl a
    tay
    txa
    sta $0080,y              ; sixteen low-word pointer slots, $80-$9F
    ; Convert the pointer-list byte offset (count*2) to the edge-cache byte
    ; offset (count*8).  Cache logical big-endian 68K words so the pair loop
    ; can use fast IRAM reads without repeated XBA/long BW-RAM accesses.
    tya
    asl a
    asl a
    tay
    lda $400002,x
    xba
    sta $0100,y              ; x1
    lda $400004,x
    xba
    sta $0102,y              ; x2
    lda $400006,x
    xba
    sta $0104,y              ; y1
    lda $400008,x
    xba
    sta $0106,y              ; y2
    inc $50
h25_scan_next:
    txa
    clc
    adc #$0010
    tax
    dec $52
    bne h25_scan

    lda $50
    cmp #$0002
    bcs h25_pairs_begin
    jmp h25_fallback

h25_pairs_begin:
    stz $52                  ; compact outer index
h25_outer:
    lda $52
    asl a
    tay
    lda $0080,y
    sta $58                  ; a0 low pointer
    sta $20                  ; observable emulated A0.low
    lda #$00F0
    sta $22
    stz $14                  ; CLR.W D5 for every active outer record
    lda $52
    asl a
    asl a
    asl a
    sta $5E                  ; outer edge-cache byte offset
    lda $52
    inc a
    sta $56                  ; compact inner index

h25_inner:
    lda $56
    asl a
    tay
    lda $0080,y
    sta $5A                  ; a1 low pointer
    sta $24                  ; observable emulated A1.low
    lda #$00F0
    sta $26

    lda $56
    asl a
    asl a
    asl a
    tay                      ; inner edge-cache byte offset
    ldx $5E                  ; outer edge-cache byte offset

    ; Signed rectangle reject tests.  Test the far edge first on each axis: in
    ; the production collision set it rejects most pairs without paying for
    ; the opposite edge.  These reads do not mutate either record.  On a
    ; reject, the last D0.W value is still the same edge the original order
    ; would have left; on a pass the following axis/response overwrites it.
    ; h25_sge/h25_sgt derive N xor V exactly like the retained 68000 lowering,
    ; so rectangles may cross signed coordinate zero without delegating.
    lda $0100,y
    eor #$8000           ; signed order -> unsigned order
    sta $5C
    lda $0102,x
    sta $00                  ; D0.W = a0.x2
    eor #$8000
    cmp $5C
    bcs h25_overlap_x1       ; a0.x2 >= a1.x1
    jmp h25_pair_next
h25_overlap_x1:

    lda $0100,x
    sta $00                  ; D0.W = a0.x1
    eor #$8000
    sta $5C
    lda $0102,y
    eor #$8000
    cmp $5C
    bcs h25_overlap_x_done   ; a1.x2 >= a0.x1
    jmp h25_pair_next
h25_overlap_x_done:

    lda $0104,y
    eor #$8000
    sta $5C
    lda $0106,x
    sta $00                  ; D0.W = a0.y2
    eor #$8000
    cmp $5C
    bcs h25_overlap_y1       ; a0.y2 >= a1.y1
    jmp h25_pair_next
h25_overlap_y1:

    lda $0104,x
    sta $00                  ; D0.W = a0.y1
    eor #$8000
    sta $5C
    lda $0106,y
    eor #$8000
    cmp $5C
    bcs h25_overlap_done     ; a1.y2 >= a0.y1
    jmp h25_pair_next
h25_overlap_done:

    ; X-axis response.
    ldx $5A
    lda $400002,x
    xba
    sta $00                  ; D0.W = a1.x1
    ldx $58
    lda $400002,x
    xba
    sta $5C
    lda $00
    sec
    sbc $5C
    jsr h25_slt
    bcs h25_x_left

    ldx $5A
    lda $400004,x
    xba
    sta $04                  ; D1.W = a1.x2
    ldx $58
    lda $400004,x
    xba
    sta $5C
    lda $04
    sec
    sbc $5C
    jsr h25_slt
    bcc h25_x_right_overlap
    jmp h25_x_clear
h25_x_right_overlap:

    lda $00                  ; right overlap = a1.x1-a0.x2-1
    sec
    sbc $5C
    dec a
    sta $00
    ldx $58
    lda $40000E,x
    xba
    bne h25_x_right_a1
    sep #$20
    lda $00
    sta $40000C,x
    rep #$20
h25_x_right_a1:
    ldx $5A
    lda $40000E,x
    xba
    beq h25_x_right_store_a1
    jmp h25_meta
h25_x_right_store_a1:
    lda $00
    eor #$FFFF
    inc a
    sta $00
    sep #$20
    lda $00
    sta $40000C,x
    rep #$20
    jmp h25_y_begin

h25_x_left:
    ldx $5A
    lda $400004,x
    xba
    sta $04                  ; D1.W = a1.x2
    ldx $58
    lda $400004,x
    xba
    sta $5C
    lda $04
    sec
    sbc $5C
    jsr h25_sgt
    bcs h25_x_clear
    ldx $58
    lda $400002,x
    xba
    sta $5C
    lda $04                  ; left overlap = a1.x2-a0.x1+1
    sec
    sbc $5C
    inc a
    sta $04
    ldx $58
    lda $40000E,x
    xba
    bne h25_x_left_a1
    sep #$20
    lda $04
    sta $40000C,x
    rep #$20
h25_x_left_a1:
    ldx $5A
    lda $40000E,x
    xba
    beq h25_x_left_store_a1
    jmp h25_meta
h25_x_left_store_a1:
    lda $04
    eor #$FFFF
    inc a
    sta $04
    sep #$20
    lda $04
    sta $40000C,x
    rep #$20
    jmp h25_y_begin

h25_x_clear:
    ldx $58
    lda $40000E,x
    xba
    bne h25_x_clear_a1
    sep #$20
    stz $40000C,x
    rep #$20
h25_x_clear_a1:
    ldx $5A
    lda $40000E,x
    xba
    beq h25_x_clear_store_a1
    jmp h25_meta
h25_x_clear_store_a1:
    sep #$20
    stz $40000C,x
    rep #$20

    ; Y-axis response (same topology, fields +6/+8 and byte +$0D).
h25_y_begin:
    ldx $5A
    lda $400006,x
    xba
    sta $00                  ; D0.W = a1.y1
    ldx $58
    lda $400006,x
    xba
    sta $5C
    lda $00
    sec
    sbc $5C
    jsr h25_slt
    bcs h25_y_above

    ldx $5A
    lda $400008,x
    xba
    sta $04                  ; D1.W = a1.y2
    ldx $58
    lda $400008,x
    xba
    sta $5C
    lda $04
    sec
    sbc $5C
    jsr h25_slt
    bcc h25_y_lower_overlap
    jmp h25_y_clear
h25_y_lower_overlap:

    lda $00                  ; lower overlap = a1.y1-a0.y2-1
    sec
    sbc $5C
    dec a
    sta $00
    ldx $58
    lda $40000E,x
    xba
    bne h25_y_lower_a1
    sep #$20
    lda $00
    sta $40000D,x
    rep #$20
h25_y_lower_a1:
    ldx $5A
    lda $40000E,x
    xba
    beq h25_y_lower_store_a1
    jmp h25_meta
h25_y_lower_store_a1:
    lda $00
    eor #$FFFF
    inc a
    sta $00
    sep #$20
    lda $00
    sta $40000D,x
    rep #$20
    jmp h25_meta

h25_y_above:
    ldx $5A
    lda $400008,x
    xba
    sta $04                  ; D1.W = a1.y2
    ldx $58
    lda $400008,x
    xba
    sta $5C
    lda $04
    sec
    sbc $5C
    jsr h25_sgt
    bcs h25_y_clear
    ldx $58
    lda $400006,x
    xba
    sta $5C
    lda $04                  ; upper overlap = a1.y2-a0.y1+1
    sec
    sbc $5C
    inc a
    sta $04
    ldx $58
    lda $40000E,x
    xba
    bne h25_y_above_a1
    sep #$20
    lda $04
    sta $40000D,x
    rep #$20
h25_y_above_a1:
    ldx $5A
    lda $40000E,x
    xba
    bne h25_meta
    lda $04
    eor #$FFFF
    inc a
    sta $04
    sep #$20
    lda $04
    sta $40000D,x
    rep #$20
    jmp h25_meta

h25_y_clear:
    ldx $58
    lda $40000E,x
    xba
    bne h25_y_clear_a1
    sep #$20
    stz $40000D,x
    rep #$20
h25_y_clear_a1:
    ldx $5A
    lda $40000E,x
    xba
    bne h25_meta
    sep #$20
    stz $40000D,x
    rep #$20

    ; Collision-type propagation at $252A8-$25312.
h25_meta:
    ldx $58
    lda $40000A,x
    xba
    cmp #$8001
    beq h25_meta_special
    cmp #$8002
    beq h25_meta_special
    ldx $5A
    lda $40000A,x
    xba
    cmp #$8001
    beq h25_meta_special
    cmp #$8002
    bne h25_meta_normal
h25_meta_special:
    ldx $58
    lda $40000A,x
    xba
    sec
    sbc #$00A0
    jsr h25_sge
    bcs h25_pair_next
    ldx $5A
    lda $40000A,x
    xba
    sec
    sbc #$00A0
    jsr h25_sge
    bcs h25_pair_next

h25_meta_normal:
    ldx $58
    lda $40000A,x
    xba
    sta $5C
    sec
    sbc #$00A0
    jsr h25_sge
    bcs h25_meta_second
    ldx $5A
    lda $40000E,x
    xba
    sec
    sbc #$00A0
    jsr h25_sge
    bcs h25_meta_second
    lda $5C
    xba
    sta $40000E,x          ; a1.e = a0.type

h25_meta_second:
    ldx $5A
    lda $40000A,x
    xba
    sta $5C
    sec
    sbc #$00A0
    jsr h25_sge
    bcs h25_pair_next
    ldx $58
    lda $40000E,x
    xba
    sec
    sbc #$00A0
    jsr h25_sge
    bcs h25_pair_next
    lda $5C
    xba
    sta $40000E,x          ; a0.e = a1.type

h25_pair_next:
    inc $56
    lda $56
    cmp $50
    bcs h25_outer_next
    jmp h25_inner
h25_outer_next:
    inc $52
    lda $52
    inc a
    cmp $50
    bcs h25_fast_done
    jmp h25_outer

h25_fast_done:
    ; Every qualifying physical record executes MOVE.W D7,D6 / SUBQ.W #1,D6
    ; before it considers any later record.  Consequently the last qualifying
    ; record always determines stage 1's final X: it is set only when that
    ; record is physical slot 30 ($F03C54), where D7 was zero.  Any collision
    ; arithmetic belongs to an earlier outer record and is overwritten by this
    ; final SUBQ.  The compact loop skips that no-inner final outer, so publish
    ; its X result explicitly before entering the byte-retained later stages.
    stz $A2
    lda $50
    dec a
    asl a
    tax
    lda $0080,x
    cmp #$3C54
    bne h25_fast_x_done
    inc $A2
h25_fast_x_done:
    ; State at the original DBRA-exhausted $2532C seam.  The final qualifying
    ; pair leaves D0/D1 exactly as above; trailing inactive records touch only
    ; these loop registers and pointers.
    lda #$FFFF
    sta $18                  ; D6.W
    sta $1C                  ; D7.W
    lda #$3C64
    sta $20                  ; A0 = $F03C64
    sta $24                  ; A1 = $F03C64
    lda #$00F0
    sta $22
    sta $26
    stz $14                  ; D5.W
h25_fast_done_jump:
    jml.l h25110_stage1_done ; original $02532C setup after compact stage 1

h25_fallback:
    ; Recreate the untouched generated stage-1 entry and delegate.  Only
    ; native scratch was changed while scanning; game RAM and D/A regs remain
    ; as they were at the retained $2511A seam.
    lda #$001E
    sta $1C
    lda $34
    clc
    adc #$3A74
    sta $20
    lda $36
    sta $22
    jml.l L25110_25122

; Incoming X=1 bypasses the compact stage, whose optimized collision responses
; predate --xflag.  Recreate the original $2511A setup and enter the regenerated
; X-aware body.  This fixed tail island keeps entry_25110's redirect size-neutral.
    .org $F3E0
h25110_xflag_stage1:
    rep #$30
    .a16
    .i16
    lda #$001E
    sta $1C
    lda $34
    clc
    adc #$3A74
    sta $20
    lda $36
    adc #$0000
    sta $22
    jml.l L25110_25122
h25110_xflag_stage1_end:

late_combat_bodies_end:

; ============================================================================
; Guarded fixed-shape renderer for bank-$94 hce4_entry.
;
; Entry occurs after CE4 has mapped/read the two-word header, materialized its
; LINK/MOVEM residue, and prepared $88/$8A/$90/$92/$94/$96/$98.  Carry clear
; returns a non-match with every scratch cell untouched.  Carry set means the
; three output planes, D7, CCR, and X are complete; bank $94 then enters its
; normal register/RTS epilogue.  This fixed island starts above the retained
; $25110 helpers ($F000-$F3FF).
; ============================================================================
.org $F400
.a16
.i16
hce4_shape_try:
    rep #$30
    lda $82                          ; mapped source bank after header reads
    cmp #$00C4
    beq hce4_shape_try_c4
    cmp #$00C5
    beq hce4_shape_try_c5
    jmp hce4_shape_miss
hce4_shape_try_c4:
    lda $80                          ; source low word has advanced by four
    cmp #$7632
    beq hce4_shape_guard_3762e
    cmp #$41C6
    beq hce4_shape_guard_341c2
    cmp #$37F4
    beq hce4_shape_guard_337f0
    cmp #$3C0E
    beq hce4_shape_guard_33c0a
    jmp hce4_shape_miss
hce4_shape_try_c5:
    lda $80
    cmp #$28DA
    bne hce4_shape_try_4288a
    jmp hce4_shape_guard_428d6
hce4_shape_try_4288a:
    cmp #$288E
    bne hce4_shape_miss
    jmp hce4_shape_guard_4288a

hce4_shape_miss:
    ; The post-ordering Right+B capture found four additional immutable ROM
    ; shapes plus a negative-Y clipping class for $03762E.  Continue the same
    ; original JSL frame into the guarded bank-$9D extension.  It returns
    ; carry clear without touching scratch on every unrecognized/unsafe case.
    jml.l $9DE400

; All retained classes have nonnegative on-screen Y for every nonzero column.
; Row-X minima differ only with the number of source rows.
hce4_shape_guard_3762e:
    lda $92
    cmp #$000F
    bne hce4_shape_miss
    lda $88
    cmp #$0030
    bcc hce4_shape_miss
    cmp #$00FA
    bcs hce4_shape_miss
    lda $8A
    cmp #$0140
    bcs hce4_shape_miss
    jmp hce4_shape_3762e
hce4_shape_guard_341c2:
    lda $92
    cmp #$000F
    bne hce4_shape_miss
    lda $88
    cmp #$0040
    bcc hce4_shape_miss
    cmp #$00FA
    bcs hce4_shape_miss
    lda $8A
    cmp #$0140
    bcs hce4_shape_miss
    jmp hce4_shape_341c2
hce4_shape_guard_337f0:
    lda $92
    cmp #$0011
    bne hce4_shape_miss
    lda $88
    cmp #$0040
    bcc hce4_shape_miss
    cmp #$00FA
    bcs hce4_shape_miss
    lda $8A
    cmp #$0140
    bcs hce4_shape_miss
    jmp hce4_shape_337f0
hce4_shape_guard_33c0a:
    lda $92
    cmp #$0011
    bne hce4_shape_miss
    lda $88
    cmp #$0040
    bcc hce4_shape_miss
    cmp #$00FA
    bcs hce4_shape_miss
    lda $8A
    cmp #$0140
    bcs hce4_shape_miss
    jmp hce4_shape_33c0a
hce4_shape_guard_428d6:
    lda $92
    cmp #$0012
    bne hce4_shape_guard_late_miss
    lda $88
    cmp #$0050
    bcc hce4_shape_guard_late_miss
    cmp #$00FA
    bcs hce4_shape_guard_late_miss
    lda $8A
    cmp #$0140
    bcs hce4_shape_guard_late_miss
    jmp hce4_shape_428d6
hce4_shape_guard_4288a:
    lda $92
    cmp #$0012
    bne hce4_shape_guard_late_miss
    lda $88
    cmp #$0050
    bcc hce4_shape_guard_late_miss
    cmp #$00FA
    bcs hce4_shape_guard_late_miss
    lda $8A
    cmp #$0140
    bcs hce4_shape_guard_late_miss
    jmp hce4_shape_4288a
hce4_shape_guard_late_miss:
    jmp hce4_shape_miss

; Copy the three plane pointers, precompute six row-X and five column-Y words,
; and start a shared byte offset at zero.  The caller selects the meaningful
; row count when it derives the final emulated X flag.
hce4_shape_prepare:
    lda $98                          ; tile plane
    sta $54
    lda #$0040
    sta $56
    lda $94                          ; X plane
    sta $58
    lda #$0040
    sta $5A
    lda $96                          ; Y/attribute plane
    sta $5C
    lda #$0040
    sta $5E

    lda $88
    sta $80                          ; row 0
    sec
    sbc #$0010
    sta $82                          ; row 1
    sec
    sbc #$0010
    sta $84                          ; row 2
    sec
    sbc #$0010
    sta $86                          ; row 3
    sec
    sbc #$0010
    sta $88                          ; row 4
    sec
    sbc #$0010
    sta $8C                          ; row 5

    lda $8A
    sta $9A                          ; column 0
    clc
    adc #$0010
    sta $9C                          ; column 1
    clc
    adc #$0010
    sta $9E                          ; column 2
    clc
    adc #$0010
    sta $50                          ; column 3
    clc
    adc #$0010
    sta $52                          ; column 4
    ldy #$0000
    rts

; A holds the last rendered row X.  The original subtracts one more row step
; before DBRA exhaustion; its borrow is the final X bit on the fill path.
hce4_shape_set_x:
    sec
    sbc #$0010
    bcs hce4_shape_x_clear
    lda #$0001
    sta $A2
    rts
hce4_shape_x_clear:
    stz $A2
    rts

; $03762E: 4x4, two nonzero cells in columns 1-2 of every row.
hce4_shape_3762e:
    jsr hce4_shape_prepare
    lda $86
    jsr hce4_shape_set_x
    lda #$2A76
    sta $66
    lda $80
    ldx $9C
    jsr hce4_shape_emit
    lda #$2A77
    sta $66
    lda $80
    ldx $9E
    jsr hce4_shape_emit
    lda #$2A78
    sta $66
    lda $82
    ldx $9C
    jsr hce4_shape_emit
    lda #$2A79
    sta $66
    lda $82
    ldx $9E
    jsr hce4_shape_emit
    lda #$2A7A
    sta $66
    lda $84
    ldx $9C
    jsr hce4_shape_emit
    lda #$2A7B
    sta $66
    lda $84
    ldx $9E
    jsr hce4_shape_emit
    lda #$2A7C
    sta $66
    lda $86
    ldx $9C
    jsr hce4_shape_emit
    lda #$2A7D
    sta $66
    lda $86
    ldx $9E
    jsr hce4_shape_emit
    ldx #$0007                       ; eight fill slots
    jmp hce4_shape_finish

