; $95:B000-$B5AF is filled by build_interp_rom.py with the two private-derived
; 13-row DMA payloads.  The assembler must leave that range zero.  $B5B0-$B5FF
; is an audited guard gap; code resumes at the fixed $B600 seam.

; ============================================================================
; Late-combat task root $02A190 and its state-zero object-update path.
;
; $02A1B2 dispatches on $16(A4).  State zero is the sustained gameplay path
; observed twice per tick in the production checkpoint.  The adapter below
; specializes only that table entry and exactly materializes the seven 68K
; dispatch-prologue instructions.  Other states enter the interpreter at the
; untouched function entry with the bank-$95 native return already pushed.
; ============================================================================
.org $B600
entry_2a1b2:
    rep #$30
.a16
.i16
    ; Standard-call convention: the caller skipped the 68K BSR push and put
    ; its bank-$95 continuation in $40:$42.  Push that sentinel before either
    ; the native table body or the interpreter fallback consumes the call.
    lda $40
    sta $54
    lda $42
    sta $56
    jsl.l push32_l

    ; Guard the only specialized dispatch state without changing emulated
    ; registers or CCR.  A4 is proven to point into big-endian $F0 work RAM.
    lda $30
    clc
    adc #$0016
    tax
    lda $400000,x
    and #$00FF
    beq h2a1b2_state0

h2a1b2_fallback:
    lda #$A1B2
    sta $40
    lda #$0002
    sta $42
    jml.l inext

h2a1b2_state0:
    ; clr.l d1; move.b $16(a4),d1; move.b $17(a4),d0
    ; lsl.w #1,d1; lea $2A1CA(pc),a0; move.w (a0,d1.l),d1
    ; jmp (a0,d1.l), specialized for table index zero ($000E -> $2A1D8).
    stz $04
    stz $06
    lda $30
    clc
    adc #$0017
    tax
    lda $400000,x
    and #$00FF
    sep #$20
    sta $00
    rep #$20
    lda #$000E
    sta $04
    lda #$A1CA
    sta $20
    lda #$0002
    sta $22

    ; MOVE.W of table value $000E leaves N=Z=V=C=0.  State-zero LSL
    ; supplied X=0 immediately beforehand.
    stz $60
    stz $70
    stz $72
    stz $6E
    stz $A2
    jmp entry_2a1d8t

