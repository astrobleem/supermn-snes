    jsr hce4_shape_emit
    lda #$219B
    sta $66
    lda $88
    ldx $9C
    jsr hce4_shape_emit
    lda #$219C
    sta $66
    lda $88
    ldx $9E
    jsr hce4_shape_emit
    lda #$219D
    sta $66
    lda $8C
    ldx $9C
    jsr hce4_shape_emit
    ldx #$0001                       ; two fill slots
    jmp hce4_shape_finish

; $04288A shares the outer rows but has the alternate middle animation tiles.
hce4_shape_4288a:
    jsr hce4_shape_prepare
    lda $8C
    jsr hce4_shape_set_x
    lda #$2181
    sta $66
    lda $80
    ldx $9C
    jsr hce4_shape_emit
    lda #$2182
    sta $66
    lda $80
    ldx $9E
    jsr hce4_shape_emit
    lda #$2183
    sta $66
    lda $82
    ldx $9A
    jsr hce4_shape_emit
    lda #$2184
    sta $66
    lda $82
    ldx $9C
    jsr hce4_shape_emit
    lda #$2185
    sta $66
    lda $82
    ldx $9E
    jsr hce4_shape_emit
    lda #$2186
    sta $66
    lda $82
    ldx $50
    jsr hce4_shape_emit
    lda #$2193
    sta $66
    lda $84
    ldx $9A
    jsr hce4_shape_emit
    lda #$2194
    sta $66
    lda $84
    ldx $9C
    jsr hce4_shape_emit
    lda #$2195
    sta $66
    lda $84
    ldx $9E
    jsr hce4_shape_emit
    lda #$2196
    sta $66
    lda $84
    ldx $50
    jsr hce4_shape_emit
    lda #$2197
    sta $66
    lda $86
    ldx $9A
    jsr hce4_shape_emit
    lda #$2198
    sta $66
    lda $86
    ldx $9C
    jsr hce4_shape_emit
    lda #$2199
    sta $66
    lda $86
    ldx $9E
    jsr hce4_shape_emit
    lda #$219A
    sta $66
    lda $86
    ldx $50
    jsr hce4_shape_emit
    lda #$219B
    sta $66
    lda $88
    ldx $9C
    jsr hce4_shape_emit
    lda #$219C
    sta $66
    lda $88
    ldx $9E
    jsr hce4_shape_emit
    lda #$219D
    sta $66
    lda $8C
    ldx $9C
    jsr hce4_shape_emit
    ldx #$0001

hce4_shape_finish:
    lda #$00FA
    xba
hce4_shape_fill:
    sta [$58],y
    iny
    iny
    dex
    bpl hce4_shape_fill
    lda #$FFFF
    sta $92
    stz $70
    stz $60
    stz $72
    stz $6E
    sec
    rtl

; A=row X, native X=column Y, $66=tile+$2000, native Y=plane offset.
hce4_shape_emit:
    sta $68
    lda $66
    xba
    sta [$54],y
    lda $68
    xba
    sta [$58],y
    txa
    and #$01FF
    ora $90
    xba
    sta [$5C],y
    iny
    iny
    rts
hce4_shape_end:

; ============================================================================
; Guarded constant-list body for $00CAF6.
;
; Bank $97's hcaf6_fast has already proved the exact immutable five-record
; arcade-ROM list at $032F7A, the bounded A6 frame, all five A1 pointers, and
; the A2 output pointer before entering here.  The retained generic loop still
; owns every guard miss.  Four records always take CB9E's positive path; the
; first writes a negative sentinel and takes CB9E's TST-only return.  Folding
; those immutable record fields removes repeated ROM addressing and helper
; calls while preserving record order, aliases, D/A residues, CCR, and X.
; ============================================================================
    .org $FA00
hcaf6_const_list:
    rep #$30
    .a16
    .i16

    ; Frame invariants used by all five records.
    lda $38
    clc
    adc #$FFDE                    ; [A6-$22]
    tax
    lda $400000,x
    xba
    sta $80
    lda $38
    clc
    adc #$FFE2                    ; [A6-$1E]
    tax
    lda $400000,x
    xba
    sta $82
    lda $38
    sec
    sbc #$0024                    ; BTST #7,[A6-$24]
    tax
    lda $400000,x
    and #$0080
    sta $84
    lda $38
    clc
    adc #$FFAE                    ; low word of [A6-$54]
    tax
    lda $400000,x
    xba
    sta $28                       ; final/working A2 low
    lda #$00F0
    sta $2A
    lda $38
    clc
    adc #$FFCA                    ; low word of first [A6-$38+offset] pointer
    sta $86

    ; Record 0: offset 0, tuple (-64,-64,-32,-32,$80000000,$FFFF).
    ; Its freshly written $FFFF word makes CB9E return at the initial TST.
    jsr hcaf6_const_next_a1
    ldx $24
    lda #$FFFF
    sta $400000,x
    lda #$0000
    sta $40000E,x
    lda #$8000
    clc
    adc $18
    xba
    sta $40000A,x
    lda #$0000
    sta $40000C,x

    ; Records 1-4.  Parameters are x, y, local-x, local-y, and type.
    lda #$0004
    sta $88
    lda #$000D
    sta $8A
    lda #$FFE3
    sta $8C
    lda #$FFEA
    sta $8E
    stz $90
    jsr hcaf6_const_record

    lda #$FFFA
    sta $88
    lda #$000B
    sta $8A
    lda #$FFEB
    sta $8C
    lda #$0007
    sta $8E
    lda #$0001
    sta $90
    jsr hcaf6_const_record

    lda #$FFF8
    sta $88
    lda #$000B
    sta $8A
    lda #$0008
    sta $8C
    lda #$001F
    sta $8E
    lda #$0002
    sta $90
    jsr hcaf6_const_record

    lda #$FFF8
    sta $88
    lda #$000D
    sta $8A
    lda #$FFE3
    sta $8C
    lda #$001F
    sta $8E
    lda #$0003
    sta $90
    jsr hcaf6_const_record

hcaf6_const_done:
    ; Five ADDA.L #$10,A0 operations and the exhausted DBRA residue.
    lda #$2FCA
    sta $20
    lda #$0003
    sta $22
    lda #$FFFF
    sta $1C
    jml.l Lcaf6_cb9c

hcaf6_const_next_a1:
    ldx $86
    lda $400000,x
    xba
    sta $24
    lda #$00F0
    sta $26
    lda $86
    clc
    adc #$0004
    sta $86
    rts

hcaf6_const_record:
    jsr hcaf6_const_next_a1
    ldx $24

    ; Outer CAF6 record copy: positive active word, cleared link, type+D6.
    lda #$0001
    xba
    sta $400000,x
    lda #$0000
    sta $40000E,x
    lda $90
    clc
    adc $18
    xba
    sta $40000A,x
    lda #$0000
    sta $40000C,x

    ; CB9E local bounds derived from [A6-$22].
    lda $80
    clc
    adc $8C
    xba
    sta $400006,x
    lda $80
    clc
    adc $8E
    xba
    sta $400008,x

    ; MOVE.B #0,D2 preserves D2's high byte from the preceding record.
    sep #$20
    stz $08
    rep #$20
    .a16
    lda $84
    bne hcaf6_const_mirrored
    lda $88
    sta $00
    lda $8A
    sta $04
    bra hcaf6_const_position_ready
hcaf6_const_mirrored:
    lda $8A
    eor #$FFFF
    inc a
    sta $00
    lda $88
    eor #$FFFF
    inc a
    sta $04
    lda $08
    eor #$FFFF
    inc a
    sta $08
    sep #$20
    .a8
    lda $08
    clc
    adc #$80
    sta $08
    rep #$20
    .a16

hcaf6_const_position_ready:
    ; D3 first holds X, then Y.  The second ADD.W supplies final X.
    lda $82
    clc
    adc $00
    sta $92
    ldx $24
    xba
    sta $400002,x
    lda $82
    clc
    adc $04
    sta $0C
    bcc hcaf6_const_x_clear
    lda #$0001
    sta $A2
    bra hcaf6_const_x_done
hcaf6_const_x_clear:
    stz $A2
hcaf6_const_x_done:
    lda $0C
    xba
    sta $400004,x
    sep #$20
    .a8
    lda $08
    sta $40000C,x
    rep #$20
    .a16

    ; A2 publication order is observable when output records alias.
    ldx $28
    lda #$0001
    xba
    sta $400000,x
    lda $0C
    xba
    sta $400004,x
    lda $92
    xba
    sta $400002,x

    ; Final MOVE.W flags come from [A1+2]; V/C clear and X is preserved.
    lda $92
    beq hcaf6_const_z_set
    stz $60
    bra hcaf6_const_z_done
hcaf6_const_z_set:
    lda #$0001
    sta $60
hcaf6_const_z_done:
    lda $92
    and #$8000
    sta $70
    stz $72
    stz $6E
    rts

hcaf6_const_list_end:

; Signed predicates for a preceding 16-bit subtraction.  Carry on return is
; the boolean result; A is left unchanged.  Keep these in the free bank tail:
; growing the compact $25110 body across the fixed $F3E0 X-flag island silently
; overwrites bytes because Poppy permits backward .org overlap.
    .org $FBE0
h25_sgt:
    beq h25_pred_false
    bvs h25_sgt_overflow
    bmi h25_pred_false
    sec
    rts
h25_sgt_overflow:
    bpl h25_pred_false
    sec
    rts

h25_slt:
    bvs h25_slt_overflow
    bmi h25_pred_true
    clc
    rts
h25_slt_overflow:
    bmi h25_pred_false
    sec
    rts

h25_sge:
    bvs h25_sge_overflow
    bmi h25_pred_false
    sec
    rts
h25_sge_overflow:
    bmi h25_pred_true
h25_pred_false:
    clc
    rts
h25_pred_true:
    sec
    rts
h25_predicates_end:
