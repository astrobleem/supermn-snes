; <<< ESCBANK6_BODIES <<<

; Dynamic-RAM tail-call gateway.  $002D8A is `jmp $1B20(a5)`, and production
; copies the first $5C bytes of the C-Chip response to that exact RAM address.
; Compare the complete live routine against the preserved response at $00:F700
; before changing any emulated state.  A mismatch re-executes $002D8A through
; the interpreter with the real caller return still untouched on the stack.
; --- transpiled from $002D8A (gateway; guarded RAM body follows) ---
entry_2d8at:
    rep #$30
    lda $34
    bne e2d8a_fallback
    lda $36
    cmp #$00F0
    bne e2d8a_fallback
    ldx #$0000
e2d8a_guard_loop:
    lda $401B20,x
    cmp $00F700,x
    bne e2d8a_fallback
    inx
    inx
    cpx #$005C
    bne e2d8a_guard_loop
    jmp entry_f01b20t
e2d8a_fallback:
    lda #$2D8A
    sta $40
    stz $42
    jml.l inext

; Bank-local unsigned 32/16 divider used by transpiled DIVU.W.  `jsr` cannot
; cross program banks, so this mirrors the proven escbank2/escbank4 helper.
; in: $50/$52 dividend, $54 divisor; out: $50 quotient, $94 remainder.
esc_udiv:
    rep #$30
    stz $94
    ldy #$0020
es6ud_l:
    asl $50
    rol $52
    rol $94
    bcs es6ud_sub
    lda $94
    cmp $54
    bcc es6ud_no
es6ud_sub:
    lda $94
    sec
    sbc $54
    sta $94
    inc $50
es6ud_no:
    dey
    bne es6ud_l
    rts
escbank6_end:

; ============================================================================
; hle_17b4 — guarded semantic implementation of the short sprite-shadow copy.
;
; The original $0017B4 calls its 34-MOVE.L helper three times, copying exactly
; 136 bytes per plane:
;   $F0:1CF6 -> $D0:0002 -> shadow $41:3002
;   $F0:20F2 -> $E0:0402 -> shadow $41:4402
;   $F0:24EE -> $E0:0002 -> shadow $41:4002
; The old native wrapper interpreted the first two calls and expanded the third
; into thousands of generic read/write-helper instructions (~62K cycles/tick).
;
; This path is deliberately narrow: A5 must be the canonical $F0:0000 base and
; the work-RAM stack slots must not alias a source. Each plane passes through
; safe IRAM $0100-$018B using synchronous SA-1 DMA. Production pacing snapshots
; the architected live shadow while the SA-1 sleeps; the legacy unpaced path
; also receives both immutable OBJ-buffer copies so its selector cannot go
; stale. The final inner-BSR residue, A0/A1, MOVE.L N/Z/V/C, and outer RTS are
; reproduced exactly. X is untouched. A legal but noncanonical source/aliasing
; case resumes the interpreter at $0017B8 after the skipped JSR push and first
; LEA, preserving instruction order instead of approximating it.
;
; Fixed at $95:9B00. build_interp_rom.py guards the generated-body seam, the
; bank-$92 four-byte redirect, and this body's bounds/entry bytes.
; ============================================================================
.org $9B00
hle_17b4:
    rep #$30
.a16
.i16
    jsl.l hobj_capture_reset
    ; push32 assumes a nonwrapping bank-$F0 emulated stack. If that invariant
    ; is absent, recreate the overwritten LDA and retain the generated wrapper.
    lda $3E
    cmp #$00F0
    beq h17_stack_bank_ok
    jmp h17_generated_fallback
h17_stack_bank_ok:
    lda $3C
    cmp #$0008
    bcs h17_stack_range_ok
    jmp h17_generated_fallback
h17_stack_range_ok:

    ; Re-simulate the outer JSR return push skipped by the native dispatch.
    lda $40
    sta $54
    lda $42
    sta $56
    jsl.l push32_l

    ; The DMA path is valid only for the canonical work-RAM sources. The outer
    ; return occupies [A7,A7+4), and the inner-BSR residue occupies [A7-4,A7).
    ; Admit a stack wholly below the first source ($1CF6) or wholly above the
    ; last source byte ($2575); all aliasing/interior cases stay interpreted.
    lda $36
    cmp #$00F0
    beq h17_a5_bank_ok
    jmp h17_interp_fallback
h17_a5_bank_ok:
    lda $34
    beq h17_a5_base_ok
    jmp h17_interp_fallback
h17_a5_base_ok:
    lda $3C
    cmp #$1CF3
    bcc h17_fast
    cmp #$257A
    bcs h17_fast
    jmp h17_interp_fallback

h17_fast:
hle_17b4_fast_hook:
    ; The second BSR overwrites the first helper return at [A7-4] with $17D0.
    ; Use DMA so the residue remains exact even in a protected synthetic state.
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$17D0
    jsl.l h158_dma_residue

    lda #$1CF6
    ldx #$3002
    ldy #$5002
    jsr h17_dma_136

    lda #$20F2
    ldx #$4402
    ldy #$5802
    jsr h17_dma_136

    lda #$24EE
    ldx #$4002
    ldy #$5402
    jsr h17_dma_136

    ; Final MOVE.L begins at $2572. Native 16-bit loads see each byte pair in
    ; little-endian order, so bit 7 of the first raw word is logical bit 31.
    ldx #$2572
    lda $400000,x
    sta $80
    and #$0080
    beq h17_n_clear
    lda #$0001
    sta $70
    bra h17_n_done
h17_n_clear:
    stz $70
h17_n_done:
    lda $400002,x
    ora $80
    beq h17_z_set
    stz $60
    bra h17_z_done
h17_z_set:
    lda #$0001
    sta $60
h17_z_done:
    stz $72                    ; V=0
    stz $6E                    ; C=0; X at $A2 is unchanged

    lda #$2576
    sta $20                    ; A0=$F02576
    lda #$00F0
    sta $22
    lda #$008A
    sta $24                    ; A1=$E0008A
    lda #$00E0
    sta $26

    ; Faithful outer RTS: pop the big-endian return and advance emulated A7.
    ldx $3C
    sep #$20
.a8
    lda $400000,x
    xba
    lda $400001,x
    rep #$20
.a16
    sta $42
    inx
    inx
    sep #$20
.a8
    lda $400000,x
    xba
    lda $400001,x
    rep #$20
.a16
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

h17_interp_fallback:
    ; Outer return is already pushed. LEA $1CF6(A5),A0 changes no flags; resume
    ; at the following LEA so the real BSRs/copies/RTS preserve all cold cases.
    lda $34
    clc
    adc #$1CF6
    sta $20
    lda $36
    adc #$0000
    sta $22
    lda #$17B8
    sta $40
    stz $42
    jml.l inext

h17_generated_fallback:
    ; No emulated state changed. Recreate entry_17b4's overwritten `lda $40`
    ; and continue at the byte-pinned generated `sta $54` instruction.
    lda $40
    jml.l $92BA89

; Copy one 136-byte source to its architected live shadow. With legacy pacing
; disabled, replay the same staged bytes into both immutable OBJ buffers too.
; Entry: A=bank-$40 source low, X=bank-$41 live dest, Y=buffer-A dest; M/X=16.
h17_dma_136:
    rep #$30
.a16
.i16
    sta $90
    stx $92
    sty $96
    ; Production pacing consumes only the architected live shadow.  For this
    ; 136-byte span, one synchronous SA-1 block move is substantially cheaper
    ; than programming BW-RAM -> IRAM -> BW-RAM DMA twice.  Preserve DBR
    ; because MVN leaves it equal to the destination bank; the native runtime
    ; expects bank $00 after this helper.  The unpaced path still publishes
    ; both immutable snapshot buffers and therefore retains the proven DMA
    ; implementation below.
    lda $0734
    beq h17_dma_136_unpaced
    lda #$0087              ; 136 bytes - 1
    ldx $90
    ldy $92
    phb
    mvn $41,$40             ; bank-$40 work RAM -> bank-$41 live OBJ shadow
    plb
    rts
h17_dma_136_unpaced:
    sep #$20
.a8
    lda #$20
    sta $220B

    lda #$81                   ; physical BW-RAM bank 0 -> IRAM $0100
    sta $2230
    lda $90
    sta $2232
    lda $91
    sta $2233
    stz $2234
    lda #$88
    sta $2238
    stz $2239
    stz $2235
    lda #$01
    sta $2236                  ; trigger; SA-1 stalls until the stage is complete

    jsr h17_dma_to_dest
    lda $0734
    bne h17_dma_done
    lda $96
    sta $92
    lda $97
    sta $93
    jsr h17_dma_to_dest
    clc
    lda $93
    adc #$0C                   ; buffer B is exactly $0C00 after buffer A
    sta $93
    jsr h17_dma_to_dest
h17_dma_done:
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

.a8
.i16
h17_dma_to_dest:
    lda #$86                   ; IRAM $0100 -> physical BW-RAM bank 1
    sta $2230
    stz $2232
    lda #$01
    sta $2233
    stz $2234
    lda #$88
    sta $2238
    stz $2239
    lda $92
    sta $2235
    lda $93
    sta $2236
    lda #$01
    sta $2237                  ; trigger; SA-1 stalls until destination is complete
    rts

hle_17b4_end:

; ============================================================================
; hle_8fa — guarded semantic implementation of the descriptor block copier.
;
; The original $0008FA table-call routine reads a packed-ROM descriptor:
;   dc.w long_count-1
;   dc.l work_destination
;   dc.l mask_or_for_(a5+$1B12)
;   dc.l payload[long_count]
; It LINK/MOVEM-saves D0-D1/A0-A1/A6, ORs the mask, copies the payload, restores
; every register, and returns with N/Z/V/C from the final MOVE.L (X preserved).
;
; This fast path accepts any non-bank-crossing descriptor of up to 256 longs in
; the packed 512 KiB arcade ROM, with canonical A5/stack and a nonwrapping bank-
; $F0 destination.  It rejects stack/destination/OR aliases whose overwrite-
; before-restore behavior would require full instruction ordering.  The exact
; 20-byte LINK/MOVEM residue is staged through IRAM, the OR is written by a
; four-byte IRAM->BW-RAM DMA, and the payload uses supported PRG-ROM->BW-RAM
; DMA.  These transfers retain byte order and work even when a function-local
; validator protects CPU-side BW-RAM writes.  Every rejected case resumes the
; byte-pinned generated bank-$94 implementation at the appropriate fire-counter
; seam, exactly preserving the behavior that preceded this guarded fast path.
;
; Fixed at $95:9D00. build_interp_rom.py guards the bank-$94 redirect, the
; preceding $17B4 seam, this prologue, and the body's upper bound.
; ============================================================================
.org $9D00
hle_8fa:
    rep #$30
.a16
.i16
    ; The old generated body only supports a nonwrapping work-RAM stack.  Test
    ; that invariant before touching its fire counter so a generated fallback
    ; still executes the original INC/STA exactly once.
    lda $3E
    cmp #$00F0
    beq h8fa_stack_bank_ok
    jmp h8fa_generated_fallback
h8fa_stack_bank_ok:
    lda $3C
    cmp #$0014                 ; LINK/MOVEM writes 20 bytes below entry A7
    bcs h8fa_stack_low_ok
    jmp h8fa_generated_fallback
h8fa_stack_low_ok:
    cmp #$FFF8                 ; return + descriptor argument must not wrap
    bcc h8fa_stack_valid
    jmp h8fa_generated_fallback
h8fa_stack_valid:
    lda $407FE4
    inc a
    sta $407FE4

    ; The fast memory map specializes the invariant game work base only.
    lda $36
    cmp #$00F0
    beq h8fa_a5_bank_ok
    jmp h8fa_cold_fallback
h8fa_a5_bank_ok:
    lda $34
    beq h8fa_a5_ok
    jmp h8fa_cold_fallback
h8fa_a5_ok:

    ; Caller return is already at (A7); the table argument is the next long.
    ldx $3C
    lda $400004,x
    xba
    sta $82                    ; descriptor high word
    lda $400006,x
    xba
    sta $80                    ; descriptor low word

    ; Packed arcade ROM is exactly $000000-$07FFFF.  Keep the descriptor and
    ; payload in one 64 KiB mapped bank so a single $C1+hi long pointer and DMA
    ; source describe every byte.
    lda $82
    cmp #$0008
    bcc h8fa_descriptor_bank_ok
    jmp h8fa_cold_fallback
h8fa_descriptor_bank_ok:
    lda $80
    cmp #$FFF7                 ; ten-byte descriptor header must fit
    bcc h8fa_descriptor_header_ok
    jmp h8fa_cold_fallback
h8fa_descriptor_header_ok:
    sta $5A
    lda $82
    clc
    adc #$00C1                 ; SNES packed-ROM bank
    sep #$20
.a8
    sta $5C
    rep #$20
.a16

    ldy #$0000
    lda [$5A],y
    xba                        ; descriptor count is big-endian
    cmp #$0100                 ; bounded general path: 1..256 longs
    bcc h8fa_count_ok
    jmp h8fa_cold_fallback
h8fa_count_ok:
    inc a
    sta $90                    ; long count
    asl a
    asl a
    sta $98                    ; byte count

    lda $80
    clc
    adc #$000A
    bcs h8fa_descriptor_crosses
    adc $98
    bcc h8fa_descriptor_end_ok
h8fa_descriptor_crosses:
    jmp h8fa_cold_fallback
h8fa_descriptor_end_ok:

    ; Destination must be a nonwrapping region in canonical work RAM.
    ldy #$0002
    lda [$5A],y
    xba
    cmp #$00F0
    beq h8fa_destination_bank_ok
    jmp h8fa_cold_fallback
h8fa_destination_bank_ok:
    ldy #$0004
    lda [$5A],y
    xba
    sta $92                    ; destination low word
    clc
    adc $98
    bcc h8fa_destination_end_ok
    jmp h8fa_cold_fallback
h8fa_destination_end_ok:
    sta $96                    ; exclusive destination end

    ; Preserve raw byte-pair order for the long OR and final MOVE.L flags.
    ldy #$0006
    lda [$5A],y
    sta $9A                    ; mask bytes 0..1, raw little-endian word
    iny
    iny
    lda [$5A],y
    sta $9C                    ; mask bytes 2..3
    lda $98
    clc
    adc #$0006                 ; header 10 - final-long size 4
    tay
    lda [$5A],y
    sta $84                    ; final payload bytes 0..1
    iny
    iny
    lda [$5A],y
    sta $86                    ; final payload bytes 2..3

    ; A shortcut that preserves registers cannot accept a destination or OR
    ; target that overwrites the saved frame, caller return, or argument.  The
    ; original would consume those overwritten values during MOVEM/RTS.
    lda $3C
    sec
    sbc #$0014
    sta $88                    ; protected stack start
    lda $3C
    clc
    adc #$0008
    sta $8A                    ; protected stack end (exclusive)

    lda $8A
    cmp #$1B13                 ; <= $1B12 is wholly before the OR long
    bcc h8fa_or_stack_disjoint
    lda $88
    cmp #$1B16                 ; >= $1B16 is wholly after it
    bcs h8fa_or_stack_disjoint
    jmp h8fa_cold_fallback
h8fa_or_stack_disjoint:
    lda $8A
    cmp $92
    bcc h8fa_destination_stack_disjoint
    beq h8fa_destination_stack_disjoint
    lda $88
    cmp $96
    bcs h8fa_destination_stack_disjoint
    jmp h8fa_cold_fallback
h8fa_destination_stack_disjoint:

h8fa_fast:
hle_8fa_fast_hook:
    ; Reproduce the exact low-to-high residue left by
    ; LINK A6,#0 / MOVEM.L D0-D1/A0-A1,-(A7): D0,D1,A0,A1,A6.
    jsr h8fa_stack_residue

    ; OR.L mask,$1B12(A5), retaining the original before-copy order.  Native
    ; loads/stores use raw byte-pair words, for which bitwise OR is identical.
    lda $401B12
    ora $9A
    sta $0120
    lda $401B14
    ora $9C
    sta $0122
    jsr h8fa_or_dma

    ; Copy descriptor payload directly from mapped PRG ROM to physical BW-RAM
    ; bank 0, the backing of the emulated $F0 work bank.
    jsr h8fa_payload_dma

    ; Final MOVE.L N/Z/V/C, with X deliberately untouched.
    lda $84
    and #$0080                 ; first BE byte bit 7 = logical bit 31
    beq h8fa_n_clear
    lda #$0001
    sta $70
    bra h8fa_n_done
h8fa_n_clear:
    stz $70
h8fa_n_done:
    lda $84
    ora $86
    beq h8fa_z_set
    stz $60
    bra h8fa_z_done
h8fa_z_set:
    lda #$0001
    sta $60
h8fa_z_done:
    stz $72                    ; V=0
    stz $6E                    ; C=0; X at $A2 is unchanged

    ; Faithful RTS from the unchanged entry stack pointer.
    ldx $3C
    sep #$20
.a8
    lda $400000,x
    xba
    lda $400001,x
    rep #$20
.a16
    sta $42
    inx
    inx
    sep #$20
.a8
    lda $400000,x
    xba
    lda $400001,x
    rep #$20
.a16
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

h8fa_cold_fallback:
    ; The fire counter has already been incremented.  Resume immediately after
    ; the original generated counter store, before LINK/MOVEM has changed any
    ; architectural state.  This is the exact pre-HLE implementation.
    jml.l $94ADA3

h8fa_generated_fallback:
    ; No emulated state or fire counter changed. Recreate the overwritten
    ; absolute-long load and continue at bank-$94's pinned INC instruction.
    rep #$30
.a16
.i16
    lda $407FE4
    jml.l $94AD9E

; Stage and DMA the exact 20 bytes left below entry A7 by LINK/MOVEM.
h8fa_stack_residue:
    rep #$30
.a16
.i16
    lda $02                    ; D0 high, then low
    xba
    sta $0100
    lda $00
    xba
    sta $0102
    lda $06                    ; D1
    xba
    sta $0104
    lda $04
    xba
    sta $0106
    lda $22                    ; A0
    xba
    sta $0108
    lda $20
    xba
    sta $010A
    lda $26                    ; A1
    xba
    sta $010C
    lda $24
    xba
    sta $010E
    lda $3A                    ; A6
    xba
    sta $0110
    lda $38
    xba
    sta $0112

    sep #$20
.a8
    lda #$20
    sta $220B
    lda #$86                   ; IRAM -> physical BW-RAM bank 0
    sta $2230
    stz $2232
    lda #$01
    sta $2233
    stz $2234
    lda #$14
    sta $2238
    stz $2239
    lda $88
    sta $2235
    lda $89
    sta $2236
    stz $2237                  ; destination bank 0; trigger
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

; Write the staged four-byte OR result to work $1B12.
h8fa_or_dma:
    sep #$20
.a8
.i16
    lda #$20
    sta $220B
    lda #$86                   ; IRAM $0120 -> physical BW-RAM bank 0
    sta $2230
    lda #$20
    sta $2232
    lda #$01
    sta $2233
    stz $2234
    lda #$04
    sta $2238
    stz $2239
    lda #$12
    sta $2235
    lda #$1B
    sta $2236
    stz $2237
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

; PRG-ROM payload -> physical BW-RAM bank 0.  $5A:$5C is the descriptor's
; mapped SNES address, $92 is destination low, and $98 is byte count.
h8fa_payload_dma:
    sep #$20
.a8
.i16
    lda #$20
    sta $220B
    lda #$84                   ; PRG ROM -> BW-RAM
    sta $2230
    clc
    lda $5A
    adc #$0A
    sta $2232
    lda $5B
    adc #$00
    sta $2233
    lda $5C
    sta $2234
    lda $98
    sta $2238
    lda $99
    sta $2239
    lda $92
    sta $2235
    lda $93
    sta $2236
    stz $2237                  ; destination bank 0; trigger
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

hle_8fa_end:

; Dedicated function-differential return seam.  A synthetic $00F9 sentinel
; routes ors_pre here without crossing the interpreter's inext body.
.org $9FA0
h8fa_validation_spin:
    bra h8fa_validation_spin
h8fa_validation_spin_end:

; ============================================================================
; $00096A guarded exact palette-step HLE.
;
; The production caller at $008B6C selects one of three palettes per row, then
; advances each of 64 arcade color words by one channel step toward that ROM
; palette.  The old generated native body is semantically sound but spends most
; of its time in generic EA helpers.  This path specializes only the proven
; production map: A5=$F00000, a low-work-RAM caller stack, row < 256, column
; 0..2, and a target wholly inside the packed 512 KiB program image.  Any other
; state resumes the byte-pinned bank-$99 generated body before it has changed
; emulated state.
;
; Besides the 128 palette bytes, the routine exposes every D/A register, the
; skipped-JSR return residue, and ORI.L's X/N/Z/V/C result.  The bounded index
; guard proves the initial ADD.W cannot carry; the three possible channel adds
; also cannot carry, so X is exactly zero on every accepted path.
; ============================================================================
.org $A000
hle_96a:
    rep #$30
.a16
.i16
    ; Canonical work base used by every direct BW-RAM access below.
    lda $36
    cmp #$00F0
    beq h96a_a5_bank_ok
    jmp h96a_generated_fallback
h96a_a5_bank_ok:
    lda $34
    beq h96a_a5_ok
    jmp h96a_generated_fallback
h96a_a5_ok:

    ; Keep the synthetic skipped-JSR return nonwrapping and disjoint from
    ; selections, palette data, and the dirty long.  The live caller's task
    ; stack is below $3000, so use exact interval tests rather than a guessed
    ; stack band.
    lda $3E
    cmp #$00F0
    beq h96a_stack_bank_ok
    jmp h96a_generated_fallback
h96a_stack_bank_ok:
    lda $3C
    cmp #$0004
    bcs h96a_stack_nonwrap
    jmp h96a_generated_fallback
h96a_stack_nonwrap:
    sta $96                    ; protected end (exclusive)
    sec
    sbc #$0004
    sta $94                    ; protected start

    lda $96
    cmp #$1952
    bcc h96a_stack_palette_ok
    beq h96a_stack_palette_ok
    lda $94
    cmp #$19D2
    bcs h96a_stack_palette_ok
    jmp h96a_generated_fallback
h96a_stack_palette_ok:
    lda $96
    cmp #$1B12
    bcc h96a_stack_dirty_ok
    beq h96a_stack_dirty_ok
    lda $94
    cmp #$1B16
    bcs h96a_stack_dirty_ok
    jmp h96a_generated_fallback
h96a_stack_dirty_ok:
    lda $96
    cmp #$2930
    bcc h96a_stack_ok
    beq h96a_stack_ok
    lda $94
    cmp #$2934
    bcs h96a_stack_ok
    jmp h96a_generated_fallback
h96a_stack_ok:

    ; Read the two big-endian selectors before committing any architectural
    ; state.  Three columns make each pointer-table row exactly 12 bytes.
    lda $402930
    xba
    cmp #$0100
    bcc h96a_row_ok
    jmp h96a_generated_fallback
h96a_row_ok:
    sta $80                    ; row
    lda $402932
    xba
    cmp #$0003
    bcc h96a_column_ok
    jmp h96a_generated_fallback
h96a_column_ok:
    sta $82                    ; column

    ; Reproduce MULU.W #12,D0 / LSL.W #2,D1 / ADD.W D1,D0 /
    ; EXT.L D0.  The guards above bound the sum to $0BFC, so D0's sign
    ; extension is zero and ADD.W leaves X clear.
    lda $80
    asl a
    asl a
    sta $84                    ; row * 4
    asl a                      ; row * 8
    clc
    adc $84                    ; row * 12
    sta $00
    stz $02
    lda $82
    asl a
    asl a
    sta $04                    ; D1 low; D1 high is untouched
    clc
    adc $00
    sta $00                    ; signed table displacement (known positive)

    ; Map $0003065C + D0 to packed PRG ROM at $C1:0000 + address.
    ; The bounded displacement cannot carry out of bank $C4 here.
    lda $00
    clc
    adc #$065C
    sta $84
    lda #$00C4
    sta $86                    ; long pointer bytes $84/$85/$86
    ldy #$0000
    lda [$84],y
    xba
    sta $8A                    ; selected emulated pointer high word
    ldy #$0002
    lda [$84],y
    xba
    sta $88                    ; selected emulated pointer low word

    ; The 64-word source begins at pointer+10.  Its one-past A1 value is
    ; pointer+$8A and may equal $080000, but no byte read may exceed $07FFFF.
    lda $8A
    cmp #$0008
    bcc h96a_target_start_ok
    jmp h96a_generated_fallback
h96a_target_start_ok:
    lda $88
    clc
    adc #$008A
    sta $90                    ; final A1 low
    lda $8A
    adc #$0000
    sta $92                    ; final A1 high
    cmp #$0008
    bcc h96a_target_end_ok
    beq h96a_target_bank_edge
    jmp h96a_generated_fallback
h96a_target_bank_edge:
    lda $90
    beq h96a_target_end_ok
    jmp h96a_generated_fallback
h96a_target_end_ok:

    ; Native long pointer for the first target word (emulated A1+10).
    lda $88
    clc
    adc #$000A
    sta $8C
    lda $8A
    adc #$0000
    clc
    adc #$00C1
    sta $8E                    ; long pointer bytes $8C/$8D/$8E

h96a_fast:
hle_96a_fast_hook:
    ; Materialize the skipped JSR's exact big-endian return residue at A7-4.
    lda $3C
    sec
    sbc #$0004
    tax
    lda $42                    ; return high word
    xba
    sta $400000,x
    lda $40                    ; return low word
    xba
    sta $400002,x

    ; Stage the 128-byte current palette at IRAM $0100 and the immutable ROM
    ; target at $0180.  The full $0100-$01FF window is proven scratch between
    ; native escapes; the virtual controller begins at $0200.
    jsr h96a_stage_dma

    lda #$003F
    sta $1C                    ; MOVE.W preserves D7 high
    ldx #$0100
    ldy #$0180
h96a_loop:
    lda $0000,x
    xba
    sta $00                    ; MOVE.W (A0)+,D0; D0 high remains zero
    lda $0000,y
    xba
    sta $0C                    ; MOVE.W (A1)+,D3; D3 high untouched
    cmp $00
    beq h96a_next

    lda $00
    and #$001E
    sta $04                    ; D1 = current blue field
    lda $0C
    and #$001E
    sta $10                    ; D4 = target blue field
    cmp $04
    beq h96a_blue_done
    lda $04
    clc
    adc #$0002
    sta $04
h96a_blue_done:

    lda $00
    and #$03C0
    sta $08                    ; D2 = current green field
    lda $0C
    and #$03C0
    sta $14                    ; D5 = target green field
    cmp $08
    beq h96a_green_done
    lda $08
    clc
    adc #$0040
    sta $08
h96a_green_done:

    lda $00
    and #$7800
    sta $00                    ; D0 = current red field
    lda $0C
    and #$7800
    sta $0C                    ; D3 = target red field
    cmp $00
    beq h96a_red_done
    lda $00
    clc
    adc #$0800
    sta $00
h96a_red_done:
    lda $04
    ora $08
    sta $04                    ; OR.W D2,D1 is architecturally visible
    ora $00
    sta $00
    xba
    sta $0000,x

h96a_next:
    inx
    inx
    iny
    iny
    cpx #$0180
    bne h96a_loop

    ; Publish the adjusted palette back to its architected work-RAM address.
    jsr h96a_commit_dma

    ; Exact post-loop architectural registers.
    lda #$FFFF
    sta $1C                    ; final DBRA leaves D7.w=-1
    lda #$19D2
    sta $20
    lda #$00F0
    sta $22                    ; A0=A5+$1952+$80
    lda $90
    sta $24
    lda $92
    sta $26                    ; A1=selected pointer+$0A+$80

    ; ORI.L #$003C0000,$1B12(A5).  Raw native word OR $3C00 is byte-identical
    ; to the big-endian high-word OR.  Its result is never zero; N comes from
    ; the original long's top bit, V/C clear, and accepted-path X is zero.
    lda $401B12
    ora #$3C00
    sta $401B12
    xba
    and #$8000
    beq h96a_n_clear
    lda #$0001
    sta $70
    bra h96a_n_done
h96a_n_clear:
    stz $70
h96a_n_done:
    stz $60
    stz $72
    stz $6E
    stz $A2

    ; The synthetic return value remains in work RAM, while architecturally
    ; RTS restores the unchanged caller A7 and masks the emulated PC to 24 bit.
    lda $42
    and #$00FF
    sta $42
    jml.l ors_pre

h96a_generated_fallback:
    ; Recreate the overwritten LDA $40 and continue at the byte immediately
    ; after the bank-$99 wrapper.  No emulated state has changed.
    rep #$30
.a16
.i16
    lda $40
    jml.l h96a_generated_resume

; BW-RAM current palette -> IRAM $0100, then PRG-ROM target -> IRAM $0180.
; $8C/$8E is the mapped 24-bit address of the first target word.
h96a_stage_dma:
    sep #$20
.a8
.i16
    lda #$20
    sta $220B
    lda #$81                   ; physical BW-RAM bank 0 -> IRAM
    sta $2230
    lda #$52
    sta $2232
    lda #$19
    sta $2233
    stz $2234
    lda #$80
    sta $2238
    stz $2239
    stz $2235
    lda #$01
    sta $2236                  ; trigger destination $0100

    lda #$20
    sta $220B
    lda #$80                   ; mapped PRG ROM -> IRAM
    sta $2230
    lda $8C
    sta $2232
    lda $8D
    sta $2233
    lda $8E
    sta $2234
    lda #$80
    sta $2238
    stz $2239
    lda #$80
    sta $2235
    lda #$01
    sta $2236                  ; trigger destination $0180
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

; IRAM $0100 -> physical BW-RAM bank 0 at the emulated $F01952 palette.
h96a_commit_dma:
    sep #$20
.a8
.i16
    lda #$20
    sta $220B
    lda #$86
    sta $2230
    stz $2232
    lda #$01
    sta $2233
    stz $2234
    lda #$80
    sta $2238
    stz $2239
    lda #$52
    sta $2235
    lda #$19
    sta $2236
    stz $2237                  ; destination physical bank 0; trigger
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

hle_96a_end:

; ============================================================================
; hle_c262 — guarded exact round-start tilemap-root implementation.
;
; $00:C262 initializes fourteen fixed tilemap rows.  The four hard-coded ROM
; pointers resolve to one contiguous $055CD4-$055FE3 source run; D2 selects
; fixed $40-byte destination rows and every call uses tile base $9000.  The
; ROM packer therefore derives two private 13-row payloads at $95:B000 and this
; body copies each 56-byte row directly to the live bank-$41 shadow with
; PRG-ROM->BW-RAM DMA.  The fourteenth call still enters the independently
; MAME-validated $2742 HLE.  That preserves the exact MOVEM.W sign extension,
; A-register restore, final-call stack residue, and D7 side effect without
; re-running the other thirteen call frames.
;
; The fast path is deliberately production-narrow: A5=$F0:0000, A7 is a
; nonwrapping bank-$F0 stack disjoint from the callee pointer and modified work
; fields, and the indirect target remains $002742.  A rejected state recreates the overwritten
; REP/LDA/PHA prologue and resumes the byte-pinned generated bank-$99 body.
; ============================================================================
.org $A300
hle_c262:
    rep #$30
.a16
.i16
    lda $36
    cmp #$00F0
    bne hc262_reject
    lda $34
    bne hc262_reject
    lda $3E
    cmp #$00F0
    bne hc262_reject
    jsr hc262_stack_guard
    bcc hc262_reject
    nop                        ; preserve the fixed $95:A32F fast-path hook
    nop
    lda $401CBA                ; big-endian long $00002742, raw word pairs
    bne hc262_reject
    lda $401CBC
    cmp #$4227
    bne hc262_reject
    bra hc262_fast
hc262_reject:
    jmp hc262_generated_fallback

hc262_fast:
hle_c262_fast_hook:
    ; Exact fixed-field initialization.  Byte $2A36 and record bytes +6/+7
    ; remain caller-owned, just as they do in the original routine.
    lda #$0000                 ; STZ has no long-address form
    sta $402A32
    lda #$A001                 ; logical $01A0 in big-endian work RAM
    sta $402A34
    sep #$20
.a8
    lda #$01
    sta $402A37
    rep #$20
.a16
    lda #$0500                 ; logical pointer $0005707C
    sta $402A38
    lda #$7C70
    sta $402A3A
    lda #$0000
    sta $402A3C

    ; Fourteen eight-byte records: D0.w, D1.w, D2.w, untouched trailing word.
    stz $80
    stz $82
    lda #$000E
    sta $84
    ldx #$29B2
hc262_record_loop:
    lda $80
    xba
    sta $400000,x
    lda #$0000
    sta $400002,x
    lda $82
    xba
    sta $400004,x
    lda $80
    clc
    adc #$0020
    sta $80
    lda $82
    clc
    adc #$0040
    sta $82
    txa
    clc
    adc #$0008
    tax
    dec $84
    bne hc262_record_loop

    ; First thirteen rows of the code plane, then the color plane.  The packer
    ; stores only the 56 bytes each call changes, so the eight-byte gaps in each
    ; $40-byte destination row retain their exact pre-call contents.  Arcade
    ; $E0:0800/$0C00 maps to the renderer's bank-$41 $4800/$4C00 shadow; the
    ; lower aliases are unrelated physical BW-RAM.
    lda #$B000
    sta $80
    lda #$0095
    sta $82
    lda #$4800
    sta $84
    lda #$000D
    sta $86
hc262_code_dma_loop:
    jsr hc262_dma56
    lda $80
    clc
    adc #$0038
    sta $80
    lda $82
    adc #$0000
    sta $82
    lda $84
    clc
    adc #$0040
    sta $84
    dec $86
    bne hc262_code_dma_loop

    lda #$B2D8                 ; $0D * $38 bytes after the code-plane blob
    sta $80
    lda #$0095
    sta $82
    lda #$4C00
    sta $84
    lda #$000D
    sta $86
hc262_color_dma_loop:
    jsr hc262_dma56
    lda $80
    clc
    adc #$0038
    sta $80
    lda $82
    adc #$0000
    sta $82
    lda $84
    clc
    adc #$0040
    sta $84
    dec $86
    bne hc262_color_dma_loop

    ; Architectural state immediately before iteration 13's JSR (A0).
    lda #$0500                 ; $2A38 = $00057088 after three pointer advances
    sta $402A38
    lda #$8870
    sta $402A3A
    lda #$3800                 ; $2A3C = $0038
    sta $402A3C
    lda #$01A0
    sta $00                    ; D0.w
    stz $04                    ; D1.w
    lda #$0340
    sta $08                    ; D2.w
    lda #$0038
    sta $0C                    ; D3.l
    stz $0E
    stz $18                    ; D6.w before its final DBRA
    lda #$2742
    sta $20                    ; A0 = indirect target
    stz $22
    lda #$5FAC
    sta $24                    ; A1 = $055F74 + $38
    lda #$0005
    sta $26
    lda #$2A1A
    sta $30                    ; A4 = $F029B2 + 13*8
    lda #$00F0
    sta $32

    ; Build the final call's exact 14-byte argument block at A7-14.
    lda $3C
    sec
    sbc #$000E
    sta $3C
    tax
    lda #$4003                 ; logical row $0340
    sta $400000,x
    lda #$0090                 ; logical tile base $9000
    sta $400002,x
    lda #$0000
    sta $400004,x
    sta $400006,x
    lda #$0500                 ; logical source long $00055FAC
    sta $400008,x
    lda #$AC5F
    sta $40000A,x
    lda #$0000
    sta $40000C,x

    ; A real bank-$95 sentinel supplies the skipped JSR return.  $2742 consumes
    ; it through ors_pre and resumes at the label below.
    lda #hc262_after_2742
    sta $54
    lda #$00F9
    sta $56
    jsl.l push32_l
    jml.l entry_2742t

hc262_after_2742:
    rep #$30
.a16
.i16
    ; Replace the native resume marker at [entry A7-18,entry A7-14) with the
    ; original MC68000 JSR return $00:C2C2.  The final $2742 call already left
    ; every lower LINK/MOVEM byte exact.
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$0000
    sta $400000,x
    lda #$C2C2
    sta $400002,x

    lda $3C
    clc
    adc #$000E
    sta $3C                    ; ADDA.L #14,A7
    lda $3E
    adc #$0000
    sta $3E
    lda #$7000
    sta $402A3C                ; final logical offset $0070
    lda #$01C0
    sta $00
    lda #$0380
    sta $08
    lda #$FFFF
    sta $18
    lda #$2A22
    sta $30

    ; Final CCR comes from ADDI.W #$40,D2: $0340+$0040=$0380.
    stz $70
    stz $60
    stz $72
    stz $6E
    stz $A2
    lda #$C2F6
    sta $40
    stz $42
    jml.l inext

hc262_generated_fallback:
    ; Recreate the six bytes overwritten by entry_c262's JML/NOP/NOP wrapper.
    rep #$30
.a16
.i16
    lda #$0000
    pha
    jml.l entry_c262_generated_resume

; One precomputed 56-byte row from bank-$95 PRG ROM to physical BW-RAM bank 1,
; the backing of the live $41 tilemap shadow.  $80/$82=source, $84=destination.
hc262_dma56:
    sep #$20
.a8
.i16
    lda #$20
    sta $220B
    lda #$84                   ; PRG ROM -> BW-RAM
    sta $2230
    lda $80
    sta $2232
    lda $81
    sta $2233
    lda $82
    sta $2234
    lda #$38
    sta $2238
    stz $2239
    lda $84
    sta $2235
    lda $85
    sta $2236
    lda #$01
    sta $2237                  ; physical BW-RAM bank 1; trigger
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

; Admit [A7-56,A7) only when it is wholly below $1CBA, between the callee
; pointer and the $29B2 records, or above the final $2A3D metadata byte.
; Return C=1 accepted, C=0 rejected.  Production task stacks take the low arm.
hc262_stack_guard:
    rep #$30
.a16
.i16
    lda $3C
    cmp #$0038
    bcc hc262_stack_reject
    cmp #$1CBB                 ; A7 <= $1CBA: whole residue below pointer
    bcc hc262_stack_accept
    sec
    sbc #$0038
    sta $88                    ; residue start
    cmp #$1CBE
    bcc hc262_stack_reject     ; overlaps $1CBA-$1CBD
    lda $3C
    cmp #$29B3                 ; A7 <= $29B2: between pointer and records
    bcc hc262_stack_accept
    lda $88
    cmp #$2A3E
    bcs hc262_stack_accept     ; wholly above records/metadata
hc262_stack_reject:
    clc
    rts
hc262_stack_accept:
    sec
    rts

hle_c262_end:

; ============================================================================
; hle_9ea — guarded compact 496-word tile-attribute shifter.
;
; The generated body at $99:C500 is exact but spends roughly 75K-182K SA-1
; cycles rebuilding 32-bit address arithmetic and 68000 flags for every word.
; Production fixes A5 at $F00000 and the table at $F01732-$F01B11, so this
; implementation performs the same big-endian word transform directly in
; mapped BW-RAM.  It retains the skipped JSR's real stack residue, every
; architected D/A side effect, and the subtle X rule: X is cleared only if at
; least one nonzero color component executes a subtraction.
;
; Reject unless the fixed work-RAM mapping is present and the four-byte return
; slot is wholly disjoint from the table plus dirty longword.  The fallback
; recreates the overwritten REP/LDA prologue and resumes the generated body.
; ============================================================================
.org $A600
hle_9ea:
    rep #$30
.a16
.i16
    lda $36
    cmp #$00F0
    bne h9ea_reject
    lda $34
    bne h9ea_reject
    lda $3E
    cmp #$00F0
    bne h9ea_reject
    lda $3C
    cmp #$0004
    bcc h9ea_reject
    cmp #$1733                 ; A7 <= $1732: return slot below table
    bcc h9ea_fast
    sec
    sbc #$0004
    cmp #$1B16                 ; A7-4 >= $1B16: return slot above dirty long
    bcs h9ea_fast
h9ea_reject:
    jmp h9ea_generated_fallback

h9ea_fast:
hle_9ea_fast_hook:
    ; Materialize the JSR return that the callable hook skipped.
    lda $40
    sta $54
    lda $42
    sta $56
    jsl.l push32_l

    lda #$01EF
    sta $1C                    ; MOVE.W #$01EF,D7; D7 high remains untouched
    lda #$1732
    sta $20
    lda #$00F0
    sta $22                    ; LEA $1732(A5),A0

    ldx #$0000
h9ea_loop:
    lda $401732,x
    xba
    sta $00                    ; MOVE.W (A0),D0; D0 high remains untouched
    cmp #$0000                 ; XBA sets Z from only its resulting low byte
    beq h9ea_next

    and #$001E
    sta $04                    ; D1 = D0 & $001E
    beq h9ea_blue_done
    sec
    sbc #$0002
    sta $04
    stz $A2                    ; component SUBQ cannot borrow, therefore X=0
h9ea_blue_done:
    lda $00
    and #$03C0
    sta $08                    ; D2 = D0 & $03C0
    beq h9ea_green_done
    sec
    sbc #$0040
    sta $08
    stz $A2
h9ea_green_done:
    lda $00
    and #$7800
    sta $00                    ; D0 = D0 & $7800
    beq h9ea_red_done
    sec
    sbc #$0800
    sta $00
    stz $A2
h9ea_red_done:
    lda $04
    ora $08
    sta $04                    ; OR.W D2,D1 is architecturally visible
    ora $00
    sta $00                    ; OR.W D1,D0
    xba
    sta $401732,x

h9ea_next:
    inx
    inx
    cpx #$03E0                ; 496 words
    bne h9ea_loop

    lda #$FFFF
    sta $1C                    ; final DBRA leaves D7.w=-1
    lda #$1B12
    sta $20                    ; A0=A5+$1732+($1F0*2)
    lda #$00F0
    sta $22

    ; ORI.L #$FFFFFFFE,$1B12(A5), expressed in native byte order.
    lda #$FFFF
    sta $401B12
    lda $401B14
    and #$0100                 ; original logical bit zero lives at native bit 8
    ora #$FEFF
    sta $401B14

    ; The ORI.L result is always negative and nonzero; V/C clear, X retained
    ; from the last component subtraction (or the incoming CCR if none ran).
    lda #$0001
    sta $70
    stz $60
    stz $72
    stz $6E

    ; RTS: pop the exact synthetic return and restore the caller's A7.
    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    lda $3E
    adc #$0000
    sta $3E
h9ea_done:
    jml.l ors_pre

h9ea_generated_fallback:
    rep #$30
.a16
.i16
    lda $40
    jml.l h9ea_generated_resume

hle_9ea_end:

; ============================================================================
; entry_111at — table-convention copy of the validated native $00111A.
;
; The existing bank-$00 entry is a skipped-JSR implementation: A7 points at
; arg8 and $40/$42 hold its return.  A table reach instead has a real return at
; [A7] and arg8 at [A7+4].  In production that return is often the $00FB bank-
; $98 call-bridge sentinel, so consuming it in an adapter and jumping to inext
; is wrong: only op_rts/ors_pre can translate it back to the native caller.
;
; Keep the return untouched, use the same hand-audited algorithm with every
; argument displacement advanced by four, then tail-enter op_rts.  The helper
; calls are long because this copy lives in bank $95; its local ROM-word helper
; mirrors bank-$00 ce_rdw but calls the exported readbyte wrapper.
; ============================================================================
.org $A700
.a16
.i16
; --- transpiled from $00111A (hand-native table convention) ---
entry_111at:
    rep #$30
    inc $0726               ; shared $111A hit counter

    ; Materialize LINK/MOVEM's final dead-stack residue exactly.  The hot body
    ; keeps A7 fixed, but the original writes D0-D6.w, A0-A4.l, and old A6.l
    ; into [entry A7-38, entry A7).  This costs little and keeps the full-RAM
    ; differential honest instead of classifying the missing frame as benign.
    lda $3C
    sec
    sbc #$0026
    tax
    lda $00                  ; D0-D6 words
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $04
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $08
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $0C
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $10
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $14
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $18
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $22                  ; A0-A4 longs, high word then low word
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $20
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $26
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $24
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $2A
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $28
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $2E
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $2C
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $32
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $30
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $3A                  ; LINK's saved old A6
    xba
    sta $400000,x
    xba
    inx
    inx
    lda $38
    xba
    sta $400000,x
    xba

    ; arg8 = [a7+4] because [a7+0..3] is the real/sentinel return.
    lda $3C
    clc
    adc #$0004
    tax
    lda $400000,x
    xba
    clc
    adc $34                 ; + a5.lo
    sta $98                 ; base
    clc
    adc #$1CF6
    sta $90                 ; a4off (X)
    lda $98
    clc
    adc #$20F2
    sta $92                 ; a3off (Y)

    ; a0 = [a7+12] and d7 = [a7+16].
    lda $3C
    clc
    adc #$000C
    tax
    lda $400000,x
    xba
    sta $9A                 ; a0.hi16
    lda $3C
    clc
    adc #$000E
    tax
    lda $400000,x
    xba
    sta $9C                 ; a0.lo16
    ; Cache the packed-ROM pointer once for the production stream.  Restrict
    ; the fast class to 68K banks $00-$06, so any 16-bit Y displacement remains
    ; inside the legal $000000-$07FFFF image even when it crosses a bank edge.
    ; $94=0 retains the per-read address-space mapper for work RAM, I/O, and
    ; the conservative top-ROM-bank case used by synthetic differentials.
    stz $94
    lda $9A
    cmp #$0007
    bcs e111at_source_ready
    lda $9C
    sta $66
    lda $9A
    clc
    adc #$00C1
    sta $68
    lda #$0001
    sta $94
e111at_source_ready:
    lda $3C
    clc
    adc #$0010
    tax
    lda $400000,x
    xba
    sta $8E                 ; d7 count

    ; Organic late-combat calls use three immutable ROM shapes.  Their
    ; capacity is larger than the number of nonzero cells, and the observed
    ; coordinates keep every nonzero cell inside the unclipped X/Y range.
    ; Select only that fully proven class; all other sources, capacities, and
    ; clipping cases retain the generic loop below.
    lda $9A
    cmp #$0003
    bne e111at_generic
    lda $9C
    cmp #$37F0
    beq e111at_hot_source_337f0
    cmp #$3C0A
    beq e111at_hot_source_33c0a
    cmp #$44C6
    beq e111at_hot_source_344c6
    bra e111at_generic
e111at_hot_source_337f0:
    lda $8E
    cmp #$0011              ; 18 slots for 16 nonzero cells
    bne e111at_generic
    stz $9E                 ; shape selector 0
    bra e111at_hot_guard
e111at_hot_source_33c0a:
    lda $8E
    cmp #$0011              ; 18 slots for 12 nonzero cells
    bne e111at_generic
    lda #$0001
    sta $9E                 ; shape selector 1
    bra e111at_hot_guard
e111at_hot_source_344c6:
    lda $8E
    cmp #$000F              ; 16 slots for 13 nonzero cells
    bne e111at_generic
    lda #$0002
    sta $9E                 ; shape selector 2
e111at_hot_guard:
    stz $94                 ; hot X rows are unclipped unless proved below
    lda $3C                 ; screen X at [a7+8]
    clc
    adc #$0008
    tax
    lda $400000,x
    xba
    sta $80
    lda $80                 ; XBA flags reflect its low byte, not word sign
    bmi e111at_hot_negative_x
    cmp #$00AB              ; row 4 remains nonnegative through X=$AA
    bcs e111at_generic
    bra e111at_hot_x_ready
e111at_hot_negative_x:
    ; The organic Right+B $033C0A stream enters with screen X <= -$50.
    ; Across the complete signed-negative range $8000-$FFB0, every one of
    ; its five computed X rows lies outside the original -5..$F9 visible
    ; interval (including the signed-wrap boundary), so every nonzero cell
    ; receives the hidden marker $00FA.  -$4F and warmer retain the generic
    ; path because the last row can become visible there.
    lda $9E
    cmp #$0001
    bne e111at_generic
    lda $80
    cmp #$FFB1
    bcs e111at_generic
    inc $94                 ; replace all five computed X rows with $00FA
e111at_hot_x_ready:
    lda $3C                 ; screen Y at [a7+10]
    clc
    adc #$000A
    tax
    lda $400000,x
    xba
    sta $9C
    cmp #$0140              ; hottest nonzero column is +$40, below $180
    bcs e111at_generic
    jmp e111at_hot

e111at_generic:

    ldy #$0000              ; d0 = [a0+0]
    jsr e111at_rdw
    sta $80
    lda $3C                 ; d1 = $EA - [a7+8]
    clc
    adc #$0008
    tax
    lda $400000,x
    xba
    sta $98
    lda #$00EA
    sec
    sbc $98
    sta $82
    lda #$0004              ; a1off = 4
    sta $96
e111at_outer:
    lda #$00FA              ; d5 = $FA; clamp to d1 for -5 <= d1 <= $F9
    sta $8A
    lda $82
    cmp #$00FA
    bvs e111at_ova
    bpl e111at_d15e
    bra e111at_cklo
e111at_ova:
    bmi e111at_d15e
e111at_cklo:
    lda $82
    cmp #$FFFA
    beq e111at_d15e
    bvs e111at_ovb
    bmi e111at_d15e
    bra e111at_clamp
e111at_ovb:
    bpl e111at_d15e
e111at_clamp:
    lda $82
    sta $8A
e111at_d15e:
    ldy #$0002              ; d2 = [a0+2]
    jsr e111at_rdw
    sta $84
    lda $3C                 ; d6 = d3 = [a7+10]
    clc
    adc #$000A
    tax
    lda $400000,x
    xba
    sta $88
    ; The original immediately executes ADDI.W #0,D3.  That leaves D3
    ; unchanged but clears X (as well as C); later word arithmetic below may
    ; replace X again.
    stz $A2
e111at_inner:
    lda $88                 ; d3 = d6 (running Y)
    sta $86
    ldy $96                 ; tst [a1]+; a1off += 2
    jsr e111at_rdw
    inc $96
    inc $96
    cmp #$0000
    bne e111at_dowr
    jmp e111at_d196
e111at_dowr:
    lda $8A                 ; d4 = d5
    sta $8C
    lda $86                 ; if d3 <= -16 || d3 >= $180, d4 = $FA
    cmp #$FFF0
    beq e111at_xfa
    bvs e111at_ovc
    bmi e111at_xfa
    bra e111at_ckhi
e111at_ovc:
    bpl e111at_xfa
e111at_ckhi:
    lda $86
    cmp #$0180
    bvs e111at_ovd
    bmi e111at_d184
    bra e111at_xfa
e111at_ovd:
    bpl e111at_d184
e111at_xfa:
    lda #$00FA
    sta $8C
e111at_d184:
    lda $8E                 ; tst d7; negative means done
    bpl e111at_wrx
    jmp e111at_neg_done
e111at_wrx:
    lda $8C                 ; (a4)+ = d4 (X stream)
    ldx $90
    xba
    sta $400000,x
    xba
    inc $90
    inc $90
    ldx $92                 ; [a3] = ([a3] & $f800) | (d3 & $1ff)
    lda $400000,x
    xba
    and #$F800
    sta $9E
    lda $86
    and #$01FF
    ora $9E
    ldx $92
    xba
    sta $400000,x
    xba
    inc $92
    inc $92
    dec $8E                 ; d7 -= 1
e111at_d196:
    lda $88                 ; d6 += $10
    clc
    adc #$0010
    sta $88
    ; ADDI.W updates X to its unsigned carry.
    bcs e111at_d6_x1
    stz $A2
    bra e111at_d6_x_done
e111at_d6_x1:
    lda #$0001
    sta $A2
e111at_d6_x_done:
    lda $84                 ; dbra d2
    dec a
    sta $84
    cmp #$FFFF
    beq e111at_d2x
    jmp e111at_inner
e111at_d2x:
    lda $82                 ; d1 -= $10
    sec
    sbc #$0010
    sta $82
    ; SUBI.W updates X to the 68K borrow (inverse of 65816 carry).
    bcs e111at_d1_x0
    lda #$0001
    sta $A2
    bra e111at_d1_x_done
e111at_d1_x0:
    stz $A2
e111at_d1_x_done:
    lda $80                 ; dbra d0
    dec a
    sta $80
    cmp #$FFFF
    beq e111at_d0x
    jmp e111at_outer
e111at_d0x:
    lda $8E                 ; if d7 < 0 done, else fill
    bmi e111at_neg_done
e111at_fill:
    lda #$00FA
    ldx $90
    xba
    sta $400000,x
    xba
    inc $90
    inc $90
    lda $8E                 ; dbra d7
    dec a
    sta $8E
    cmp #$FFFF
    bne e111at_fill
    ; The final MOVE.W #$00FA stream write leaves N=Z=V=C=0; X remains
    ; whatever the last ADDI/SUBI above produced.
    stz $60
    stz $70
    stz $72
    stz $6E
    bra e111at_done
e111at_neg_done:
    ; The exit TST.W saw a negative D7: N=1, Z=V=C=0; X remains whatever
    ; the last arithmetic operation above produced.
    stz $60
    lda #$0001
    sta $70
    stz $72
    stz $6E
e111at_done:
    ldx #$0000              ; movem.w (a7)+,d0-d6 sign-extends each word
e111at_sext:
    lda $00,x
    and #$8000
    beq e111at_sx0
    lda #$FFFF
e111at_sx0:
    sta $02,x
    inx
    inx
    inx
    inx
    cpx #$001C
    bne e111at_sext
    lda #$FFFF              ; DBRA changes only D7.lo; preserve D7.hi
    sta $1C
e111at_return:
    jml.l op_rts             ; pop the untouched real/sentinel return

e111at_rdw:                 ; Y displacement from the a0 saved in $9A:$9C
    lda $94
    beq e111at_rdw_slow
    lda [$66],y             ; cached packed-ROM pointer; one BE word load
    xba
    rts
e111at_rdw_slow:
    tya
    clc
    adc $9C
    sta $54
    lda $9A
    adc #$0000
    sta $52
    ; Production frame streams live in 68K ROM.  Read their big-endian word
    ; directly from the packed $C1:0000+ image instead of taking two long
    ; calls through the byte-wise address-space mapper.  Retain the generic
    ; path for work RAM/I/O and the bank-edge case, which keeps the synthetic
    ; and fallback contracts unchanged.
    cmp #$0008
    bcs e111at_rdw_generic
    lda $54
    cmp #$FFFF
    beq e111at_rdw_generic
    sta $66
    lda $52
    clc
    adc #$00C1
    sta $68
    lda [$66]
    xba
    rts
e111at_rdw_generic:
    jsl.l readbyte_l         ; high byte
    xba
    sta $98
    inc $54
    bne e111at_rdw_lo
    inc $52
e111at_rdw_lo:
    jsl.l readbyte_l         ; low byte
    ora $98
    rts

; Guarded ROM-shape specialization selected above.  Precompute the five X
; rows and five Y columns, then emit only the immutable nonzero cells.  The
; output streams advance in parallel, so one native Y index addresses both
; long pointers.  e111at_hot_emit receives X in A and Y in native X.
e111at_hot:
.a16
.i16
    lda #$00EA
    sec
    sbc $80
    sta $80                 ; row 0 X
    sec
    sbc #$0010
    sta $82                 ; row 1 X
    sec
    sbc #$0010
    sta $84                 ; row 2 X
    sec
    sbc #$0010
    sta $86                 ; row 3 X
    sec
    sbc #$0010
    sta $88                 ; row 4 X
    sec
    sbc #$0010              ; original final SUBI.W controls X
    bcs e111at_hot_x_clear
    lda #$0001
    sta $A2
    bra e111at_hot_x_done
e111at_hot_x_clear:
    stz $A2
e111at_hot_x_done:
    lda $94
    beq e111at_hot_rows_ready
    lda #$00FA
    sta $80
    sta $82
    sta $84
    sta $86
    sta $88
e111at_hot_rows_ready:
    lda $9C
    sta $8A                 ; column 0 Y
    clc
    adc #$0010
    sta $8C                 ; column 1 Y
    clc
    adc #$0010
    sta $8E                 ; column 2 Y
    clc
    adc #$0010
    sta $96                 ; column 3 Y
    clc
    adc #$0010
    sta $98                 ; column 4 Y

    lda $90                 ; long pointer to the X stream
    sta $66
    lda #$0040
    sta $68
    lda $92                 ; long pointer to the Y/attribute stream
    sta $6A
    lda #$0040
    sta $6C
    ldy #$0000
    lda $9E
    beq e111at_hot_337f0
    cmp #$0001
    beq e111at_hot_33c0a
    jmp e111at_hot_344c6

; $0337F0: 5x5, nonzero at 0-3 / 0-3 / 1-2 / 0-2 / 0-2.
e111at_hot_337f0:
    lda $80
    ldx $8A
    jsr e111at_hot_emit
    lda $80
    ldx $8C
    jsr e111at_hot_emit
    lda $80
    ldx $8E
    jsr e111at_hot_emit
    lda $80
    ldx $96
    jsr e111at_hot_emit
    lda $82
    ldx $8A
    jsr e111at_hot_emit
    lda $82
    ldx $8C
    jsr e111at_hot_emit
    lda $82
    ldx $8E
    jsr e111at_hot_emit
    lda $82
    ldx $96
    jsr e111at_hot_emit
    lda $84
    ldx $8C
    jsr e111at_hot_emit
    lda $84
    ldx $8E
    jsr e111at_hot_emit
    lda $86
    ldx $8A
    jsr e111at_hot_emit
    lda $86
    ldx $8C
    jsr e111at_hot_emit
    lda $86
    ldx $8E
    jsr e111at_hot_emit
    lda $88
    ldx $8A
    jsr e111at_hot_emit
    lda $88
    ldx $8C
    jsr e111at_hot_emit
    lda $88
    ldx $8E
    jsr e111at_hot_emit
    ldx #$0001              ; two unused output slots
    jmp e111at_hot_finish

; $033C0A: 5x5, nonzero at 1-2 / 0-2 / 0-2 / 0-2 / 0.
e111at_hot_33c0a:
    lda $80
    ldx $8C
    jsr e111at_hot_emit
    lda $80
    ldx $8E
    jsr e111at_hot_emit
    lda $82
    ldx $8A
    jsr e111at_hot_emit
    lda $82
    ldx $8C
    jsr e111at_hot_emit
    lda $82
    ldx $8E
    jsr e111at_hot_emit
    lda $84
    ldx $8A
    jsr e111at_hot_emit
    lda $84
    ldx $8C
    jsr e111at_hot_emit
    lda $84
    ldx $8E
    jsr e111at_hot_emit
    lda $86
    ldx $8A
    jsr e111at_hot_emit
    lda $86
    ldx $8C
    jsr e111at_hot_emit
    lda $86
    ldx $8E
    jsr e111at_hot_emit
    lda $88
    ldx $8A
    jsr e111at_hot_emit
    ldx #$0005              ; six unused output slots
    jmp e111at_hot_finish

; $0344C6: 5x6, nonzero at 2-3 / 2-4 / 2-4 / 2-4 / 2-3.
e111at_hot_344c6:
    lda $80
    ldx $8E
    jsr e111at_hot_emit
    lda $80
    ldx $96
    jsr e111at_hot_emit
    lda $82
    ldx $8E
    jsr e111at_hot_emit
    lda $82
    ldx $96
    jsr e111at_hot_emit
    lda $82
    ldx $98
    jsr e111at_hot_emit
    lda $84
    ldx $8E
    jsr e111at_hot_emit
    lda $84
    ldx $96
    jsr e111at_hot_emit
    lda $84
    ldx $98
    jsr e111at_hot_emit
    lda $86
    ldx $8E
    jsr e111at_hot_emit
    lda $86
    ldx $96
    jsr e111at_hot_emit
    lda $86
    ldx $98
    jsr e111at_hot_emit
    lda $88
    ldx $8E
    jsr e111at_hot_emit
    lda $88
    ldx $96
    jsr e111at_hot_emit
    ldx #$0002              ; three unused output slots

e111at_hot_finish:
    lda #$00FA
    xba
e111at_hot_fill:
    sta [$66],y
    iny
    iny
    dex
    bpl e111at_hot_fill
    stz $60                 ; final MOVE.W #$00FA flags
    stz $70
    stz $72
    stz $6E
    jmp e111at_done

e111at_hot_emit:
    xba
    sta [$66],y
    txa
    sta $9A
    lda [$6A],y
    xba
    and #$F800
    ora $9A
    xba
    sta [$6A],y
    iny
    iny
    rts
entry_111at_end:

; ============================================================================
; Rejected $C8E0 compact-HLE island.
;
; The 2026-07-20 organic round-start checkpoint corrupted the task mask to
; $D0FF before gameplay.  Its old $95:A700-$AEFF body remains absent; only the
; bounded $111A table body above occupies part of that island.  The C8E0
; table entry and generated-body redirect are disabled, and its raw negative profile is
; retained under build/playability-20260720/c8e0-compact-transition-profile-v1/.
; ============================================================================

; The generated fallback reaches this fixed island after its final DBRA.  For
; disjoint canonical stacks, repair its last native call marker to the genuine
; MC68000 $00:C2C2 residue; aliasing cases retain the previous native behavior.
.org $AF00
hc262_generated_finish:
    rep #$30
.a16
.i16
    lda $3E
    cmp #$00F0
    bne hc262_finish_pc
    lda $3C
    cmp #$0012
    bcc hc262_finish_pc
    sec
    sbc #$0012
    sta $80                    ; return-residue start = entry A7-18
    clc
    adc #$0004
    sta $82                    ; exclusive end

    lda $82
    cmp #$1CBA
    bcc hc262_finish_pointer_ok
