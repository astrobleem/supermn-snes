; ============================================================================
; Guarded semantic fast path for the bank-$97 callable $00CB9E sprite helper.
;
; The generated body at $E800 is retained as historical/fallback material, but
; its entry redirects here.  Production $CAF6 calls use a ROM A0 and work-RAM
; A1/A6/A2; generic rdw_ea_l/writeword_l calls made that canonical case cost
; ~23K cycles/tick across five draws.  Direct accesses below preserve the 68K
; register/CCR/stack contract.  Any other address shape is interpreted from
; the original $00CB9E after the skipped BSR return has been materialized.
;
; Fixed after entry_1d5f0 (currently ends below $F920).  Keep the zero seam and
; bank-end assertions in tools/build_interp_rom.py green.
; ============================================================================
    .org $FA00
hcb9e_fast:
    rep #$30
    .a16
    .i16

    ; Re-simulate the BSR return skipped by the direct native call bridge.
    lda $40
    sta $54
    lda $42
    sta $56
    jsl.l push32_l

    jsr hcb_guard
    bcs hcb_fast_guarded
    jmp hcb_slow
hcb_fast_guarded:
    jsr hcb_core
    jmp hcb_return

    ; Canonical fast-path shape: A6 and A1 are non-wrapping work-RAM pointers,
    ; A0 is flat arcade ROM, and [A6-$54] names a bounded work-RAM A2 record.
hcb_guard:
    lda $3A
    cmp #$00F0
    beq hcb_g_a6bank
    jmp hcb_guard_fail
hcb_g_a6bank:
    lda $38
    cmp #$0080
    bcs hcb_g_a6low
    jmp hcb_guard_fail
hcb_g_a6low:
    lda $26
    cmp #$00F0
    beq hcb_g_a1bank
    jmp hcb_guard_fail
hcb_g_a1bank:
    lda $24
    cmp #$FFF4
    bcc hcb_g_a1range
    jmp hcb_guard_fail
hcb_g_a1range:
    lda $22
    cmp #$0008
    bcc hcb_g_a0rom
    jmp hcb_guard_fail
hcb_g_a0rom:
    lda $38
    clc
    adc #$FFAC
    tax
    lda $400000,x
    xba
    cmp #$00F0
    beq hcb_g_a2bank
    jmp hcb_guard_fail
hcb_g_a2bank:
    inx
    inx
    lda $400000,x
    xba
    cmp #$FFFA
    bcc hcb_guard_ok
hcb_guard_fail:
    clc
    rts
hcb_guard_ok:
    sec
    rts

hcb_core:
hcb_begin:
    ; tst.w (a1); ble early return.
    ldx $24
    jsr hcb_rdw40
    sta $80
    cmp #$0000              ; XBA reports byte-N; TST.W needs bit 15
    beq hcb_early_near
    bmi hcb_early_near
    bra hcb_normal
hcb_early_near:
    jmp hcb_early

hcb_normal:
    ; D0 = [A6-$22] + [A0+6]; [A1+6] = D0.
    lda $38
    clc
    adc #$FFDE
    tax
    jsr hcb_rdw40
    sta $82
    ldy #$0006
    jsr hcb_rdw_a0
    clc
    adc $82
    sta $00
    lda $24
    clc
    adc #$0006
    tax
    lda $00
    jsr hcb_wrw40

    ; D0 = [A6-$22] + [A0+8]; [A1+8] = D0.
    ldy #$0008
    jsr hcb_rdw_a0
    clc
    adc $82
    sta $00
    lda $24
    clc
    adc #$0008
    tax
    lda $00
    jsr hcb_wrw40

    ; Source position/attribute tuple.
    ldy #$0002
    jsr hcb_rdw_a0
    sta $84
    ldy #$0004
    jsr hcb_rdw_a0
    sta $86
    ldy #$000C
    jsr hcb_rdb_a0
    sep #$20
    sta $08
    rep #$20

    ; btst #7,[A6-$24]: mirrored sprites swap and negate X/Y and adjust D2.B.
    lda $38
    clc
    adc #$FFDC
    tax
    sep #$20
    lda $400000,x
    and #$80
    rep #$20
    bne hcb_mirrored
    lda $84
    sta $00
    lda $86
    sta $04
    bra hcb_position_ready
hcb_mirrored:
    lda $86
    eor #$FFFF
    inc a
    sta $00
    lda $84
    eor #$FFFF
    inc a
    sta $04
    lda $08
    eor #$FFFF
    inc a
    sta $08
    sep #$20
    lda $08
    clc
    adc #$80
    sta $08
    rep #$20

hcb_position_ready:
    ; [A1+2/+4] = [A6-$1E] + D0/D1; D3 retains the second sum.
    lda $38
    clc
    adc #$FFE2
    tax
    jsr hcb_rdw40
    sta $8A
    clc
    adc $00
    sta $0C
    lda $24
    clc
    adc #$0002
    tax
    lda $0C
    jsr hcb_wrw40
    lda $8A
    clc
    adc $04
    sta $0C
    bcc hcb_addx_clear
    lda #$0001
    sta $A2                 ; final ADD.W carry is the preserved X result
    bra hcb_addx_done
hcb_addx_clear:
    stz $A2
hcb_addx_done:
    lda $24
    clc
    adc #$0004
    tax
    lda $0C
    jsr hcb_wrw40

    ; [A1+C].B = D2.B.
    lda $24
    clc
    adc #$000C
    tax
    sep #$20
    lda $08
    sta $400000,x
    rep #$20

    ; A2=[A6-$54]; publish active flag and the computed pair.
    lda $38
    clc
    adc #$FFAC
    tax
    lda $400000,x
    xba
    sta $2A
    inx
    inx
    lda $400000,x
    xba
    sta $28
    ldx $28
    lda #$0001
    jsr hcb_wrw40
    lda $24
    clc
    adc #$0004
    tax
    jsr hcb_rdw40
    pha
    lda $28
    clc
    adc #$0004
    tax
    pla
    jsr hcb_wrw40
    lda $24
    clc
    adc #$0002
    tax
    jsr hcb_rdw40
    sta $8C
    pha
    lda $28
    clc
    adc #$0002
    tax
    pla
    jsr hcb_wrw40

    ; MOVE.W exit flags: N/Z from [A1+2], V=C=0, X preserved.
    lda $8C
    bne hcb_norm_nonzero
    lda #$0001
    sta $60
    bra hcb_norm_n
hcb_norm_nonzero:
    stz $60
hcb_norm_n:
    lda $8C
    and #$8000
    sta $70
    stz $6E
    stz $72
    bra hcb_core_return

hcb_early:
    ; TST.W exit flags; no emulated register is changed on this path.
    lda $80
    bne hcb_early_nonzero
    lda #$0001
    sta $60
    bra hcb_early_n
hcb_early_nonzero:
    stz $60
hcb_early_n:
    lda $80
    and #$8000
    sta $70
    stz $6E
    stz $72

hcb_core_return:
    rts

hcb_return:
    ; Pop the callable bridge sentinel and resume its native continuation.
    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

hcb_slow:
    ; The return is already on the emulated stack.  Entering through inext
    ; interprets the original leaf directly; native BSR matching is not rerun.
    lda #$CB9E
    sta $40
    stz $42
    jml.l inext

; Local big-endian work-RAM and direct flat-ROM primitives.
hcb_rdw40:
    lda $400000,x
    xba
    rts

hcb_wrw40:
    xba
    sta $400000,x
    xba
    rts

hcb_rdw_a0:
    tya
    clc
    adc $20
    sta $96
    lda $22
    adc #$00C1
    sta $98
    lda [$96]
    xba
    rts

hcb_rdb_a0:
    tya
    clc
    adc $20
    sta $96
    lda $22
    adc #$00C1
    sta $98
    sep #$20
    lda [$96]
    rep #$20
    and #$00FF
    rts

