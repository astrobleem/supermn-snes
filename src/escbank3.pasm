    sta $1C
    cmp #$FFFF
    beq Lfcaf6_9
    jmp Lcaf6_cb46
Lfcaf6_9:
    ; DBRA preserves every 68K CCR bit.  The callable $CB9E body immediately
    ; before it has already materialized its result in $60/$6E/$70/$72/$A2;
    ; do not leak the 65816 `cmp #$FFFF` loop-control flags into that state.
    jmp Lcaf6_cb9c
    lda #$2D16
    sta $20
    lda #$0003
    sta $22
    lda $1C
    sta $9A
    lda $9A
    asl a
    lda #$0000
    sbc #$0000
    eor #$FFFF
    sta $9C
    lda $20
    clc
    adc $9A
    sta $20
    lda $22
    adc $9C
    sta $22
    lda $20
    clc
    adc #$0000
    sta $54
    lda $22
    adc #$0000
    sta $52
    jsl.l rdw_ea_l
    sta $9E
    lda $20
    clc
    adc #$0002
    sta $54
    lda $22
    adc #$0000
    sta $52
    jsl.l rdw_ea_l
    sta $20
    lda $9E
    sta $22
    lda $20
    clc
    adc #$0000
    sta $54
    lda $22
    adc #$0000
    sta $52
    jsl.l rdw_ea_l
    pha
    lda $20
    clc
    adc #$0002
    sta $20
    lda $22
    adc #$0000
    sta $22
    pla
    sta $1C
Lcaf6_cb82:
    lda $20
    clc
    adc #$0000
    sta $54
    lda $22
    adc #$0000
    sta $52
    jsl.l rdw_ea_l
    sta $00
    lda $38
    clc
    adc #$FFC8
    sta $24
    lda $3A
    adc #$FFFF
    sta $26
    lda $00
    sta $9A
    lda $9A
    asl a
    lda #$0000
    sbc #$0000
    eor #$FFFF
    sta $9C
    lda $24
    clc
    adc $9A
    sta $24
    lda $26
    adc $9C
    sta $26
    lda $24
    clc
    adc #$0000
    sta $54
    lda $26
    adc #$0000
    sta $52
    jsl.l rdw_ea_l
    sta $9E
    lda $24
    clc
    adc #$0002
    sta $54
    lda $26
    adc #$0000
    sta $52
    jsl.l rdw_ea_l
    sta $24
    lda $9E
    sta $26
    ; CALL-BRIDGE bsr.w $cb9e -> entry_cb9e (NATIVE escape), resume brcaf6_2
    lda #brcaf6_2
    sta $40
    lda #$00FC
    sta $42
    jmp entry_cb9e
brcaf6_2:
    lda $20
    clc
    adc #$0010
    sta $20
    lda $22
    adc #$0000
    sta $22
    lda $1C
    dec a
    sta $1C
    cmp #$FFFF
    beq Lfcaf6_10
    jmp Lcaf6_cb82
Lfcaf6_10:
Lcaf6_cb9c:
    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

caf6_generated_end:

; ============================================================================
; Guarded production-shape $00CAF6 sprite-list builder.
;
; The settled gameplay paths select immutable ROM lists $032F78 or $032FCA:
; five records whose A1-table offsets are 0,4,8,12,16.  The generated body
; spends most of its time routing those known-ROM/known-work accesses through
; generic EA helpers.  This path proves the complete address shape before
; making any emulated-state change and performs the same writes in the same
; record order.  Every other branch/list/address shape falls back to
; caf6_generated.
; ============================================================================
    .org $DD00
hcaf6_guard_fail0:
    .a16
    .i16
    jmp hcaf6_fallback
hcaf6_fast:
    rep #$30
    .a16
    .i16

    ; A6 is the established task-frame arena.  This also bounds every local
    ; read from A6-$54 through A6-$04 inside work RAM without bank wrapping.
    lda $3A
    cmp #$00F0
    bne hcaf6_guard_fail0
    lda $38
    cmp #$1000
    bcc hcaf6_guard_fail0
    cmp #$2000
    bcs hcaf6_guard_fail0

    ; Production selector family.  The direct branch resolves either of the
    ; two immutable five-record lists used in settled gameplay:
    ;   1. D2 != [A6-$04] and D2 is 4 or 8.  The original $032578+D2
    ;      selector table resolves those values to $032F78 and $032FCA,
    ;      respectively.  This transition shape does not modify D0 or D1.
    ;   2. D2 == [A6-$04], [A6-$16] in 2..$7FFF, and [A6-$18] is
    ;      $000C/$0124 (list $032F78) or $0010/$0014 (list $032FCA).
    ;   3. The same equality with D2=4 and [A6-$16]=1.  Input D1=0 takes the
    ;      negative-D1 cb00 branch; ROM $03257C->$0326B2 yields $000C.  Input
    ;      D1=1 uses exact frame pointer $0326B8, whose word is $0124.  Both
    ;      selectors therefore reach the same list.
    ; All conditional branches below target nearby backward trampolines so
    ; Poppy cannot silently wrap a short branch while laying out this guard.
    lda $38
    sec
    sbc #$001A
    tax
    lda $400000,x
    xba
    sta $8E
    stz $94                  ; 0=direct, 1=negative-D1, 2=frame, 3=D2 table
    stz $96                  ; 0=list $032F78, 1=list $032FCA
    lda $38
    sec
    sbc #$0004
    tax
    lda $400000,x
    xba
    cmp $8E
    beq hcaf6_selector_equal

    ; Unequal selectors use the immutable longword table at $032578.  Only
    ; the two transition values observed in production are admitted:
    ;   D2=4: $03257C->$0326B2->$000C->$032F78
    ;   D2=8: $032580->$0326BC->$0010->$032FCA
    ; Unlike the equal selector tree, this route leaves D0/D1 untouched.
    lda #$0003
    sta $94
    lda $8E
    cmp #$0004
    beq hcaf6_selector_table_done
    cmp #$0008
    bne hcaf6_guard_fail0
    inc $96
hcaf6_selector_table_done:
    .a16
    .i16
    jmp hcaf6_guard_a2

hcaf6_selector_equal:
    .a16
    .i16

    jmp hcaf6_selector_check
hcaf6_selector_fail:
    .a16
    .i16
    ; Give the exact late-game selector families one guarded external chance
    ; before restarting the untouched generated function.
    jml.l $9DFED0
hcaf6_selector_special:
    .a16
    .i16
    jmp hcaf6_selector_special_body
hcaf6_selector_check:
    .a16
    .i16
    lda #$0002
    sta $90                  ; fixed bound keeps post-branch CMP size stable
    lda $38
    sec
    sbc #$0016
    tax
    lda $400000,x
    xba
    sta $92
    cmp #$0001
    beq hcaf6_selector_special
    cmp $90
    bcc hcaf6_selector_fail
    lda $92
    bmi hcaf6_selector_fail
    jmp hcaf6_selector_direct_body

hcaf6_selector_special_body:
    .a16
    .i16
    lda $8E
    cmp #$0004
    beq hcaf6_selector_special_d2_ready
    cmp #$0008
    bne hcaf6_selector_fail
    inc $96                  ; D2=8 boundary paths resolve immutable $032FCA
hcaf6_selector_special_d2_ready:
    .a16
    .i16
    lda $38
    sec
    sbc #$0014
    tax
    lda $400000,x
    xba
    sta $90
    jmp hcaf6_selector_special_d1_check
hcaf6_selector_special_negative:
    .a16
    .i16
    inc $94
    jmp hcaf6_guard_a2
hcaf6_selector_special_d1_check:
    .a16
    .i16
    lda $90
    beq hcaf6_selector_special_negative
    cmp $92                  ; $92 is still the input D0 value $0001
    bne hcaf6_selector_fail
    jmp hcaf6_selector_special_frame

hcaf6_selector_special_frame:
    .a16
    .i16
    lda #$26B8
    sta $90
    lda $96
    beq hcaf6_selector_special_frame_ptr_ready
    lda #$26C2              ; D2=8 frame word is $0014 -> list $032FCA
    sta $90
hcaf6_selector_special_frame_ptr_ready:
    .a16
    .i16
    lda $38
    sec
    sbc #$0012
    tax
    lda $400000,x
    xba
    cmp #$0003
    bne hcaf6_selector_direct_fail
    inx
    inx
    lda $400000,x
    xba
    cmp $90
    bne hcaf6_selector_direct_fail
    inc $94
    inc $94
    jmp hcaf6_guard_a2

hcaf6_selector_direct_body:
    .a16
    .i16
    jmp hcaf6_selector_direct_check
hcaf6_selector_direct_fail:
    .a16
    .i16
    jml.l $9DFED0
hcaf6_selector_direct_ok:
    .a16
    .i16
    jmp hcaf6_guard_a2
hcaf6_selector_direct_check:
    .a16
    .i16
    lda $38
    sec
    sbc #$0018
    tax
    lda $400000,x
    xba
    cmp #$000C
    beq hcaf6_selector_direct_ok
    cmp #$0010
    beq hcaf6_selector_direct_ok
    cmp #$0014
    beq hcaf6_selector_direct_ok
    cmp #$0124
    bne hcaf6_selector_direct_fail
    jmp hcaf6_selector_direct_ok

    ; [A6-$54] is the active-object record written by each normal CB9E call.
hcaf6_guard_fail_a2:
    .a16
    .i16
    jmp hcaf6_fallback
hcaf6_guard_a2:
    .a16
    .i16
    lda $38
    sec
    sbc #$0054
    tax
    lda $400000,x
    xba
    cmp #$00F0
    bne hcaf6_guard_fail_a2
    inx
    inx
    lda $400000,x
    xba
    cmp #$3000
    bcc hcaf6_guard_fail_a2
    cmp #$FFFB
    bcs hcaf6_guard_fail_a2

    ; A second nearby failure trampoline keeps every conditional branch
    ; backward and in range; Poppy has silently misencoded forward shorts.
    jmp hcaf6_guard_a1_setup
hcaf6_guard_fail1:
    .a16
    .i16
    jmp hcaf6_fallback

    ; Preflight the five contiguous A1 pointer slots.  Keeping both the frame
    ; and target pools disjoint makes this scan stable under the later writes;
    ; duplicate/aliasing A1/A2 records still execute sequentially as on 68K.
hcaf6_guard_a1_setup:
    .a16
    .i16
    lda $38
    sec
    sbc #$0038
    tax
    ldy #$0005
hcaf6_guard_a1:
    .a16
    .i16
    lda $400000,x
    xba
    cmp #$00F0
    bne hcaf6_guard_fail1
    inx
    inx
    lda $400000,x
    xba
    cmp #$3000
    bcc hcaf6_guard_fail1
    cmp #$3FF1
    bcs hcaf6_guard_fail1
    inx
    inx
    dey
    bne hcaf6_guard_a1

hcaf6_guard_done:
    .a16
    .i16
    ; Both boundary selectors execute SUBQ.W on D0 and D1 before choosing the
    ; same list.  Recreate those observable register lows only after every
    ; guard is green, so a late failure enters caf6_generated untouched.
    jmp hcaf6_selector_state_check
hcaf6_selector_state_special:
    .a16
    .i16
    stz $00
    lda $94
    sec
    sbc #$0002              ; selector 1 -> D1=$FFFF; selector 2 -> D1=$0000
    sta $04
    jmp hcaf6_selector_state_done
hcaf6_selector_state_check:
    .a16
    .i16
    lda $94
    beq hcaf6_selector_state_done
    cmp #$0003              ; D2-table route does not execute SUBQ on D0/D1
    beq hcaf6_selector_state_done
    jmp hcaf6_selector_state_special
hcaf6_selector_state_done:
    .a16
    .i16
    ; Re-simulate the skipped outer BSR exactly as the callable generated body
    ; does.  Its sentinel return remains the sole intentionally synthetic word.
    lda $40
    sta $54
    lda $42
    sta $56
    jsl.l push32_l

hcaf6_after_push:
    .a16
    .i16
    ; Observable register state at the canonical loop head.
    lda $38
    sec
    sbc #$001A
    tax
    lda $400000,x
    xba
    sta $08                  ; D2.W = [A6-$1A]
    lda #$0004
    sta $1C                  ; D7.W = list count (DBRA executes five times)
    lda #$2F7A
    sta $20
    lda #$0003
    sta $22                  ; default A0: first record after $032F78 count word
    ; The direct $0010 selector instead names list $032FCA.  Re-read the
    ; already-proved frame word here so no speculative state survives a guard
    ; miss and the two constant bodies receive the exact original A0.
    lda $94
    beq hcaf6_direct_list_select
    lda $96
    beq hcaf6_d6_select      ; established D2=4 boundary list is $032F78
    jmp hcaf6_use_32fca
hcaf6_direct_list_select:
    .a16
    .i16
    lda $38
    sec
    sbc #$0018
    tax
    lda $400000,x
    xba
    cmp #$0010
    beq hcaf6_use_32fca
    cmp #$0014
    bne hcaf6_d6_select
hcaf6_use_32fca:
    .a16
    .i16
    lda #$2FCC
    sta $20                  ; first record after $032FCA count word
    jmp hcaf6_d6_select
hcaf6_d6_zero:
    .a16
    .i16
    lda #$0020
    sta $18
    jmp hcaf6_loop
hcaf6_d6_select:
    .a16
    .i16
    lda $38
    sec
    sbc #$0050
    tax
    lda $400000,x
    xba
    beq hcaf6_d6_zero
    lda #$0040
    sta $18
    jmp hcaf6_loop

hcaf6_loop:
    .a16
    .i16
    ; The guard proved one of the two immutable lists.  Route $032F78 to the
    ; established bank-$95 body and the live $032FCA shape to its bank-$9D
    ; body.  The retained generic loop below remains dead on a guard hit but is
    ; kept as fallback history.
    lda $20
    cmp #$2FCC
    beq hcaf6_loop_32fca
    cmp #$320A
    beq hcaf6_loop_33208
    cmp #$3300
    beq hcaf6_loop_332fe
    cmp #$2F7A
    bne hcaf6_loop_generic
    jml.l $95FA00
hcaf6_loop_32fca:
    jml.l $9DA200
hcaf6_loop_33208:
    jml.l $95FE20
hcaf6_loop_332fe:
    jml.l $95FF10
hcaf6_loop_generic:
    ; The constant-list routes above already know offsets 0,4,8,12,16.
    ; This formerly unreachable generic body must fetch the current record's
    ; actual A6-table offset before deriving A1.
    ldy #$0000
    jsr hcb_rdw_a0
    sta $00
    lda $38
    clc
    adc #$FFC8
    clc
    adc $00
    tax
    lda $400000,x
    xba
    sta $26
    inx
    inx
    lda $400000,x
    xba
    sta $24

    ; move.w $E(A0),(A1); clr.w $E(A1).
    ldy #$000E
    jsr hcb_rdw_a0
    ldx $24
    jsr hcb_wrw40
    lda $24
    clc
    adc #$000E
    tax
    lda #$0000
    jsr hcb_wrw40

    ; move.l $A(A0),$A(A1), preserving the arcade big-endian word order.
    ldy #$000A
    jsr hcb_rdw_a0
    sta $8E
    ldy #$000C
    jsr hcb_rdw_a0
    sta $90
    lda $24
    clc
    adc #$000A
    tax
    lda $8E
    jsr hcb_wrw40
    inx
    inx
    lda $90
    jsr hcb_wrw40

    ; add.w D6,$A(A1).  Record X now so a CB9E TST early-return retains the
    ; same extend bit; normal CB9E records overwrite X with their final ADD.W.
    lda $8E
    clc
    adc $18
    sta $8E
    lda #$0000
    adc #$0000
    sta $A2
    lda $24
    clc
    adc #$000A
    tax
    lda $8E
    jsr hcb_wrw40

    ; Native-call the same semantic core used by the generic callable entry;
    ; the enclosing CAF6 owns the single emulated return frame.
hcaf6_before_core:
    .a16
    .i16
    jsr hcb_core
hcaf6_after_core:
    .a16
    .i16

    ; ADDA.L #$10,A0 and DBRA D7.  Neither changes 68K CCR, so the CB9E words
    ; remain authoritative at function return.
    jmp hcaf6_loop_check
hcaf6_loop_again:
    .a16
    .i16
    jmp hcaf6_loop
hcaf6_loop_check:
    .a16
    .i16
    lda $20
    clc
    adc #$0010
    sta $20
    lda $22
    adc #$0000
    sta $22
    lda $1C
    dec a
    sta $1C
    cmp #$FFFF
    bne hcaf6_loop_again
    jmp Lcaf6_cb9c

hcaf6_fallback:
    .a16
    .i16
    jmp caf6_generated

hcaf6_end:
    .a16
    .i16

; ============================================================================
; h1e7c0_hot — guarded common object/render iteration for $01E7C0.
;
; entry_1e7c0's existing bank-$98 guard has already proved canonical A5/A6,
; all eight object pointers, and all three sub-record pointers.  This helper
; performs the real $3518->$351E prologue once, then keeps the common records
; in one bank instead of executing the large generated address-rebuild body.
;
; Each record is checked before its first architectural write.  A miss jumps
; to the unchanged generated L1e7c0_1e7cc with A1 still pointing at that slot
; and D5 still holding its DBRA index, so mixed animation/edge ticks retain the
; exact old path for an unsupported current record.  Its generated DBRA
; backedge returns here to reconsider the next record, so one uncommon slot
; no longer forces every remaining slot through the large generated body.
; Supported calls
; are the two organic renderer callbacks ($000D96 and $00111A), both entered
; with a real $00FC bank-$97 sentinel.  Their table-convention RTS returns here
; through ors_pre.  If a callback changes the mode word, its post-call state is
; handed to the unchanged bank-$98 br1e7c0_10 continuation.
;
; Cross-bank generated seams are imported from fresh bank-$98 symbols by
; tools/gen_escbank3_syms.py and byte-audited by build_interp_rom.py.  The
; independently fixed $95:A700 entry_111at remains numeric.
; ============================================================================
    .org $E000
h1e7c0_hot:
    rep #$30
    .a16
    .i16
    jmp h1e7c0_hot_entry

h1e7c0_hot_cold:
    ; Prologue is already committed; generated loop reloads this current slot.
    jml.l L1e7c0_1e7cc
h1e7c0_hot_done:
    ; D5 already fell through to $FFFF, exactly as DBRA; run the unchanged tail.
    jml.l Lf1e7c0_227
h1e7c0_hot_post_cold:
    ; Callback returned with A7 at the fourteen-byte argument frame, exactly
    ; the state expected by the generated post-call continuation.
    jml.l br1e7c0_10

h1e7c0_hot_entry:
    ; move.w $3518(a5),$351e(a5)
    lda $403518
    sta $40351E

    ; lea -$20(a6),a1 / moveq #7,d5
    lda $38
    sec
    sbc #$0020
    sta $24
    lda $3A
    sbc #$0000
    sta $26
    lda #$0007
    sta $14
    stz $16

h1e7c0_hot_reentry:
    ; The generated current-record body enters here only after its DBRA has
    ; advanced A1 and decremented D5.  Recheck the global invariants without
    ; replaying the one-time prologue or resetting the live loop registers.
    ; The common post-render mode is one.  A7 must hold the callback frame in
    ; canonical work RAM with room for its sentinel and renderer save image.
    lda $402A4A
    xba
    cmp #$0001
    beq h1e7c0_hot_mode_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_mode_ok:
    lda $3E
    cmp #$00F0
    beq h1e7c0_hot_spbank_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_spbank_ok:
    lda $3C
    cmp #$0040
    bcs h1e7c0_hot_splow_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_splow_ok:
    cmp #$FFE0
    bcc h1e7c0_hot_sphigh_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_sphigh_ok:
    ; Any armed per-slot special bit takes the unchanged path from slot seven.
    lda $403522
    and #$00FF
    beq h1e7c0_hot_loop
    jmp h1e7c0_hot_cold

h1e7c0_hot_loop:
    .a16
    .i16
    ; Peek (A1) without changing architectural A1/D7/A0 until every guard for
    ; this record has passed.  This makes the cold edge restart-exact.
    ldx $24
    lda $400000,x
    xba
    sta $82                         ; pointer high
    inx
    inx
    lda $400000,x
    xba
    sta $80                         ; pointer low
    ora $82
    bne h1e7c0_hot_nonnull

    ; Null record: MOVE.L loaded zero into D7 and (A1)+ still advanced.
    stz $1C
    stz $1E
    lda $24
    clc
    adc #$0004
    sta $24
    jmp h1e7c0_hot_decrement

h1e7c0_hot_nonnull:
    lda $82
    cmp #$00F0
    beq h1e7c0_hot_objbank_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_objbank_ok:
    ldx $80

    ; Common no-motion/no-script record class.
    lda $400004,x
    and #$00FF
    beq h1e7c0_hot_b4_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_b4_ok:
    lda $400066,x
    and #$00FF
    beq h1e7c0_hot_b66_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_b66_ok:
    lda $40000A,x
    and #$00FF
    beq h1e7c0_hot_ba_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_ba_ok:
    lda $400005,x
    and #$00FF
    beq h1e7c0_hot_b5_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_b5_ok:

    ; Negative countdowns retain the restart-exact whole-record fallback.
    ; Counts zero and one are safe to commit through the common transform:
    ; immediately before SUBQ below they rejoin the unchanged generated
    ; animation-script interpreter at its exact $01EE3A instruction seam.
    lda $40000E,x
    xba
    cmp #$8000
    bcc h1e7c0_hot_count_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_count_ok:

    ; Cache the three guarded sub-record lows.  Zero script states take the
    ; fully native common transform.  A nonzero state is not a whole-record
    ; miss: after the shared camera/visibility prefix is committed below, hand
    ; it to the unchanged generated body at original $01E94A.  That seam owns
    ; every animation/script opcode while avoiding the expensive generated
    ; prefix which is identical for this guarded no-motion record class.
    stz $94                         ; nonzero script-state flag
    lda $400048,x
    xba
    sta $84                         ; A2 low
    tax
    lda $40000E,x
    xba
    ora #$0000                     ; XBA exposes only byte N/Z; test full word
    beq h1e7c0_hot_a2e_ok
    lda #$0001
    sta $94
h1e7c0_hot_a2e_ok:
    ldx $80
    lda $40004C,x
    xba
    sta $86                         ; A3 low
    tax
    lda $40000E,x
    xba
    ora #$0000                     ; XBA exposes only byte N/Z; test full word
    beq h1e7c0_hot_a3e_ok
    lda #$0001
    sta $94
h1e7c0_hot_a3e_ok:
    ldx $80
    lda $400050,x
    xba
    sta $88                         ; A4/sub-record low

    ; Horizontal signs must select the additive common transform.
    lda $400036,x
    xba
    sta $8A
    lda $40003C,x
    xba
    eor $8A
    and #$8000
    beq h1e7c0_hot_sign_ok
    jmp h1e7c0_hot_cold
h1e7c0_hot_sign_ok:

    ; d1 = obj.x - global camera x.  The original body keeps the near-
    ; offscreen intervals -$EF..$0B and $175..$26F alive, sets visibility bit
    ; zero, and then joins the same vertical/transform path as an on-screen
    ; record.  Retain only the far ranges (<= -$F0 or >= $270) for the
    ; destructive generated removal path.
    lda $40002E,x
    xba
    sta $8A
    lda $402A32
    xba
    sta $8E                         ; camera delta
    lda $8A
    sec
    sbc $8E
    sta $8A                         ; new d1.w
    stz $92                         ; final visibility-bit contribution
    bmi h1e7c0_hot_d1_negative
    cmp #$000C
    bcc h1e7c0_hot_d1_offscreen
    cmp #$0175
    bcc h1e7c0_hot_d1_ok
    cmp #$0270
    bcc h1e7c0_hot_d1_offscreen
    jmp h1e7c0_hot_cold
h1e7c0_hot_d1_negative:
    cmp #$FF11
    bcs h1e7c0_hot_d1_offscreen
    jmp h1e7c0_hot_cold
h1e7c0_hot_d1_offscreen:
    lda #$0001
    sta $92
h1e7c0_hot_d1_ok:

    ; Keep the original unclamped vertical arms: signed 0..160, plus the
    ; near-negative interval -127..-1.  The latter remains a live object but
    ; sets visibility bit zero at $01E92A.  Values <= -128 take the destructive
    ; $01E8D6 removal path, so retain the generated body for those records.
    ldx $80
    lda $400032,x
    xba
    sta $8C                         ; new d2.w
    cmp #$00A1
    bcc h1e7c0_hot_d2_ok
    cmp #$FF81
    bcs h1e7c0_hot_d2_negative
    jmp h1e7c0_hot_cold
h1e7c0_hot_d2_negative:
    ; Mark the accepted negative arm for the commit-time BSET #0,$8(A0).
    lda #$0001
    sta $92
    bra h1e7c0_hot_d2_ready
h1e7c0_hot_d2_ok:
h1e7c0_hot_d2_ready:

    ; Prove the organic callback before the first architectural write.
    lda $400036,x
    xba
    ora #$0000                     ; TST.W semantics, not XBA's byte flags
    bmi h1e7c0_hot_cb_negative
    lda $403514
    xba
    ora #$0000
    bne h1e7c0_hot_cb_bad
    lda $403516
    xba
    bra h1e7c0_hot_cb_check
h1e7c0_hot_cb_negative:
    lda $403510
    xba
    ora #$0000
    bne h1e7c0_hot_cb_bad
    lda $403512
    xba
h1e7c0_hot_cb_check:
    cmp #$0D96
    beq h1e7c0_hot_cb_ok
    cmp #$111A
    beq h1e7c0_hot_cb_ok
h1e7c0_hot_cb_bad:
    jmp h1e7c0_hot_cold
h1e7c0_hot_cb_ok:
    sta $90                         ; callback low

    ; ---- Commit the proven record in original MC68000 order. ----
    lda $80
    sta $1C                         ; D7/A0 = loaded object pointer
    sta $20
    lda #$00F0
    sta $1E
    sta $22
    lda $24
    clc
    adc #$0004
    sta $24                         ; (A1)+ (guard proved no carry)

    lda $8A
    sta $04                         ; D1.w
    lda $8C
    sta $08                         ; D2.w
    ; The original prefix replaces the camera delta with MOVEQ #2,D7 while
    ; $2932 is nonzero before subtracting D7 from the per-object $5E timer.
    ; Stage 1 keeps camera X at zero while $2932 is one, so omitting this
    ; override left every guarded object's timer frozen and eventually changed
    ; enemy state transitions.  MOVEQ also clears D7's high word.
h1e7c0_hot_timer_delta_select:
    lda $402932
    xba
    beq h1e7c0_hot_timer_delta_ready
    lda #$0002
    sta $8E
    stz $1E
h1e7c0_hot_timer_delta_ready:
    lda $8E
    sta $1C                         ; MOVE.W/MOVEQ timer delta,D7

    ldx $80
    lda $40005E,x                   ; SUB.W D7,$5e(A0)
    xba
    sec
    sbc $8E
    xba
    sta $40005E,x
    xba
    ; SUB.W also publishes the MC68000 X bit.  The fully native path replaces
    ; X during its later coordinate subtraction, but the $01E94A generated
    ; script handoff inherits this value before any other X-writing opcode.
    ; 65816 C=1 means no borrow; MC68000 X=1 means borrow.
    bcs h1e7c0_hot_camera_no_borrow
    lda #$0001
    sta $A2
    bra h1e7c0_hot_camera_x_ready
h1e7c0_hot_camera_no_borrow:
    stz $A2
h1e7c0_hot_camera_x_ready:

    sep #$20                        ; BCLR/BSET #0,$8(A0)
    lda $400008,x
    and #$FE
    ora $92
    sta $400008,x
    rep #$20
    .a16
    .i16

    ; The original $01E94A seam begins by loading A2/A3 and testing their
    ; script words, so no CCR value or sub-record register materialization is
    ; live across this handoff.  A0/A1, D1/D2/D7, the camera subtraction, and
    ; visibility bit now exactly match the original prefix.  Crucially, do not
    ; clear object byte $6 here: the generated script selector owns that write
    ; at $01EBAE when its selected path requires it.
    lda $94
    beq h1e7c0_hot_no_script
    jml.l L1e7c0_1e94a
h1e7c0_hot_no_script:

    sep #$20
    lda #$00
    sta $400006,x                   ; CLR.B $6(A0)
    rep #$20
    .a16
    .i16

    lda $84
    sta $28                         ; A2
    lda #$00F0
    sta $2A
    lda $86
    sta $2C                         ; A3
    lda #$00F0
    sta $2E
    lda $88
    sta $30                         ; A4 sub-record
    lda #$00F0
    sta $32

    ; Store current coordinates, then apply Y delta to all three records.
    ldx $80
    lda $04
    xba
    sta $40002E,x
    xba
    lda $08
    xba
    sta $400032,x
    xba
    lda $40003A,x
    xba
    sta $9A
    lda $08
    sec
    sbc $9A
    sta $8E                         ; delta Y
    ldx $84
    jsr h1e7c0_hot_add68
    ldx $86
    jsr h1e7c0_hot_add68
    ldx $88
    jsr h1e7c0_hot_add68

    ; Matching signs select the additive X delta and CLR.W D0 arm.
    ldx $80
    lda $400038,x
    xba
    sta $9A
    lda $04
    sec
    sbc $9A
    sta $8E                         ; delta X
    ldx $84
    jsr h1e7c0_hot_add24
    ldx $86
    jsr h1e7c0_hot_add24
    ldx $88
    jsr h1e7c0_hot_add24
    stz $00                         ; CLR.W D0 (high word unchanged)

    ; The generated body owns every expired-script operation.  All common
    ; record writes and live D/A registers now match its state immediately
    ; before SUBQ.W #1,$E(A0), so this preserves the complete opcode table
    ; without replaying the expensive transform from L1E7CC.
    ldx $80
    lda $40000E,x
    xba
    cmp #$0002
    bcs h1e7c0_hot_steady_animation
    jml.l L1e7c0_1ee3a
h1e7c0_hot_steady_animation:

    ; SUBQ.W #1,$e(A0), then load the render capacity into D6.w.
    ; A still holds the big-endian countdown loaded above.
    dec a
    xba
    sta $40000E,x
    xba
    lda $40001A,x
    xba
    sta $18

    ; Materialize the fourteen-byte argument frame.  Raw words copied from
    ; work RAM remain byte-identical; computed words are byte-swapped once.
    lda $40351E
    sta $82                         ; raw arg0: output cursor
    lda $400018,x
    sta $84                         ; raw arg2
    lda $400044,x
    xba
    sta $9A
    lda $08
    sec
    sbc $9A
    sta $86                         ; arg4 = d2-obj44
    lda $400042,x
    xba
    sta $9A
    lda $04
    sec
    sbc $9A
    sta $88                         ; arg6 = d1-obj42
    lda $400014,x
    sta $8A                         ; raw arg8 high word
    lda $400016,x
    sta $8C                         ; raw arg8 low word
    lda $18
    dec a
    sta $8E                         ; arg12 = d6-1
    stz $1E                         ; prior CLR.L D7 makes its high word zero
    sta $1C                         ; MOVE.W result,D7

    lda $3C
    sec
    sbc #$000E
    sta $3C
    tax
    lda $82
    sta $400000,x
    inx
    inx
    lda $84
    sta $400000,x
    inx
    inx
    lda $86
    xba
    sta $400000,x
    inx
    inx
    lda $88
    xba
    sta $400000,x
    inx
    inx
    lda $8A
    sta $400000,x
    inx
    inx
    lda $8C
    sta $400000,x
    inx
    inx
    lda $8E
    xba
    sta $400000,x

    lda $90
    sta $30                         ; A4 = selected callback
    stz $32
    lda #h1e7c0_hot_return
    sta $54
    lda #$00FC
    sta $56
    jsl.l push32_l
    lda $30
    cmp #$0D96
    beq h1e7c0_hot_call_d96
    jml.l $95A700                   ; entry_111at
h1e7c0_hot_call_d96:
    jml.l entry_d96t

h1e7c0_hot_return:
    rep #$30
    .a16
    .i16
    ; The helper replaces the original JSR (A4) at $01F096.  Its callback
    ; popped the bank-$FC continuation, so restore the arcade $0001F098
    ; return residue below A7 before either hot or generated post-call work.
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$0001
    xba
    sta $400000,x
    xba
    inx
    inx
    lda #$F098
    xba
    sta $400000,x
    xba
    ; A callback is allowed to change the mode.  Let the generated continuation
    ; own every non-common result before this helper changes A7 or game state.
    lda $402A4A
    xba
    cmp #$0001
    beq h1e7c0_hot_post
    jmp h1e7c0_hot_post_cold
h1e7c0_hot_post:
    lda $3C
    clc
    adc #$000E
    sta $3C                         ; ADDA.W #$e,A7
    lda $3E
    adc #$0000
    sta $3E

    lda $18                         ; ADD.W D6,D6
    clc
    adc $18
    sta $18
    sta $8E
    lda $40351E                     ; ADD.W D6,$351e(A5)
    xba
    clc
    adc $8E
    xba
    sta $40351E
    xba

    ldx $20                         ; BCLR #1,$8(A0)
    sep #$20
    lda $400008,x
    and #$FD
    sta $400008,x
    lda #$00
    sta $400007,x                   ; MOVE.B #0,$7(A0)
    rep #$20
    .a16
    .i16

    ; Table mode one loads displacement $0008 into D7.w.
    lda #$0008
    sta $1C

    lda $402A50                     ; SUB.W cameraX,D1
    xba
    sta $8E
    lda $04
    sec
    sbc $8E
    sta $04

    lda $402A4E                     ; SUB.W cameraY,D2; retain X/borrow
    xba
    sta $8E
    lda $08
    sec
    sbc $8E
    sta $08
    bcs h1e7c0_hot_x0
    lda #$0001
    sta $80
    bra h1e7c0_hot_x_saved
h1e7c0_hot_x0:
    stz $80
h1e7c0_hot_x_saved:
    lda #$2A4C
    sta $30                         ; LEA $2a4c(A5),A4
    lda #$00F0
    sta $32
    lda $402A4C
    xba
    sta $1C                         ; MOVE.W (A4),D7
    and #$0800
    bne h1e7c0_hot_setbit
    lda $1C
    and #$00FF
    cmp #$0005
    bne h1e7c0_hot_store_pos
    lda $08                         ; SUBI.W #$10,D2
    sec
    sbc #$0010
    sta $08
    bcs h1e7c0_hot_x0b
    lda #$0001
    sta $80
    bra h1e7c0_hot_store_pos
h1e7c0_hot_x0b:
    stz $80
    bra h1e7c0_hot_store_pos
h1e7c0_hot_setbit:
    ldx $20
    sep #$20
    lda $400008,x
    ora #$02
    sta $400008,x
    rep #$20
    .a16
    .i16

h1e7c0_hot_store_pos:
    ldx $20
    lda $04
    xba
    sta $40003E,x
    xba
    lda $08
    xba
    sta $400040,x
    xba

    ; Final MOVE.W D2,$40(A0) flags.  X remains the last D2 subtraction.
    stz $6E
    stz $72
    lda $80
    sta $A2
    lda $08
    beq h1e7c0_hot_final_z
    stz $60
    and #$8000
    sta $70
    bra h1e7c0_hot_decrement
h1e7c0_hot_final_z:
    lda #$0001
    sta $60
    stz $70

h1e7c0_hot_decrement:
    lda $14
    dec a
    sta $14                         ; DBRA does not alter emulated CCR
    cmp #$FFFF
    beq h1e7c0_hot_all_done
    jmp h1e7c0_hot_loop
h1e7c0_hot_all_done:
    jmp h1e7c0_hot_done

; Add signed word $8E to the big-endian +6/+8 pair at X.
h1e7c0_hot_add68:
    lda $400006,x
    xba
    clc
    adc $8E
    xba
    sta $400006,x
    xba
    lda $400008,x
    xba
    clc
    adc $8E
    xba
    sta $400008,x
    xba
    rts

; Add signed word $8E to the big-endian +2/+4 pair at X.
h1e7c0_hot_add24:
    lda $400002,x
    xba
    clc
    adc $8E
    xba
    sta $400002,x
    xba
    lda $400004,x
    xba
    clc
    adc $8E
    xba
    sta $400004,x
    xba
    rts

h1e7c0_hot_end:
    .a16
    .i16

; Fixed-bank X-publication helpers for the older generated $01E7C0 cold-record
; body in bank $98.  That body predates transpile.py --xflag.  Its internal
; arithmetic has no X-consuming opcode, but the final removal/coordinate/tail
; arithmetic is architectural at the coroutine boundary.  Bank $98 replaces
; each complete arithmetic sequence with a same-size JSL to one of these
; pinned helpers; A returns with the original arithmetic result and P with the
; native subtraction/addition flags, while emulated X at $A2 receives 68000
; borrow/carry.  Keep each helper within its $20-byte slot.
.org $E500
h1e7c0_x_sub_d2_9e:
    rep #$30
    lda $08
    sec
    sbc $9E
    php
    pha
    lda #$0000
    rol a
    eor #$0001
    sta $A2
    pla
    plp
    rtl
h1e7c0_x_sub_d2_9e_end:

.org $E520
h1e7c0_x_sub_d4_9e:
    rep #$30
    lda $10
    sec
    sbc $9E
    php
    pha
    lda #$0000
    rol a
    eor #$0001
    sta $A2
    pla
    plp
    rtl
h1e7c0_x_sub_d4_9e_end:

.org $E540
h1e7c0_x_sub_d2_0078:
    rep #$30
    lda $08
    sec
    sbc #$0078
    php
    pha
    lda #$0000
    rol a
    eor #$0001
    sta $A2
    pla
    plp
    rtl
h1e7c0_x_sub_d2_0078_end:

.org $E560
h1e7c0_x_sub_d2_0010:
    rep #$30
    lda $08
    sec
    sbc #$0010
    php
    pha
    lda #$0000
    rol a
    eor #$0001
    sta $A2
    pla
    plp
    rtl
h1e7c0_x_sub_d2_0010_end:

.org $E580
h1e7c0_x_sub_d7_0001:
    rep #$30
    lda $1C
    sec
    sbc #$0001
    php
    pha
    lda #$0000
    rol a
    eor #$0001
    sta $A2
    pla
    plp
    rtl
h1e7c0_x_sub_d7_0001_end:

.org $E5A0
h1e7c0_x_add_be_351c:
    rep #$30
    xba
    clc
    adc $1C
    php
    pha
    lda #$0000
    rol a
    sta $A2
    pla
    plp
    rtl
h1e7c0_x_add_be_351c_end:

; Keep the bank-$00 seam fixed. The staged F2 virtual-cycle diagnostic handles
; both its fractional reload and legacy-disabled $7000 behavior, then RTLs to
; the existing pending/VID path. Four NOPs preserve this eight-byte island.
.org $E5C0
campaign_irq_reload:
    jml $F28500
    nop
    nop
    nop
    nop
campaign_irq_reload_end:

; Return C=1 only when the bounded low-word native $25110 body is safe to
; enter.  Paced gameplay is allowed: its generated blocks now charge $AC and
; its observed arcade IRQ seams yield with real logical resume PCs.
h25110_native_guard:
    rep #$30
    lda $34
    bne h25110_native_guard_reject
    lda $36
    cmp #$00F0
    bne h25110_native_guard_reject
    sec
    rts
h25110_native_guard_reject:
    clc
    rts
h25110_native_guard_end:

; Save a genuine mid-function logical PC, then let inext's ordinary $AC==1
; path decrement to zero and deliver the virtual level-6 IRQ.  No register or
; CCR field is touched beyond the architected PC.
h25110_yield_2582a:
    lda #$582A
    sta $40
    lda #$0002
    sta $42
    jml.l inext
h25110_yield_2582e:
    lda #$582E
    sta $40
    lda #$0002
    sta $42
    jml.l inext
h25110_yield_259b0:
    lda #$59B0
    sta $40
    lda #$0002
    sta $42
    jml.l inext
h25110_yield_end:

; Fast-RTE targets for the three mid-$25110 scheduler states.  $02582E resumes
; at BLE using the TST.W flags restored by RTE; re-reading the object word
; after an IRQ would not be equivalent if another task changed that record.
entry_25110_resume_2582a:
    jmp L25110_2582a
entry_25110_resume_2582e:
    lda $60
    bne entry_25110_resume_2582e_taken
    lda $70
    eor $72
    bne entry_25110_resume_2582e_taken
    jmp Lf25110_269
entry_25110_resume_2582e_taken:
    jmp Lf25110_268
entry_25110_resume_259b0:
    jmp L25110_259b0
entry_25110_resume_end:

; Flag-preserving specialized forms of transpile.py's generated $AC charge.
; Each generated block is one three-byte JSR; the shared helper subtracts its
; exact logical-instruction count and clamps at one so a caller can yield only
; at an explicit 68000 boundary.
esc3_ac_charge_1:
    php
    rep #$30
    lda #$0001
    bra esc3_ac_charge_common
esc3_ac_charge_2:
    php
    rep #$30
    lda #$0002
    bra esc3_ac_charge_common
esc3_ac_charge_3:
    php
    rep #$30
    lda #$0003
    bra esc3_ac_charge_common
esc3_ac_charge_4:
    php
    rep #$30
    lda #$0004
    bra esc3_ac_charge_common
esc3_ac_charge_5:
    php
    rep #$30
    lda #$0005
    bra esc3_ac_charge_common
esc3_ac_charge_6:
    php
    rep #$30
    lda #$0006
esc3_ac_charge_common:
    pha
esc3_ac_charge_legacy_load:
    lda $AC
    sec
esc3_ac_charge_legacy_sbc:
    sbc $01,s
    bcc esc3_ac_charge_clamp
    beq esc3_ac_charge_clamp
    sta $AC
    pla
    plp
    rts
esc3_ac_charge_clamp:
    lda #$0001
    sta $AC
    pla
    plp
    rts
esc3_ac_charge_end:

; These diagnostic-only gateways live in otherwise unused bank-$97 space.
; Normal ROM packing leaves every production call site on the legacy path.
; VTIME=1 packing replaces one same-bank JSR or JML per seam, so the default
; native handler has no extra cross-bank calls or diagnostic state traffic.
    .org $E680
esc3_ac_charge_vtime_gateway:
    rep #$30
    jsl.l VTIME_ESC3_CHARGE
    cmp #$0001
    beq esc3_ac_charge_vtime_due
    cmp #$0002
    beq esc3_ac_charge_vtime_done
    pla                         ; VTIME state unavailable: restore legacy debit
    lda $AC
    sec
    jmp esc3_ac_charge_legacy_sbc
esc3_ac_charge_vtime_done:
    pla                         ; discard the pack-injected gateway JSR return
    pla                         ; generated logical count
    plp
    rts                         ; original generated-block JSR return
esc3_ac_charge_vtime_due:
    pla                         ; pack-injected gateway JSR return
    pla                         ; generated logical count
    plp
    rep #$20                    ; caller may have used 8-bit A; discard JSR frame as a word
    pla
    jml.l inext

h25110_vtime_entry_gateway:
