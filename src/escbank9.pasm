    .org $A100
.a16
.i16
; Bank-local twin of escbank2's esc_ac_charge.  The selector loop charges
; every generated basic block dynamically so IRQ work-point density remains
; equal to the interpreted routine.
esc9_ac_charge:
    rep #$30
    pha
    lda $AC
    sec
    sbc $01,s
    bcc esc9_ac_clamp
    beq esc9_ac_clamp
    sta $AC
    pla
    rts
esc9_ac_clamp:
    lda #$0001
    sta $AC
    pla
    rts
esc9_ac_charge_end:

