; ============================================================================
; Shared hand-exact Stage-3 box-record emitter for $027B44 and $02F56A.
;
; The tiny bank-$94 wrappers provide the pointer-field offset, attribute, and
; cold PC in $80/$82/$88-$8A.  This helper proves canonical mapped A4/A7 and a
; bounded canonical destination before the first write; every other legal
; layout runs the original routine through the interpreter.  Reads and writes
; retain the original order so even aliased mapped records remain faithful.
; ============================================================================
    .org $E800
.a16
.i16
hstage3_box_leaf:
    rep #$30
    lda $32
    cmp #$00F0
    bne hstage3_box_leaf_guard_fail
    lda $30
    cmp #$3FC9                       ; covers largest field offset + long
    bcs hstage3_box_leaf_guard_fail
    lda $3E
    cmp #$00F0
    bne hstage3_box_leaf_guard_fail
    lda $3C
    cmp #$3FFD
    bcs hstage3_box_leaf_guard_fail

    lda $30
    clc
    adc $80
    tax
    lda $400000,x
    xba
    cmp #$00F0
    bne hstage3_box_leaf_guard_fail
    lda $400002,x
    xba
    sta $84                          ; initial destination A3 low
    cmp #$3FF6                       ; writes through destination +$0A
    bcs hstage3_box_leaf_guard_fail
    bra hstage3_box_leaf_hot

hstage3_box_leaf_guard_fail:
    jmp hstage3_box_leaf_cold

hstage3_box_leaf_hot:
    ; Both source routines execute exactly sixteen original instructions.
    lda #$0010
    jsr esc9_ac_charge

    lda $84
    sta $2C
    lda #$00F0
    sta $2E                          ; MOVEA.L pointer,A3
    ldx $84

    lda $82
    xba
    sta $40000A,x                   ; attribute at $0A(A3)
    lda #$0001
    xba
    sta $400000,x                   ; MOVE.W #1,(A3)+

    ldx $30
    lda $400004,x
    xba
    clc
    adc #$FFF2
    sta $00
    ldx $84
    xba
    sta $400002,x
    ldx $30
    lda $400004,x
    xba
    clc
    adc #$000E
    sta $00
    ldx $84
    xba
    sta $400004,x
    ldx $30
    lda $400006,x
    xba
    clc
    adc #$FFF2
    sta $00
    ldx $84
    xba
    sta $400006,x
    ldx $30
    lda $400006,x
    xba
    clc
    adc #$000E
    sta $00                          ; final architectural D0.w
    lda #$0000
    rol a
    sta $A2                          ; X from the final ADD.W
    lda $00
    ldx $84
    xba
    sta $400008,x

    lda $84
    clc
    adc #$0008
    sta $2C                          ; four postincrements leave A3 at +8

    ; Final MOVE.W publishes N/Z, clears V/C, and preserves ADD.W's X.
    lda $00
    and #$8000
    sta $70
    stz $72
    stz $6E
    stz $60
    lda $00
    bne hstage3_box_leaf_flags_done
    inc $60
hstage3_box_leaf_flags_done:

    ; Faithful RTS through the existing table-return convention.
    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

hstage3_box_leaf_cold:
    lda $88
    sta $40
    lda $8A
    sta $42
    jml.l inext
hstage3_box_leaf_end:

; ============================================================================
; Shared hand-exact Stage-3 collision-record emitter for $027B7C/$02F5A2.
;
; Parameters from the fixed bank-$94 wrappers:
;   $80 pointer-field offset, $82 attribute, $84 initial D7.w,
;   $86 byte-source mode (0 = #$80, 1 = $12(A4)),
;   $88/$8A cold PC, $8C nested-BSR return low word.
; ============================================================================
    .org $E900
.a16
.i16
hstage3_collision_leaf:
    rep #$30
    lda $32
    cmp #$00F0
    bne hstage3_collision_guard_fail
    lda $30
    cmp #$3FC9                       ; covers $34(A4) pointer and $12 byte
    bcs hstage3_collision_guard_fail
    lda $34
    bne hstage3_collision_guard_fail
    lda $36
    cmp #$00F0
    bne hstage3_collision_guard_fail
    lda $3E
    cmp #$00F0
    bne hstage3_collision_guard_fail
    lda $3C
    cmp #$0004                       ; room for genuine nested BSR residue
    bcc hstage3_collision_guard_fail
    cmp #$3FFD
    bcs hstage3_collision_guard_fail

    lda $30
    clc
    adc $80
    tax
    lda $400000,x
    xba
    cmp #$00F0
    bne hstage3_collision_guard_fail
    lda $400002,x
    xba
    sta $8E                          ; initial destination A3 low
    cmp #$3FF3                       ; writes through destination +$0D
    bcs hstage3_collision_guard_fail
    bra hstage3_collision_hot

hstage3_collision_guard_fail:
    jmp hstage3_collision_cold

hstage3_collision_hot:
    ; MOVEA / attribute write / MOVE #initial,D7 / BSR comprise four
    ; parent instructions before the nested $296C6 leaf.
    lda #$0004
    jsr esc9_ac_charge

    lda $8E
    sta $2C
    lda #$00F0
    sta $2E                          ; MOVEA.L pointer,A3
    ldx $8E
    lda $82
    xba
    sta $40000A,x
    lda $84
    sta $1C                          ; MOVE.W initial,D7 (high word retained)

    ; BSR/RTS leave their four bytes below the unchanged parent A7.
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$0002
    xba
    sta $400000,x
    lda $8C
    xba
    sta $400002,x

    ; Inline $296C6 while preserving its dynamic three/four-instruction AC
    ; charge and D7 result.  Its flags are overwritten by the parent stores
    ; and all later X observations are replaced by the coordinate ADD.Ws.
    sep #$20
.a8
    lda $40293B
    cmp #$02
    rep #$20
.a16
    bcc hstage3_collision_counter_low
    inc $1C
    lda #$0004
    bra hstage3_collision_counter_charged
hstage3_collision_counter_low:
    lda #$0003
hstage3_collision_counter_charged:
    jsr esc9_ac_charge

    ; The sixteen parent instructions after the nested RTS are invariant.
    lda #$0010
    jsr esc9_ac_charge

    ldx $8E
    lda $1C
    sep #$20
.a8
    sta $40000D,x                    ; MOVE.B D7,$0D(A3)
    rep #$20
.a16
    lda $86
    bne hstage3_collision_source_a4
    lda #$0080
    bra hstage3_collision_source_ready
hstage3_collision_source_a4:
    ldx $30
    sep #$20
.a8
    lda $400012,x
    rep #$20
.a16
    and #$00FF
hstage3_collision_source_ready:
    ldx $8E
    sep #$20
.a8
    sta $40000C,x
    rep #$20
.a16

    lda #$0001
    xba
    sta $400000,x                   ; MOVE.W #1,(A3)+

    ldx $30
    lda $400004,x
    xba
    clc
    adc #$FFF0
    sta $00
    ldx $8E
    xba
    sta $400002,x
    ldx $30
    lda $400004,x
    xba
    clc
    adc #$0010
    sta $00
    ldx $8E
    xba
    sta $400004,x
    ldx $30
    lda $400006,x
    xba
    clc
    adc #$FFF0
    sta $00
    ldx $8E
    xba
    sta $400006,x
    ldx $30
    lda $400006,x
    xba
    clc
    adc #$0010
    sta $00                          ; final architectural D0.w
    lda #$0000
    rol a
    sta $A2                          ; X from the final ADD.W
    lda $00
    ldx $8E
    xba
    sta $400008,x

    lda $8E
    clc
    adc #$0008
    sta $2C                          ; four postincrements leave A3 at +8

    ; Final MOVE.W publishes N/Z, clears V/C, and preserves ADD.W's X.
    lda $00
    and #$8000
    sta $70
    stz $72
    stz $6E
    stz $60
    lda $00
    bne hstage3_collision_flags_done
    inc $60
hstage3_collision_flags_done:

    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

hstage3_collision_cold:
    lda $88
    sta $40
    lda $8A
    sta $42
    jml.l inext
hstage3_collision_leaf_end:

; ============================================================================
; Guarded fast implementation of bank-$00 rdw_ea_l.
;
; JSL callers still enter the fixed $00:E5B2 wrapper, which is now a
; size-neutral JML here.  Canonical non-wrapping $F0 work-RAM words are direct;
; all other addresses retain the original two readbyte_l calls, pointer
; rollover, result flags, and RTL convention.
; ============================================================================
    .org $EB00
.a16
.i16
hrdw_ea_l:
    rep #$30
    lda $52
    cmp #$00F0
    bne hrdw_ea_l_slow
    lda $54
    cmp #$FFFF
    beq hrdw_ea_l_slow
    tax
    lda $400000,x
    xba
    pha
    and #$FF00
    sta $90                          ; match rdw_ea's high-byte scratch
    pla
    inc $54
    ldx $54                          ; match readbyte's final native X
    ; The generic second readbyte compares bank $F0 before its final AND, so
    ; canonical work-RAM reads return with native C=1 and N/Z from the
    ; assembled word.  Generated callers consume those transient native flags
    ; before materializing the emulated CCR; the address INC/LDX above must not
    ; leak their flags instead.
    sec
    ora #$0000
    rtl

hrdw_ea_l_slow:
    jsl.l readbyte_l
    xba
    sta $90
    inc $54
    bne hrdw_ea_l_slow_low
    inc $52
hrdw_ea_l_slow_low:
    jsl.l readbyte_l
    ora $90
    rtl
hrdw_ea_l_end:

