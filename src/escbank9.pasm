; <<< STAGE3_2F542 <<<

; Diagnostic-only gateways for the six Stage-3 player handlers.  The packer
; substitutes this target at precisely the 83 generated block-charge calls
; covered by gen_vtime_esc9_charge_table.py.  A disabled/missing VTIME state
; tail-enters the original instruction-count helper.  A crossed deadline
; discards the generated JSR frame and its preceding PHP before returning to
; the interpreter at the block PC selected by the F2 ledger.
;
; The 83 admitted sites all have ``PHP / REP #$30 / LDA #count / JSR``
; immediately before the logical block.  The packer verifies that shape
; before it is allowed to make this diagnostic-only substitution.
    .org $FFA1
esc9_vtime_charge_gateway:
    rep #$30
    jsl.l VTIME_ESC9_CHARGE
    cmp #$0001
    beq esc9_vtime_charge_due
    cmp #$0002
    beq esc9_vtime_charge_done
    jmp esc9_ac_charge
esc9_vtime_charge_done:
    rts
esc9_vtime_charge_due:
    pla                         ; discard the generated block JSR return
    plp                         ; discard its mandatory saved host flags
    jml.l inext

; Logical JSR exits must commit their just-completed player block before
; entering another translated body or the interpreter.  The source has
; already placed the callee PC in $40:$42, so a deadline boundary resumes at
; that post-JSR architectural point.
esc9_vtime_ojmp_gateway:
    rep #$30
    jsl.l VTIME_ESC9_FINISH
    cmp #$0001
    beq esc9_vtime_handoff_due
    jml.l ojmp_hook
esc9_vtime_ibridge_gateway:
    rep #$30
    jsl.l VTIME_ESC9_FINISH
    cmp #$0001
    beq esc9_vtime_handoff_due
    jml.l ibridge

; The final RTS has already materialized its return PC/A7 in the interpreter
; state before the old ORS tail.  Finish therefore must not replace $40:$42
; on a deadline crossing; it only requests the retained IRQ path.
esc9_vtime_ors_gateway:
    rep #$30
    jsl.l VTIME_ESC9_FINISH
    cmp #$0001
    beq esc9_vtime_handoff_due
    jml.l ors_pre
esc9_vtime_handoff_due:
    jml.l inext
esc9_vtime_gateway_end:

escbank9_end:
