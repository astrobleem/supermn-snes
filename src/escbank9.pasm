    jsr hce4_ac_charge_peek_word
    cmp #$0000
    beq hce4_ac_charge_zero_fallback
    sta $74
    ldy #$0002
    jsr hce4_ac_charge_peek_word
    cmp #$0000
    beq hce4_ac_charge_zero_fallback
    sta $76
    ldy #$0004
    jsr hce4_ac_charge_peek_word
    cmp #$0000
    beq hce4_ac_charge_zero_fallback
    sta $78
    ldy #$0006
