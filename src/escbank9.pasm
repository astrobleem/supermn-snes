; ============================================================================
; CE4 fused clipped 2x2 emitter.
;
; The early $9F:E700 guard has already proved the exact 2x2/capacity-four
; class, retained all four nonzero source words in $74-$7A, and charged the
; original dynamic MC68000 instruction count.  hce4_entry has subsequently
; built the faithful LINK/MOVEM stack image and prepared the three output-plane
; pointers.  Reproduce the arcade's independent signed X-row and Y-column
; clipping decisions, emit the twelve disjoint output words directly, then
; publish the same exhausted-D7 CCR/X state.  No architectural register or
; work-RAM write occurs here before the complete early guard succeeds.
; ============================================================================
    .org $D200
.a16
.i16
hce4_fast_render_2x2:
    rep #$30
    lda $98
    sta $54                          ; tile plane
    lda $94
    sta $58                          ; X plane
    lda $96
    sta $5C                          ; Y/attribute plane
    lda #$0040
    sta $56
    sta $5A
    sta $5E

    ; Arcade-visible X is signed -5..249.  $88 is already
    ; d1=$EA-screenX; its second-row value is d1-$10.
    lda $88
    jsr hce4_fast_clip_x
    sta $64                          ; clipped row 0 X
    lda $88
    sec
    sbc #$0010
    jsr hce4_fast_clip_x
    sta $66                          ; clipped row 1 X

    ; Each column independently substitutes X=$FA when signed Y is outside
    ; -15..383.  Retain all four row/column X combinations before emitting.
    lda #$00FA
    sta $68                          ; row 0, column 0
    sta $6A                          ; row 1, column 0
    lda $8A
    jsr hce4_fast_y_visible
    bcc hce4_fast_y0_ready
    lda $64
    sta $68
    lda $66
    sta $6A
hce4_fast_y0_ready:

    lda $8A
    clc
    adc #$0010
    sta $82                          ; second column Y
    lda #$00FA
    sta $6C                          ; row 0, column 1
    sta $80                          ; row 1, column 1
    lda $82
    jsr hce4_fast_y_visible
    bcc hce4_fast_y1_ready
    lda $64
    sta $6C
    lda $66
    sta $80
hce4_fast_y1_ready:
    ldy #$0000

    ; Row 0, column 0.
    lda $74
    clc
    adc #$2000
    xba
    sta [$54],y
    lda $68
    xba
    sta [$58],y
    lda $8A
    and #$01FF
    ora $90
    xba
    sta [$5C],y
    iny
    iny

    ; Row 0, column 1.
    lda $76
    clc
    adc #$2000
    xba
    sta [$54],y
    lda $6C
    xba
    sta [$58],y
    lda $82
    and #$01FF
    ora $90
    xba
    sta [$5C],y
    iny
    iny

    ; Row 1, column 0.
    lda $78
    clc
    adc #$2000
    xba
    sta [$54],y
    lda $6A
    xba
    sta [$58],y
    lda $8A
    and #$01FF
    ora $90
    xba
    sta [$5C],y
    iny
    iny

    ; Row 1, column 1.
    lda $7A
    clc
    adc #$2000
    xba
    sta [$54],y
    lda $80
    xba
    sta [$58],y
    lda $82
    and #$01FF
    ora $90
    xba
    sta [$5C],y

    lda #$FFFF
    sta $92                          ; d7.w exhausted after the fourth tile
    lda #$0001
    sta $70                          ; N
    sta $6E                          ; C/borrow
    sta $A2                          ; X
    stz $60                          ; Z
    stz $72                          ; V
    rtl

; A=raw signed row X.  Return arcade-clipped X in A without touching emulated
; state; transformed unsigned comparisons implement signed >=250 and >=-5.
hce4_fast_clip_x:
    sta $84
    eor #$8000
    cmp #$80FA
    bcs hce4_fast_clip_x_hidden
    cmp #$7FFB
    bcc hce4_fast_clip_x_hidden
    lda $84
    rts
hce4_fast_clip_x_hidden:
    lda #$00FA
    rts

; A=raw signed column Y.  Return carry set exactly for -15..383.
hce4_fast_y_visible:
    eor #$8000
    cmp #$7FF1
    bcc hce4_fast_y_hidden
    cmp #$8180
    bcs hce4_fast_y_hidden
    sec
    rts
hce4_fast_y_hidden:
    clc
    rts
hce4_fast_render_2x2_end:

; Count the original dynamic $000CE4 path for a proven nonzero 2x2 stream.
; The first LINK fetch is charged by the fetch loop.  This helper accounts for
; every remaining instruction, including the asymmetric signed clipping
; branches, the three nonterminal inner tails, the first-row outer tail, and
; the four-instruction epilogue.
    .org $D300
.a16
.i16
hce4_charge_2x2_dynamic:
    rep #$30
    lda #$0011                       ; prologue through initial SUB.W
    sta $AE

    lda #$00EA                       ; row 0 d1
    sec
    sbc $88
    jsr hce4_charge_2x2_x
    lda #$0003                       ; d2/d3 setup
    jsr hce4_charge_2x2_add
    lda $8A
    jsr hce4_charge_2x2_y
    lda #$0002                       ; first inner tail
    jsr hce4_charge_2x2_add
    lda $8A
    clc
    adc #$0010
    jsr hce4_charge_2x2_y
    lda #$0004                       ; second inner + first outer tail
    jsr hce4_charge_2x2_add

    lda #$00DA                       ; row 1 d1 = $EA-screenX-$10
    sec
    sbc $88
    jsr hce4_charge_2x2_x
    lda #$0003
    jsr hce4_charge_2x2_add
    lda $8A
    jsr hce4_charge_2x2_y
    lda #$0002                       ; third inner tail
    jsr hce4_charge_2x2_add
    lda $8A
    clc
    adc #$0010
    jsr hce4_charge_2x2_y
    lda #$0004                       ; MOVEM/MOVEM/UNLK/RTS
    jsr hce4_charge_2x2_add

    lda $AE
    jsr esc9_ac_charge
    rts

; Add the row-X clip path: three instructions when d1>=250, five when d1<=-6,
; and six for the visible -5..249 interval.
hce4_charge_2x2_x:
    eor #$8000
    cmp #$80FA
    bcs hce4_charge_2x2_x_three
    cmp #$7FFB
    bcc hce4_charge_2x2_x_five
    lda #$0006
    jmp hce4_charge_2x2_add
hce4_charge_2x2_x_five:
    lda #$0005
    jmp hce4_charge_2x2_add
hce4_charge_2x2_x_three:
    lda #$0003
    jmp hce4_charge_2x2_add

; Add the complete live-tile path: 14 instructions below -15, 15 through
; signed Y=383, and 16 at/above 384.
hce4_charge_2x2_y:
    eor #$8000
    cmp #$7FF1
    bcc hce4_charge_2x2_y_low
    cmp #$8180
    bcs hce4_charge_2x2_y_high
    lda #$000F
    jmp hce4_charge_2x2_add
hce4_charge_2x2_y_low:
    lda #$000E
    jmp hce4_charge_2x2_add
hce4_charge_2x2_y_high:
    lda #$0010
hce4_charge_2x2_add:
    clc
    adc $AE
    sta $AE
    rts
hce4_charge_2x2_dynamic_end:

; ============================================================================
; Guarded Stage-3 immutable 3x7 panel renderer.
;
; Organic Stage-3 capture repeatedly reaches CE4 with source $042AEA or
; $042B18, cursor $01DE, attribute $0800, X=$60, Y=$10, and capacity 19.
; The authenticated ROM sources share fourteen live cells and seven holes;
; only their first row's tile numbers differ.  Bank $9D enters here before
; its dynamic 2x2 admission.  Every guard completes before changing scratch
; or architectural state.  On a miss, recreate the displaced LDA $84 /
; CMP #1 and return to $9D:E446 with its flags live.
;
; On a hit, emit the exact fourteen tile/X/Y words, fill the five remaining
; X slots with $FA, and publish the original exhausted D7/CCR/X result.  The
; bank-$94 caller's JSL return remains on the native stack throughout.
; ============================================================================
    .org $D400
.a16
.i16
hce4_stage3_panel_try:
    rep #$30
    lda $82
    cmp #$00C5
    bne hce4_stage3_panel_guard_fail
    lda $84
    cmp #$0002
    bne hce4_stage3_panel_guard_fail
    lda $86
    cmp #$0006
    bne hce4_stage3_panel_guard_fail
    lda $92
    cmp #$0012
    bne hce4_stage3_panel_guard_fail
    lda $9A
    cmp #$01DE
    bne hce4_stage3_panel_guard_fail
    lda $90
    cmp #$0800
    bne hce4_stage3_panel_guard_fail
    lda $88
    cmp #$008A                       ; d1 = $EA - screen X $60
    bne hce4_stage3_panel_guard_fail
    lda $8A
    cmp #$0010
    bne hce4_stage3_panel_guard_fail
    lda $94
    cmp #$1ED4
    bne hce4_stage3_panel_guard_fail
    lda $96
    cmp #$22D0
    bne hce4_stage3_panel_guard_fail
    lda $98
    cmp #$26CC
    bne hce4_stage3_panel_guard_fail

    ; Source has advanced past the two-word header.  Select the variant only
    ; after every other guard has succeeded.
    lda $80
    cmp #$2AEE                       ; source $042AEA + 4
    beq hce4_stage3_panel_variant_a
    cmp #$2B1C                       ; source $042B18 + 4
    bne hce4_stage3_panel_guard_fail
    lda #$0001
    sta $6A
    bra hce4_stage3_panel_render
hce4_stage3_panel_guard_fail:
    jmp hce4_stage3_panel_miss
hce4_stage3_panel_variant_a:
    stz $6A

hce4_stage3_panel_render:
    lda $98
    sta $54                          ; tile plane
    lda $94
    sta $58                          ; X plane
    lda $96
    sta $5C                          ; Y/attribute plane
    lda #$0040
    sta $56
    sta $5A
    sta $5E
    ldy #$0000

    ; Row 0: hole, five variant tiles, hole.
    lda #$008A
    sta $68
    lda $6A
    beq hce4_stage3_panel_row0_a
    lda #$21CD
    ldx #$0020
    jsr hce4_stage3_panel_emit
    lda #$21CE
    ldx #$0030
    jsr hce4_stage3_panel_emit
    lda #$21CF
    ldx #$0040
    jsr hce4_stage3_panel_emit
    lda #$21D0
    ldx #$0050
    jsr hce4_stage3_panel_emit
    lda #$21C3
    ldx #$0060
    jsr hce4_stage3_panel_emit
    bra hce4_stage3_panel_row1
hce4_stage3_panel_row0_a:
    lda #$21BF
    ldx #$0020
    jsr hce4_stage3_panel_emit
    lda #$21C0
    ldx #$0030
    jsr hce4_stage3_panel_emit
    lda #$21C1
    ldx #$0040
    jsr hce4_stage3_panel_emit
    lda #$21C2
    ldx #$0050
    jsr hce4_stage3_panel_emit
    lda #$21C3
    ldx #$0060
    jsr hce4_stage3_panel_emit

    ; Row 1: six tiles followed by one hole.
hce4_stage3_panel_row1:
    lda #$007A
    sta $68
    lda #$21C4
    ldx #$0010
    jsr hce4_stage3_panel_emit
    lda #$21C5
    ldx #$0020
    jsr hce4_stage3_panel_emit
    lda #$21C6
    ldx #$0030
    jsr hce4_stage3_panel_emit
    lda #$21C7
    ldx #$0040
    jsr hce4_stage3_panel_emit
    lda #$21C8
    ldx #$0050
    jsr hce4_stage3_panel_emit
    lda #$21C9
    ldx #$0060
    jsr hce4_stage3_panel_emit

    ; Row 2: hole, three tiles, then three holes.
    lda #$006A
    sta $68
    lda #$21CA
    ldx #$0020
    jsr hce4_stage3_panel_emit
    lda #$21CB
    ldx #$0030
    jsr hce4_stage3_panel_emit
    lda #$21CC
    ldx #$0040
    jsr hce4_stage3_panel_emit

    ; Fourteen live sprites leave five capacity slots.  The arcade fill loop
    ; writes only the X plane for those slots.
    lda #$00FA
    xba
    ldx #$0004
hce4_stage3_panel_fill:
    sta [$58],y
    iny
    iny
    dex
    bpl hce4_stage3_panel_fill

    lda #$FFFF
    sta $92
    stz $70
    stz $60
    stz $72
    stz $6E
    stz $A2
    sec
    rtl

; A=tile+$2000, native X=visible column Y, $68=visible row X.
hce4_stage3_panel_emit:
    xba
    sta [$54],y
    lda $68
    xba
    sta [$58],y
    txa
    and #$01FF
    ora $90
    xba
    sta [$5C],y
    iny
    iny
    rts

hce4_stage3_panel_miss:
    lda $84
    cmp #$0001
    jml.l $9DE446
hce4_stage3_panel_end:

