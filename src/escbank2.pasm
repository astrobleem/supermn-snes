.snes
; escbank2.pasm — SECOND SA-1 escape bank at $94:8000 (file $2A0000). For native escapes too big for
; the $92 bodies region (which overflowed past $F000 into jah2_ext; see escbank-overflow-second-bank).
; Reached from $92 dispatchers (entry_4542 bridge, jah2_ext slot, ojmp_disp, ...) via `jml entry_X`
; (24-bit cross-bank; escbank2's entry_X syms are fed into escbank.pasm by gen_escbank_syms.py).
; Bodies are --bank2 transpiled: bank-$00 helpers via jsl.l/jml.l; jsr(An) inlined w/ a $00FD sentinel
; (ors_pre -> ors_94chk -> bank-$94 resume). The leading `.snes` is REQUIRED (rep/sep tracking).

; >>> ESCBANK2_SYMS — auto-generated by tools/gen_escbank2_syms.py (do not edit) <<<
inext=$00D128
ce4_leaf=$00E8A2
rdw40_l=$00E59E
wrw40_l=$00E5A2
rdb40_l=$00E5A6
wrb40_l=$00E5AA
push32_l=$00E5AE
rdw_ea_l=$00E5B2
readbyte_l=$00E5B6
writeword_l=$00E5BA
writebyte_l=$00E5BE
usmul_l=$00E5C2
op_rts_sentinel=$00EA3A
ojmp_hook=$00D1B3
ors_pre=$00D16F
; <<< ESCBANK2_SYMS <<<
entry_d232=$99EB00   ; pt.22 P3b: --bank5 $99 body, .org-fixed (no $94->$99 const auto-gen; hand const)
hce4_shape_try=$95F400 ; guarded immutable-shape renderer in bank $95

    .org $8000

; esc_udiv — bank-$94 LOCAL unsigned 32/16 division for transpiled DIVU.w (a same-bank `jsr esc_udiv`;
; do NOT name it `udiv` -- collides with interp.pasm's bank-$00 udiv). in: dividend $50(lo):$52(hi) /
; divisor $54 -> quot $50:$52, rem $94.
esc_udiv:
    rep #$30             ; Poppy: assert 16-bit M/X here (this routine is jsr'd standalone, so the
                         ; caller's rep #$30 isn't tracked -> `ldy #$0020` would mis-size to 2 bytes)
    stz $94
    ldy #$0020
esud_l:
    asl $50
    rol $52
    rol $94
    bcs esud_sub
    lda $94
    cmp $54
    bcc esud_no
esud_sub:
    lda $94
    sec
    sbc $54
    sta $94
    inc $50
esud_no:
    dey
    bne esud_l
    rts

; esc_ac_charge — TASK #73 frame-pacing fix. The vblank-IRQ frame boundary fires when $AC (the per-
; frame interp-step countdown, interp.pasm reload=$7000) hits EXACTLY 0 via the main loop's `dec $AC`.
; An escape is ONE step but does N 68K instrs, so it must charge $AC by N (the main loop only takes 1).
; in: A = N (16-bit, instr count to charge). Decrements $AC by N; CLAMPS to 1 on underflow/zero so the
; next main-loop `dec` fires the boundary cleanly (never fires VID_FRAME mid-escape). Uses the stack for
; scratch (no DP clobber); clobbers A, preserves X/Y. Off-by-<=1-escape/frame timing error = negligible.
esc_ac_charge:
    rep #$30
    pha                  ; [16-bit N on stack]
    lda $AC
    sec
    sbc $01,s            ; $AC - N
    bcc eacc_clamp       ; borrow -> $AC < N -> underflow
    beq eacc_clamp       ; == 0 -> clamp (boundary needs the main-loop dec to reach 0)
    sta $AC
    pla
    rts
eacc_clamp:
    lda #$0001
    sta $AC
    pla
    rts

