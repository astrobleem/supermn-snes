; ============================================================================
; hle_12b6c — HAND-WRITTEN HLE of the $012B6C dispatcher tree (HLE SPIKE; see
; MAIN_PLANNING_HANDOFF.md). Fixed .org $E000 so interp.pasm's bhp_bank_ext can `jml $94E000`
; without symbol plumbing. Entry (from bhp_bank_ext): the `bsr $12b6c` was consumed, NO return
; pushed; $40/$42 = return $01177C; DP reg file live; 16-bit M/X.
; SEMANTICS (68K, capstone-verified):
;   $12B6C: d7.w = w(a6-$72); ==0 -> $12B84; (d7.w &= 3) != 0 -> $12B84; else -> $12C04
;   $12B84: a2 = *(long)(a3 + sext w(a6-$18)) [ROM sprite-frame table]; d1.w = w(a4+2)-$20;
;           d0.w = w(a4+4)-$20; a1 = [$1c8a(a5)] (=$0CE4); if bit7((a4)): d0.w = w(a4+4)-$40,
;           a1 = [$1c8e(a5)] (=$0D96); d2 = $800/$1000 (w(a6-$50)); blink-counter sub-path if
;           w(a6-$68)!=0 (BAILED here: RMW + X-flag semantics, rare); push #$12, a2.l, d0, d1,
;           d2, w(a6-$58); jsr (a1)
;   $12C04: a1 = [$1c9a(a5)] (=$0FB8); push #$12, w(a6-$58); jsr (a1)
; STRATEGY: do the dispatcher + ALL marshalling natively (incl. the two bsr return-push longs so
; the stack residue is byte-identical to the interpreted run), then hand the interp the PC OF THE
; `jsr (a1)` INSTRUCTION itself -> the callee dispatches via jah2/interp exactly as baseline
; (bit-exact by construction; the 3-instr interpreted tail adda/rts/rts pops our pushed returns).
; CCR at handoff: the last 68K flag-setter before the jsr is `move.w -$58(a6),-(a7)` on every
; non-bailed path -> N/Z from that word, V=C=0; X = carry of the last `addi` to d0 (path B only).
; Scratch: $80-$8C (transient, allowed). BAILS re-simulate `bsr $12b6c` faithfully (push ret1,
; PC=$2B6C, inext) BEFORE any memory write -> idempotent.
; ============================================================================
    .org $E000
hle_12b6c:
    rep #$30
    ; ---- $12B6C dispatcher: d7.w = w(a6-$72) ----
    lda $38
    clc
    adc #$FF8E           ; a6-$72
    tax
    lda $400000,x
    xba                  ; BE word
    sta $1C              ; d7.w (move.w writes low word only)
    and #$FFFF           ; N/Z from the 16-bit value (xba only set 8-bit flags)
    beq hle_pB           ; d7==0 -> $12B84 (skips the andi)
    and #$0003
    sta $1C              ; andi.w #3,d7
    bne hle_pB
    jmp hle_pC

hle_bail:                ; rare path -> re-simulate `bsr $12b6c`, interp runs the tree faithfully
    lda #$177C
    sta $54
    lda #$0001
    sta $56
    jsl.l push32_l       ; push ret1 = $0001177C
    lda #$2B6C
    sta $40
    lda #$0001
    sta $42
    jml.l inext

hle_pB:                  ; ---- $12B84 marshalling ----
    ; a2 = *(long)(a3 + sext w(a6-$18)) — a3 points into ROM (sprite-frame table)
    lda $38
    clc
    adc #$FFE8           ; a6-$18
    tax
    lda $400000,x
    xba
    tay                  ; Y = w18
    and #$8000
    beq hle_pB_pos
    lda #$FFFF
    bra hle_pB_ext
hle_pB_pos:
    lda #$0000
hle_pB_ext:
    sta $86              ; sign extension
    tya
    clc
    adc $2C              ; + a3 lo16
    sta $80              ; table-entry addr lo16
    lda $86
    adc $2E              ; + a3 hi16
    sta $82              ; table-entry addr hi16
    cmp #$0008           ; 68K ROM = $000000-$07FFFF; anything else -> bail (never seen)
    bcc hle_pB_rom
    jmp hle_bail
hle_pB_rom:
    clc
    adc #$00C1           ; 68K ROM byte X lives at SA-1 $C1:0000+X (readbyte's rb_rom mapping)
    sep #$20
    sta $82              ; [$80] 24-bit ptr = lo16 @ $80/$81, bank @ $82
    ldy #$0000
    lda [$80],y          ; a2 bits 31-24 (BE)
    xba
    iny
    lda [$80],y          ; bits 23-16
    rep #$20
    sta $2A              ; a2 hi16
    sep #$20
    iny
    lda [$80],y          ; bits 15-8
    xba
    iny
    lda [$80],y          ; bits 7-0
    rep #$20
    sta $28              ; a2 lo16
    ; d1.w = w(a4+2) + $FFE0
    lda $30
    clc
    adc #$0002
    tax
    lda $400000,x
    xba
    clc
    adc #$FFE0
    sta $04              ; d1.w
    ; d0.w = w(a4+4) + $FFE0 ; X flag = the addi's carry (last X-setter before the jsr)
    lda $30
    clc
    adc #$0004
    tax
    lda $400000,x
    xba
    clc
    adc #$FFE0
    sta $00              ; d0.w
    lda #$0000
    rol a                ; A = carry
    sta $A2              ; X flag var
    ; btst #7,(a4) -> flipped-sprite variant (d0 -$40, a1 = $1c8e(a5) = $0D96)
    ldx $30
    sep #$20
    lda $400000,x        ; byte (a4)
    and #$80
    rep #$20
    bne hle_pB_alt
    ; a1 = long [$1c8a(a5)] (= $0CE4)
    lda $34
    clc
    adc #$1C8A
    tax
    lda $400000,x
    xba
    sta $26              ; a1 hi16
    inx
    inx
    lda $400000,x
    xba
    sta $24              ; a1 lo16
    bra hle_pB_d2
hle_pB_alt:
    lda $30
    clc
    adc #$0004
    tax
    lda $400000,x
    xba
    clc
    adc #$FFC0           ; d0.w = w(a4+4) - $40
    sta $00
    lda #$0000
    rol a
    sta $A2              ; X = this addi's carry (it is now the last X-setter)
    lda $34
    clc
    adc #$1C8E
    tax
    lda $400000,x
    xba
    sta $26
    inx
    inx
    lda $400000,x
    xba
    sta $24              ; a1 = [$1c8e(a5)] (= $0D96)
hle_pB_d2:
    ; d2 = $800; if w(a6-$50)!=0 -> $1000
    lda $38
    clc
    adc #$FFB0           ; a6-$50
    tax
    lda $400000,x
    xba
    and #$FFFF
    beq hle_pB_d2a
    lda #$1000
    bra hle_pB_d2s
hle_pB_d2a:
    lda #$0800
hle_pB_d2s:
    sta $08              ; d2.w
    ; blink-counter sub-path (w(a6-$68)!=0): addq/cmpi/subq/clr RMW + X flags -> bail (rare)
    lda $38
    clc
    adc #$FF98           ; a6-$68
    tax
    lda $400000,x
    xba
    and #$FFFF
    beq hle_pB_stk
    jmp hle_bail
hle_pB_stk:
    ; w(a6-$58) -> $88 (pushed last; also the CCR N/Z source at the jsr)
    lda $38
    clc
    adc #$FFA8           ; a6-$58
    tax
    lda $400000,x
    xba
    sta $88
    ; ---- stack image (byte-identical to the interpreted run) ----
    ; [a7-4]=ret1 $0001177C  [a7-8]=ret2 $00012B82  [a7-10]=$0012  [a7-14]=a2.l
    ; [a7-16]=d0  [a7-18]=d1  [a7-20]=d2  [a7-22]=w58 ; then a7 -= 22
    lda $3C
    sec
    sbc #$0016
    sta $8A              ; new a7 lo16
    lda $3E
    sbc #$0000
    sta $8C              ; new a7 hi16
    ldx $8A
    lda $88
    xba
    sta $400000,x        ; [a7-22] = w58 (BE)
    inx
    inx
    lda $08
    xba
    sta $400000,x        ; [a7-20] = d2
    inx
    inx
    lda $04
    xba
    sta $400000,x        ; [a7-18] = d1
    inx
    inx
    lda $00
    xba
    sta $400000,x        ; [a7-16] = d0
    inx
    inx
    lda $2A
    xba
    sta $400000,x        ; [a7-14] = a2 hi16
    inx
    inx
    lda $28
    xba
    sta $400000,x        ; [a7-12] = a2 lo16
    inx
    inx
    lda #$1200
    sta $400000,x        ; [a7-10] = $0012 (BE bytes 00 12)
    inx
    inx
    lda #$0100
    sta $400000,x        ; [a7-8] = $0001 (ret2 hi = bsr $12b84's push)
    inx
    inx
    lda #$822B
    sta $400000,x        ; [a7-6] = $2B82 (ret2 lo)
    inx
    inx
    lda #$0100
    sta $400000,x        ; [a7-4] = $0001 (ret1 hi = bsr $12b6c's push)
    inx
    inx
    lda #$7C17
    sta $400000,x        ; [a7-2] = $177C (ret1 lo)
    ; ---- CCR at the jsr: N/Z from w58 (move.w -$58(a6),-(a7)); V=0 C=0; X set above ----
    lda $88
    and #$8000
    sta $70              ; N
    stz $72              ; V
    stz $6E              ; C
    stz $60
    lda $88
    bne hle_pB_ccr
    inc $60              ; Z
hle_pB_ccr:
    ; ---- v2: a1 == $0CE4 -> skip the interp `jsr (a1)` dispatch and jump DIRECTLY to the
    ; hand-native bank-$00 leaf entry_ce4 (the SAME body the jah2 path dispatches -> identical
    ; behavior + stack residue). Leaf convention: args at [a7] (no return push), $40/$42 preset
    ; to the return $012BFC; it ends `jmp inext` -> the interp resumes at the adda/rts/rts tail.
    ; (Tried + REJECTED: sentinel-return through the transpiled entry_ce4t to also absorb the
    ; tail natively -- ce4t is ~15K cyc SLOWER than this leaf; the 3 tail instrs cost only ~8K.
    ; Measured: v1 jsr-handoff 37,845 / ce4t-sentinel 41,457 / this 35K-class. See handoff doc.)
    ; Other callees (the $0D96 flipped-sprite variant) -> v1 handoff (jah2 dispatches as baseline).
    lda $26
    bne hle_pB_go
    lda $24
    cmp #$0CE4
    bne hle_pB_go
    lda $8A
    sta $3C
    lda $8C
    sta $3E              ; a7 -= 22 (args at [a7])
    lda #$2BFC
    sta $40              ; return preset (leaf ends `jmp inext`)
    lda #$0001
    sta $42
    jml.l ce4_leaf
hle_pB_go:
    lda $8A
    sta $3C
    lda $8C
    sta $3E              ; a7 -= 22
    lda #$2BFA           ; hand off AT the `jsr (a1)` -> jah2 dispatches the callee as baseline
    sta $40
    lda #$0001
    sta $42
    jml.l inext

hle_pC:                  ; ---- $12C04 marshalling ----
    ; a1 = long [$1c9a(a5)] (= $0FB8)
    lda $34
    clc
    adc #$1C9A
    tax
    lda $400000,x
    xba
    sta $26
    inx
    inx
    lda $400000,x
    xba
    sta $24
    ; w(a6-$58) -> $88
    lda $38
    clc
    adc #$FFA8
    tax
    lda $400000,x
    xba
    sta $88
    ; stack: [a7-4]=ret1 $0001177C  [a7-8]=ret2 $00012B7C  [a7-10]=$0012  [a7-12]=w58 ; a7 -= 12
    lda $3C
    sec
    sbc #$000C
    sta $8A
    lda $3E
    sbc #$0000
    sta $8C
    ldx $8A
    lda $88
    xba
    sta $400000,x        ; [a7-12] = w58
    inx
    inx
    lda #$1200
    sta $400000,x        ; [a7-10] = $0012
    inx
    inx
    lda #$0100
    sta $400000,x        ; [a7-8] = $0001 (ret2 hi = bsr $12c04's push)
    inx
    inx
    lda #$7C2B
    sta $400000,x        ; [a7-6] = $2B7C (ret2 lo)
    inx
    inx
    lda #$0100
    sta $400000,x        ; [a7-4] = $0001 (ret1 hi)
    inx
    inx
    lda #$7C17
    sta $400000,x        ; [a7-2] = $177C (ret1 lo)
    lda $8A
    sta $3C
    lda $8C
    sta $3E              ; a7 -= 12
    ; CCR: N/Z from w58; V=0 C=0; X untouched (no addi on this path)
    lda $88
    and #$8000
    sta $70
    stz $72
    stz $6E
    stz $60
    lda $88
    bne hle_pC_go
    inc $60
hle_pC_go:
    lda #$2C10           ; the `jsr (a1)` in $12C04
    sta $40
    lda #$0001
    sta $42
    jml.l inext

; >>> ESCBANK2_BODIES_END — new escbank2 bodies inserted before this line <<<

; ============================================================================
; xlat_dispatch — the AOT address-translation indirection ($94:F900).
; in: $40 = 68K PC lo16, $42 = PC bank, 16-bit A/X/Y. ojmp_hook (bank $00) jml's here after its
; gate check. Looks the PC up in the 2-level page table at $96:8000 (file $2B0000, built by
; tools/gen_xlat_table.py). HIT -> jml [native entry]; MISS -> jml inext (interpret as today).
; This replaces ojmp_hook's hardcoded cmp-chain AND escbank's ojmp_disp re-scan with one lookup.
; Banks $00 AND $01 (512-page layout, index = (bank<<8)|(PC>>8)); $42>=2 -> miss. Bank-$01 pages
; carry the objproc coroutine resume PCs (docs/OBJPROC_SPEC.md); reached via ors_rte_x->ojmp_hook.
; ============================================================================
.org $F900
xlat_dispatch:
    ; CRITICAL scratch rule: the MISS path falls through to `jml inext`, and inext reads the interp
    ; 32-bit step counter $4A/$4C and stop marker $4E (`lda $4A; inc; ...; cmp $4C #$0800; bcs docap`).
    ; The old code used $4A/$4C/$4E as table-lookup scratch, so EVERY table miss corrupted the counter
    ; -- and any page whose sub-table offset >= $0800 (e.g. d5c4@$0800) tripped the cap -> docap halt
    ; -> the game diverged/ran away whenever escapes were enabled (escapes-on lockstep RED, off GREEN).
    ; Fix: use $96/$98 (escape-transient DP, dead on the miss path) and preserve X across the miss.
    rep #$30
    phx                      ; preserve X (interp decode state) for the miss path
    lda $42
    cmp #$0002
    bcs xd_miss              ; bank >= 2 -> not in this table (banks 0 AND 1 supported, 512 pages)
    xba                      ; A = bank<<8 ($0000 / $0100)
    sta $96                  ; page-index bank bit (escape-transient scratch, dead on miss)
    lda $40                  ; PC lo16
    xba                      ; low byte now = PC>>8
    and #$00FF
    ora $96                  ; | bank<<8 -> 9-bit page index (gen_xlat_table 512-page layout)
    asl a                    ; *2 (2-byte page pointers)
    tax
    lda $968000,x            ; page[(bank<<8)|(PC>>8)] = sub-table byte-offset (0 = none in page)
    beq xd_miss
    sta $96                  ; save sub-table offset (was $4C = step-counter hi)
    lda $40
    and #$00FF               ; PC low byte (entry index)
    sta $98                  ; (was $4E = stop marker)
    asl a                    ; *2
    clc
    adc $98                  ; + *1 = *3 (3-byte entries)
    clc
    adc $96                  ; + sub-table offset = blob offset of the entry
    tax
    lda $968002,x            ; native addr bank (high byte; ignore the mid byte overlap)
    and #$00FF
    sta $96                  ; native bank (was $4A = step-counter lo)
    lda $968000,x            ; native addr lo16
    bne xd_hit               ; lo16!=0 -> live entry (real entries are $8000+)
xd_miss:
    plx                      ; restore X
    jml.l inext
xd_hit:                      ; dispatch via push+RTL (avoids the Poppy-mis-sized jml [abs]).
    plx                      ; discard the preserved X (balance the stack before push+rtl)
    dec a                    ; A = native lo16 - 1 (RTL adds 1 to the pulled 16-bit PC)
    tax                      ; stash lo16-1
    sep #$20
    lda $96                  ; native bank
    pha                      ; push PBR FIRST (highest stack addr; RTL pulls it last)
    rep #$30
    txa
    pha                      ; push PCH:PCL (native lo16 - 1)
    rtl                      ; -> native bank:lo16

; xlat_choke — FETCH-CHOKEPOINT (interp lh_off does `jml $94F980` per genuinely-interpreted fetch).
; Routes the about-to-be-decoded 68K PC through the AOT table so rts/branch-reached escapes (e.g.
; $CE4/entry_ce4t) dispatch REGARDLESS of reach (the coroutine scheduler's rts-chain bypasses
; op_rts_norm, so those reaches never hit ojmp_hook/xlat otherwise). Matches ilog's contract exactly
; (rep #$30, preserves X = decoder state, clobbers A+flags) so nolog's entry contract is UNCHANGED.
; HIT is guaranteed (the PC is in the table) so `jml xlat_dispatch` can't fall to its inext-miss ->
; no refetch loop. MISS/gated-off/non-match -> `jml nolog` ($00:8102) to decode the fetched opcode.
; PoC scope: ce4 only (`cmp #$0CE4`; flip to #$FFFF for the pure-swap-overhead measurement).
.org $F980
xlat_choke:
    rep #$30
    lda $073A            ; DEDICATED chokepoint gate (free IRAM flag; harness sets it). Independent
    beq xc_dec           ; of $071A -> A/B ce4-native-dispatch on the GREEN ESC=0 baseline, isolating
                         ; the chokepoint from the ESC=1 escapes (which have a separate DIFF=105 bug).
    lda $42
    bne xc_dec           ; PC bank != 0 -> not a bank-0 table PC
    lda $40
    cmp #$0CE4           ; PoC: ce4 only -> guaranteed table HIT (no xlat miss-loop)
    bne xc_dec
    lda $407FE0          ; DIAG counter (safe scratch $40:7FE0): count real ce4 dispatches
    inc a
    sta $407FE0
    jml xlat_dispatch    ; $94F900 (guaranteed HIT -> push+RTL dispatches entry_ce4t, bit-exact)
xc_dec:
    jml $008102          ; nolog: decode the already-fetched opcode (bank $00)
