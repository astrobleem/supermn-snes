; <<< ESCBANK8_BODIES <<<

; =============================================================================
; Production renderer manifest builder.
;
; The 5A22 used to spend roughly 90K of its scarce cycles comparing the full
; palette/background planes, then scan all 512 arcade OBJ slots.  This helper
; runs at the real $0818 boundary, in SA-1 time that was otherwise spent in
; WAI, and publishes an exact compact manifest before lh_0818_paced arms NMI.
;
; A candidate is compared with the last candidate the 5A22 actually accepted,
; not merely the previous game tick.  If rendering is busy and an NMI drops a
; snapshot, $41:0134 does not advance, the baseline stays put, and the next
; manifest therefore remains cumulative relative to the visible image.
;
; Shared metadata:
;   $41:0132 candidate sequence (producer)
;   $41:0134 accepted sequence (5A22, after all snapshot DMA completes)
;   $41:0136 baseline sequence (producer-private promotion marker)
;   $41:0138 packed visible-OBJ byte length with bit 15 set (0..$0300 payload)
;   $41:013A BG-diff-list byte length (0..$0400, $FFFF = full rebuild)
;   $41:013C palette changed in bit 0; bit 15 marks title text moved to BG2
;   $41:013E cumulative palette-write dirty flag
;   $41:0140 cumulative BG-write dirty flag
;   $41:0142 candidate contains a promotable BG image (0/1)
;   $41:0146 producer-prepared unique-code byte length
;   $41:014A $C0BC prepared-image provenance ($C0BC or zero)
;   $41:014C cumulative producer BG-list status (0 empty, 1 exact, $FFFF unknown)
;   $41:014E cumulative producer BG-list byte length (0..$0400)
;   $41:0150 title-text overlay flag after BG-preparation scratch is finished
;   $41:015A currently displayed prepared-source kind ($C0BC or zero)
;
; Private shared workspace (outside the arcade shadow at $41:2000+):
;   $41:0200/$0600  accepted BG code/color baseline
;   $41:0A00/$0E00  candidate BG code/color
;   $41:1200         cumulative producer-touched BG offsets (max 512 words)
;   $41:1600         packed visible OBJ records (Y/code/X, max 128 x 6 bytes)
;   $41:1A00         changed BG cell byte offsets (max 512 words)
;   $41:8000         prepared 4 KiB SNES tilemap
;   $41:9000         prepared sorted unique 14-bit BG code list (max 192 words)
;   $41:9200         prepared arcade-bank -> SNES BG palette-slot table
; =============================================================================
.org $DC00
.a16
.i16
render_manifest_build:
    php
    rep #$30
    pha
    phx
    phy
    phb

    ; STA absolute,Y has no long-address form on 65816.  The compact lists and
    ; reconciliation helpers therefore depend on DBR=$41.  Establish it
    ; explicitly even when a clean candidate performs no MVN; without this,
    ; list entries can land in bank $00 while their published lengths advance.
    sep #$20
.a8
    lda #$41
    pha
    plb
    rep #$20
.a16

    ; Reconcile the previous complete candidate with the accepted baseline.
    ; A rendered candidate promotes only its changed cells when the retained
    ; compact list is small.  A dropped candidate is reverted before reuse so
    ; the new scan may leave every unchanged candidate cell untouched.
    jsr rmb_bg_reconcile
rmb_no_promote:

    ; Reserve zero for "no candidate" so cold initialization is unambiguous.
    lda $410132
    inc a
    bne rmb_sequence_ready
    inc a
rmb_sequence_ready:
    sta $410132
    stz $0146            ; no prepared representation unless this candidate builds one

    ; Producer-side write routing already identified whether the palette may
    ; have changed.  False positives only rebuild colors; no write can be lost
    ; because NMI clears the cumulative flag only after accepting this image.
    lda $41013E
    and #$0001
    sta $41013C

rmb_bg_select:
    ; Keep the packed manifest island fixed.  The out-of-line selector consumes
    ; an exact cumulative producer list when one exists and re-enters the old
    ; full-scan path for every unknown writer or first-image case.
    jml.l $9EE280
    nop
    nop
rmb_bg_dirty_default:
    lda #$0001
    sta $410142
    lda $410136
    beq rmb_bg_first

    ; Build a unique list of cells whose code or color differs from the last
    ; accepted image.  rmb_bg_reconcile established candidate==baseline, so
    ; only changed cells need shared-BW-RAM stores while the candidate remains
    ; complete for the renderer and for a later accepted-image promotion.
rmb_bg_full_scan:
    ldx #$0000
    ldy #$0000
rmb_bg_compare:
    lda $414800,x
    cmp $410200,x
    bne rmb_bg_code_changed
    lda $414C00,x
    cmp $410600,x
    beq rmb_bg_next
    sta $410E00,x
    bra rmb_bg_append
rmb_bg_code_changed:
    sta $410A00,x
    lda $414C00,x
    sta $410E00,x
rmb_bg_append:
    txa
    sta $1A00,y          ; DBR=$41; 65816 has no absolute-long,Y store
    iny
    iny
rmb_bg_next:
    inx
    inx
    cpx #$0400
    bne rmb_bg_compare
    tya
    jsr rmb_bg_changed_publish
    beq rmb_obj_begin
    nop                         ; preserve the pinned clean-route target
    nop
    nop
    nop
    cmp #$0100
    bcc rmb_obj_begin
    jsr rmb_prepare_bg
    bra rmb_obj_begin

    ; The first accepted image uses the established full renderer to initialize
    ; its tile/palette maps.  Still populate the candidate so the next boundary
    ; can promote it without touching the live shadow.
rmb_bg_first:
    ; Preserve a guarded C0BC token through the first raw-plane copy.  The
    ; out-of-line finish selects its immutable prepared composition only after
    ; candidate==$live has been established for later baseline promotion.
    nop
    nop
    nop
    ldx #$0000
rmb_bg_first_copy:
    lda $414800,x
    sta $410A00,x
    lda $414C00,x
    sta $410E00,x
    inx
    inx
    cpx #$0400
    bne rmb_bg_first_copy
    jmp rmb_bg_first_finish
    nop
    nop
    nop
    nop
    nop
    nop

rmb_bg_clean:
    lda #$0000
    sta $410142
    sta $41013A
    ; The fixed redirect is .org-pinned below.  Keep this branch explicit:
    ; optimization can otherwise shrink the preceding flow and expose a
    ; zero-filled BRK gap on the overwhelmingly common clean-BG path.
rmb_bg_clean_jump:
    bra rmb_obj_begin

    ; Y is the strongest cheap rejection in settled gameplay. For its small
    ; surviving set, keep only the 16px OBJ overlap interval $031-$13F for the
    ; centered arcade-X $040-$13F view. X1-001 bit 8 selects the wrapped copy
    ; used by the rightmost 64 pixels of that crop. Publish visible slots in
    ; source order together with the three
    ; raw words the 5A22 consumes.  The fixed redirect enters an out-of-line
    ; A8 scan that applies the code predicate before packing six-byte records;
    ; saturation therefore remains the first 128 accepted objects rather than
    ; the first 128 Y/X candidates.  Keep this redirect size-neutral so the
    ; tightly packed manifest island and its fixed followers do not move.
.org $DCDE
.a16
.i16
rmb_obj_begin:
    jml.l $9EE600
    nop
    nop

; The redirect above makes this fixed $9E:DCE4-$DDF5 region unreachable from
; the OBJ scan.  Reuse it for candidate/baseline reconciliation without moving
; the pinned manifest epilogue at $DDF6.
.a16
.i16
rmb_bg_reconcile:
    rep #$30
    lda $410132
    beq rmb_bg_reconcile_done
    cmp $410136
    beq rmb_bg_reconcile_done       ; candidate already equals the baseline
    cmp $410134
    beq rmb_bg_reconcile_accepted

    ; The 5A22 did not accept this promotable candidate.  Restore candidate
    ; cells from the still-authoritative baseline before sparse overwrite.
    lda $410142
    beq rmb_bg_reconcile_done
    lda $410136
    beq rmb_bg_reconcile_done       ; first baseline is not initialized yet
    jsr rmb_bg_revert
    rts

rmb_bg_reconcile_accepted:
    lda $410142
    beq rmb_bg_reconcile_done
    jsr rmb_bg_promote
    lda $410134
    sta $410136
rmb_bg_reconcile_done:
    rts

; Promote a retained small diff through its exact offset list.  Prepared/full
; candidates lack an authoritative compact length and retain the 2 KiB copy.
rmb_bg_promote:
    lda $41013A
    beq rmb_bg_promote_done
    cmp #$0100
    bcs rmb_bg_promote_full
    sta $0158
    ldy #$0000
rmb_bg_promote_cell:
    ldx $1A00,y
    lda $0A00,x
    sta $0200,x
    lda $0E00,x
    sta $0600,x
    iny
    iny
    cpy $0158
    bne rmb_bg_promote_cell
rmb_bg_promote_done:
    rts
rmb_bg_promote_full:
    lda #$07FF
    ldx #$0A00
    ldy #$0200
    mvn $41,$41
    rts

; Undo a dropped small candidate through the same retained list.  Large and
; prepared candidates use one complete reverse copy so the sparse builder's
; candidate==baseline invariant remains explicit.
rmb_bg_revert:
    lda $41013A
    beq rmb_bg_revert_done
    cmp #$0100
    bcs rmb_bg_revert_full
    sta $0158
    ldy #$0000
rmb_bg_revert_cell:
    ldx $1A00,y
    lda $0200,x
    sta $0A00,x
    lda $0600,x
    sta $0E00,x
    iny
    iny
    cpy $0158
    bne rmb_bg_revert_cell
rmb_bg_revert_done:
    rts
rmb_bg_revert_full:
    lda #$07FF
    ldx #$0200
    ldy #$0A00
    mvn $41,$41
    rts

.org $DDF6
.a16
.i16
rmb_obj_done:
    tya
    ora #$8000          ; distinguish packed records from legacy offset lists
    sta $410138
    lda $0150
    beq rmb_obj_meta_done
    lda $41013C
    ora #$8000          ; metadata rides every direct/queued immutable snapshot
    sta $41013C
rmb_obj_meta_done:

    plb
    ply
    plx
    pla
    plp
    rtl
render_manifest_build_end:

; Size-neutral bank-$00 map_snes tail.  $6A already contains its mapped shadow
; offset.  Record only coarse domain dirtiness here; the boundary manifest does
; the exact BG comparison only on ticks that actually wrote that domain.
.org $DE20
.a16
.i16
shadow_dirty_publish:
    rep #$30
    ; readbyte's rb_zero path reuses map_snes only to translate a video-bank
    ; address back into the bank-$41 shadow.  Its JSR at $00:B613 leaves the
    ; unique $B615 return word on the native stack.  Do not turn that read into
    ; a producer event: false BG dirtiness makes every boundary rescan all 512
    ; cells, while false palette dirtiness needlessly rebuilds CGRAM staging.
    ; The ROM packer pins both the caller bytes and this guard.
    lda $01,s
    cmp #$B615
    beq sdp_mode
    lda $6A
    cmp #$2000
    bcc sdp_mode
    cmp #$3000
    bcs sdp_bg_test
    lda #$0001
    sta $41013E
    bra sdp_mode
sdp_bg_test:
    cmp #$4800
    bcc sdp_mode
    cmp #$5000
    bcs sdp_mode
    lda #$FFFF
    sta $41014C          ; generic mapped stores have no bounded producer list
    lda #$FFFF
    sta $410144          ; another BG writer invalidates $20E8 payload provenance
    ; Keep producer notification content-neutral.  Exact comparison owns
    ; invalidation once a real changed cell is proven.
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    lda #$0001
    sta $410140
sdp_mode:
    lda #$0001
    sta $C2
    jml.l $00F846       ; retained ms_shadow_return RTS in packed bank $00
shadow_dirty_publish_end:

; Content-based BG invalidation helpers. Producer notifications only mark the
; domain dirty; these run after exact full/sparse comparison.
.org $DE6D
.a16
.i16
rmb_bg_invalidate_tokens:
    stz $014A
    stz $015A
    rts

; A=exact changed-list byte length. Preserve A for zero/size branches while
; retaining provenance when the live C0BC planes still match the exact image
; captured at token publication.  A title->gameplay baseline difference is
; not itself a post-publication mutation.
rmb_bg_changed_publish:
    pha
    sta $41013A
    beq rmb_bg_changed_publish_done
    jsr rmb_bg_validate_tokens
rmb_bg_changed_publish_done:
    pla
    rts

.org $DE80
.a16
.i16
mark_bg_dirty:
    ; Keep producer notification content-neutral; comparison owns invalidation.
    nop
    nop
    nop
    nop
    nop
    nop
    nop
    lda #$FFFF
    sta $41014C          ; caller did not publish an exact bounded cell range
    lda #$0001
    sta $410140
    rtl
mark_bg_dirty_end:

; Finish the pinned first-image path out of line.  C0BC is the only producer
; with a build-hashed immutable prepared payload.  Every other first image
; keeps the established token invalidation and raw/full manifest semantics.
.org $DEA0
.a16
.i16
rmb_bg_first_finish:
    lda $014A
    cmp #$C0BC
    beq rmb_bg_first_prepare_c0bc
    jsr rmb_bg_invalidate_tokens
    lda #$FFFF
    sta $41013A
    jmp rmb_obj_begin
rmb_bg_first_prepare_c0bc:
    jsr rmb_prepare_bg
    jmp rmb_obj_begin
rmb_bg_first_finish_end:

; Validate the live C0BC candidate against the exact code/color planes saved
; when its producer token was published.  The preparation workspace at
; $41:A000-$A7FF is private until rmb_prepare_bg; the C0BC fast dispatcher does
; not consume it.  Any real later mutation clears both producer/display tokens.
.org $DEC0
.a16
.i16
rmb_bg_validate_tokens:
    lda $014A
    cmp #$C0BC
    bne rmb_bg_validate_invalid
    ldx #$0000
rmb_bg_validate_loop:
    lda $414800,x
    cmp $A000,x
    bne rmb_bg_validate_invalid
    lda $414C00,x
    cmp $A400,x
    bne rmb_bg_validate_invalid
    inx
    inx
    cpx #$0400
    bne rmb_bg_validate_loop
    rts
rmb_bg_validate_invalid:
    jmp rmb_bg_invalidate_tokens
rmb_bg_validate_tokens_end:

; Large-transition renderer preparation.  render_manifest_build already owns
; DBR=$41 and has copied the complete candidate to $0A00/$0E00.  Build the same
; tile/palette semantics as vid_bg_heavy, but do it on the 10.74 MHz SA-1.
; Success changes BG_LEN to $FFFE; any hardware-limit
; overflow leaves the ordinary changed-cell manifest authoritative.
.org $DF00
.a16
.i16
rmb_prepare_bg:
    ; Keep the established dynamic body byte-stable.  A fixed seam dispatcher
    ; selects the guarded $C0BC prepared payload or reconstructs this displaced
    ; REP/STZ preamble before returning here at the next instruction.
    jmp rpb_prepare_dispatch
    nop
    nop
rpb_prepare_dynamic:

    ; Pass 1: collect unique codes through a 512-entry open-address hash.
    ; This keeps the full-screen scan O(cells) instead of comparing every cell
    ; against the growing list in contested BW-RAM.  The immutable zero page at
    ; $9E:F000 lets one synchronous PRG-ROM -> BW-RAM DMA replace 512 slow
    ; CPU-side stores; build_interp_rom.py pins and verifies that source page.
    lda #$0400
    ldx #$A000
rpb_hash_clear_collect:
    jsr rpb_zero_dma
    ldy #$0000
rpb_collect_cell:
    lda $0A00,y
    xba
    and #$3FFF
    beq rpb_collect_next
    sta $014E
    and #$01FF
    asl a
    tax
rpb_collect_probe:
    lda $A000,x
    beq rpb_collect_new
    cmp $014E
    beq rpb_collect_found
    inx
    inx
    txa
    and #$03FF
    tax
    bra rpb_collect_probe
rpb_collect_new:
    lda $0146
    cmp #$017E          ; 191 artwork slots * two-byte code; physical zero is blank
    bcc rpb_collect_capacity
    jmp rpb_fail
rpb_collect_capacity:
    lda $014E
    sta $A000,x
    lda $0146
    lsr a
    sta $A400,x         ; first-use slot before the deterministic sort
    sta $A800,y         ; retain that slot for this cell's later translation
    ldx $0146
    lda $014E
    sta $9000,x
    lda $0146
    clc
    adc #$0002
    sta $0146
    bra rpb_collect_next
rpb_collect_found:
    lda $A400,x
    sta $A800,y
rpb_collect_next:
    iny
    iny
    cpy #$0400
    beq rpb_collect_done
    jmp rpb_collect_cell

rpb_collect_done:
    ; Sort the small unique list once, then rebuild the hash with its final
    ; sorted index as the slot.  The measured transition is 45 codes, so this
    ; bounded insertion sort is tiny compared with the former 392x45 searches.
    ldy #$0002
rpb_sort_outer:
    cpy $0146
    bcs rpb_sort_done    ; zero/one-entry lists are already sorted (Y >= length)
    lda $9000,y
    sta $014E           ; insertion key
    sty $0150           ; outer cursor
    tya
    sec
    sbc #$0002
    tax
rpb_sort_shift:
    lda $9000,x
    cmp $014E
    bcc rpb_sort_after
    beq rpb_sort_after
    sta $9002,x
    cpx #$0000
    beq rpb_sort_zero
    dex
    dex
    bra rpb_sort_shift
rpb_sort_after:
    inx
    inx
    bra rpb_sort_place
rpb_sort_zero:
    ldx #$0000
rpb_sort_place:
    lda $014E
    sta $9000,x
    ldy $0150
    iny
    iny
    bra rpb_sort_outer
rpb_sort_done:

    ; Convert the first-use slots already attached to the collection hash into
    ; sorted slots in place, and retain a tiny first-use->sorted translation.
    ; Hash placement remains valid regardless of collisions; avoiding a second
    ; clear/reinsert pass also lets the map consume one word per cell instead
    ; of probing the code hash another 392 times.
    ldy #$0000
rpb_hash_build:
    tya
    cmp $0146
    beq rpb_hash_built
    tax
    lda $9000,x
    sta $014E
    and #$01FF
    asl a
    tax
rpb_hash_build_probe:
    lda $A000,x
    cmp $014E
    beq rpb_hash_build_store
    inx
    inx
    txa
    and #$03FF
    tax
    bra rpb_hash_build_probe
rpb_hash_build_store:
    lda $A400,x
    asl a
    sta $0150           ; first-use slot byte index in the translation table
    tya
    lsr a
    sta $A400,x
    ldx $0150
    sta $AC00,x
    iny
    iny
    bra rpb_hash_build
rpb_hash_built:

    ; Build the complete map in SA-1 time so the 5A22 can DMA it verbatim.
    ; Clear its sparse destination with the same verified ROM zero page.
    lda #$1000
    ldx #$8000
rpb_clear_map:
    jsr rpb_zero_dma

    lda #$FFFF
    ldx #$0000
rpb_clear_palette_map:
    sta $9200,x
    inx
    inx
    cpx #$0020
    bne rpb_clear_palette_map
    stz $0148           ; next palette slot

    ; Pass 2: resolve each cell against the sorted slot list and publish only
    ; its common TL entry.  Palette assignment remains first-use order, exactly
    ; matching bg_palslot/vid_bg_heavy.
    ldy #$0000
rpb_map_cell:
    lda $0A00,y
    xba
    sta $014C           ; code plus per-cell flip bits
    and #$3FFF
    bne rpb_map_nonempty
    jmp rpb_map_next
rpb_map_nonempty:
    ; The collection pass retained the code's first-use slot for every cell.
    ; Translate that slot after sorting without another contested hash probe.
    lda $A800,y
    asl a
    tax
    lda $AC00,x
    inc a               ; prepared physical slot zero is the empty-cell sentinel
    asl a
    asl a
    sta $0154           ; prepared base tile (sorted slot * 4)
rpb_slot_ready:

    ; Same first-use arcade palette-bank assignment as bg_palslot.
    ; The cached plane remains big-endian.  A 16-bit little-endian load leaves
    ; the source high byte in AL, so mask/shift it without changing M on every
    ; nonempty cell.  The byte map may be read as an unaligned word because the
    ; following AND retains only the selected bank entry.
    lda $0E00,y
    and #$00F8
    lsr a
    lsr a
    lsr a
    tax
    lda $9200,x
    and #$00FF
    cmp #$FF
    bne rpb_palette_ready
    lda $0148
    cmp #$0008
    bcc rpb_palette_capacity
    jmp rpb_fail
rpb_palette_capacity:
    sep #$20
.a8
    sta $9200,x
    rep #$20
.a16
    inc $0148
rpb_palette_ready:
    sta $0152           ; BG palette slot

    ; Common TL attributes: slot*4 | palette*1024 | translated flips.
    lda $0152
    asl a
    asl a
    xba
    and #$1C00
    ora $0154
    sta $0154
    lda $014C
    and #$C000
    beq rpb_flips_ready
    cmp #$C000
    beq rpb_flips_mapped
    eor #$C000           ; arcade X/Y bits are opposite the SNES attribute bits
rpb_flips_mapped:
    ora $0154
    sta $0154
rpb_flips_ready:
    ; Exact 16x32 arcade-cell -> split 64x32 SNES tilemap mapping.  The source
    ; byte offset is also the index into a build-generated immutable table;
    ; use a literal bank because Poppy records same-bank symbols as bank $00.
    tyx
    lda.l $9EE800,x
rpb_left_nt:
    tax

    lda $0154
    sta $8000,x
    inc a
    sta $8002,x
    inc a
    sta $8040,x
    inc a
    sta $8042,x

rpb_map_next:
    iny
    iny
    cpy #$0400
    beq rpb_success
    jmp rpb_map_cell
rpb_success:
    lda #$FFFE
    sta $013A           ; publish prepared-full sentinel only after all data exists
    rts
rpb_fail:
    stz $0146           ; retain the ordinary $1A00 changed-cell list and length
    rts

; Synchronous zero-fill from the build-verified $9E:F000 ROM page.
; Entry: A=byte count, X=physical bank-$01 BW-RAM destination, M/X=16,
; DBR=$41.  SA-1 DMA stalls until complete, then the helper restores DBR and
; leaves the engine disabled with its completion flag acknowledged.
rpb_zero_dma:
    rep #$30
.a16
.i16
    sta $0154
    stx $0156
    phb
    sep #$20
.a8
    lda #$00
    pha
    plb
    lda #$20
    sta $220B
    lda #$84                   ; PRG ROM -> physical BW-RAM bank 1
    sta $2230
    stz $2232                  ; source $9E:F000
    lda #$F0
    sta $2233
    lda #$9E
    sta $2234
    lda $410154
    sta $2238
    lda $410155
    sta $2239
    lda $410156
    sta $2235
    lda $410157
    sta $2236
    lda #$01
    sta $2237                  ; writing destination bank triggers DMA
    lda #$20
    sta $220B
    stz $2230
    plb
    rep #$20
.a16
    rts
rmb_prepare_bg_end:

; The organic selector-zero $C0BC initializer has a build-hashed complete
; prepared representation.  Its post-callback probe publishes $C0BC only when
; all 120 cells outside the fixed 14x28 footprint remain empty, and every BG
; writer invalidates the token.  Three synchronous ROM DMAs replace the 512-
; cell hash/sort/map reconstruction while retaining the same $FFFE consumer.
.org $E100
.a16
.i16
rpb_prepare_dispatch:
    rep #$30
    lda $014A
    cmp #$C0BC
    beq rpb_c0bc_prepared
    stz $0146
    stz $015A
    jmp rpb_prepare_dynamic
rpb_c0bc_prepared:
    lda #$C0BC
    sta $015A
    ldx #$9000                  ; prepared 4 KiB SNES tilemap
    ldy #$8000
    lda #$1000
    jsr rpb_c0bc_rom_dma
    ldx #$A000                  ; 45 sorted 14-bit code words
    ldy #$9000
    lda #$005A
    jsr rpb_c0bc_rom_dma
    ldx #$A05A                  ; 32-byte arcade-bank palette map
    ldy #$9200
    lda #$0020
    jsr rpb_c0bc_rom_dma
    lda #$005A
    sta $0146
    jmp rpb_success
rpb_prepare_dispatch_end:

; entry_8c2 normally sees an empty 32-bit palette dirty mask, but its original
; loop still shifted that zero 32 times.  The four-byte bank-$92 loop head jumps
; here.  A nonzero mask gets the exact displaced LSR/ROR and rejoins at its BCC;
; zero skips to the post-DBRA assignments.  X/Y differ only on the zero shortcut
; and are overwritten before either can feed another native or emulated value.
.org $E180
.a16
.i16
h8_zero_mask_gate:
    rep #$30
    lda $82
    ora $80
    beq h8_zero_mask_done
    lsr $82
    ror $80
    jml.l $92B3A0
h8_zero_mask_done:
    jml.l $92B3B0
h8_zero_mask_gate_end:

; Return one producer OBJ X/color word in its packed-renderer form.
; Carry clear rejects the record. Carry set accepts it with A still in the
; source's big-endian byte order. The centered gameplay crop remains exactly
; raw X $031-$13F. Two HUD-only exceptions preserve text that a centered
; 384-to-256 crop would otherwise discard:
; - top rows Y=$E2/$F2 compact raw left X<$40 by +48 and raw right
;   X=$120-$16F by -48, retaining 1UP/2UP, both scores, and HIGH SCORE;
; - the arcade credit counter's five bottom-row glyph records sit at
;   Y=$0A, X=$120-$160 with codes $007D-$0080/$008B, so translate them
;   left by 48 pixels instead of dropping "DIT 0" beyond the SNES edge.
;
; The top compaction is routed through an owned helper below $E400. Non-HUD
; candidates replay this helper's exact original $031-$13F predicate.
.org $E1A0
.a16
.i16
rmb_obj_x_visible:
    lda $4400,x
    xba
    sta $014E
    and #$01FF
    cmp #$0120
    bcc rox_normal
    cmp #$0170
    bcs rox_reject
    lda $3000,x
    xba
    and #$00FF
    cmp #$000A
    bne rox_normal
    lda $4000,x
    xba
    and #$3FFF
    cmp #$007D
    bcc rox_normal
    cmp #$0081
    bcc rox_credit
    cmp #$008B
    bne rox_normal
rox_credit:
    lda $014E
    sec
    sbc #$0030
    xba
    sec
    rts
rox_normal:
    lda $014E
    and #$01FF
    cmp #$0040
    bcc rox_top_candidate
    cmp #$0120
    bcs rox_top_candidate
    lda $4400,x
    sec
    rts
rox_reject:
    clc
    rts
rox_top_candidate:
    jmp rox_top_x
rmb_obj_x_visible_end:

; ============================================================================
; Rejected renderer OBJ prefilter consumers/producers (dead islands).
;
; v42/v43 proved that moving the Y scan into $158E costs about 12.0K cycles to
; save about 7.9K in the manifest.  No production path links either body;
; build_interp_rom.py rejects both the former $94 JSL and live-manifest JML.
; Keep the bodies temporarily as byte-stable negative-evidence islands while
; the Y-only manifest/5A22-consumer split is validated.
;
; h158_ylist_stage ran inside the existing synchronous $158E BW-RAM->IRAM
; transfer after both live-shadow consumers have copied the staged bytes.
; Only destinations $3002/$3202 are OBJ-Y chunks; later X/code chunks return
; immediately.  It compacts qualifying offsets in place inside disposable
; IRAM, then publishes each chunk with one IRAM->BW-RAM DMA instead of one slow
; shared-BW-RAM store per slot.  The two unchanged boundary slots outside
; $158E's 1020-byte interior copy retain the exact full-scan semantics.
;
; rmb_obj_prefilter consumed that ordered superset at the real $0818 boundary
; and applies the unchanged code/X predicates plus the 128-entry saturation
; rule.  If the list is absent or was invalidated by a later generic shadow
; write, it reconstructs the displaced six-byte prologue and enters the full
; 512-slot scan unchanged.
; ============================================================================
.org $E200
.a16
.i16
rmb_obj_prefilter:
    rep #$30
    ; render_manifest_build established DBR=$41 before its fixed redirect.
    lda $015A
    cmp #$A55A
    beq rop_fast

    ; Exact fallback prologue displaced at rmb_obj_begin.
    ldx #$0000
    txy
    sep #$20
.a8
    jml.l $9EDCE4

rop_fast:
    ldy #$0000                 ; final manifest-list byte cursor
    stz $015C                  ; Y-qualified input-list byte cursor
rop_loop:
    ldx $015C
    cpx $0158
    beq rop_done
    lda $1600,x                ; exact source byte offset, ascending
    inx
    inx
    stx $015C
    tax

    ; Unchanged code predicate from rmb_obj_loop.
    sep #$20
.a8
    lda $4001,x
    bne rop_code_low_nonzero
    lda $4000,x
    and #$3F
    beq rop_reject
    bra rop_code_ready
rop_code_low_nonzero:
    cmp #$FF
    bne rop_code_ready
    lda $4000,x
    cmp #$FF
    beq rop_reject
rop_code_ready:
    ; Unchanged signed-nine-bit X visibility predicate.
    lda $4400,x
    and #$01
    beq rop_visible
    lda $4401,x
    cmp #$F0
    bcc rop_reject
rop_visible:
    rep #$20
.a16
    txa
    sta $1E00,y
    iny
    iny
    cpy #$0100
    beq rop_done
    bra rop_loop
rop_reject:
    rep #$20
.a16
    bra rop_loop
rop_done:
    jml.l $9EDDF8
rmb_obj_prefilter_end:

; Exact producer-list BG builder.  Candidate reconciliation has already made
; $41:0A00/$0E00 equal the accepted baseline.  Comparing each cumulative touch
; against that candidate both eliminates duplicate producer entries and keeps
; a dropped render candidate cumulative relative to the last accepted image.
; Generic/unbounded producers retain the established 512-cell scan.
.org $E280
.a16
.i16
render_bg_dirty_sparse:
    rep #$30
    lda $410140
    beq rbds_clean
    lda $41014C
    cmp #$0001
    bne rbds_default
    lda $410136
    beq rbds_default
    lda $41014E
    beq rbds_default
    cmp #$0401
    bcs rbds_default
    bit #$0001
    bne rbds_default
rbds_fast:
    sta $0158                  ; cumulative source-list byte length
    stz $0160                  ; unique changed-cell output byte length
    ldy #$0000
    lda #$0001
    sta $410142
rbds_cell:
    ldx $1200,y
    stx $015C
    lda $4800,x
    cmp $0A00,x
    bne rbds_code_changed
    lda $4C00,x
    cmp $0E00,x
    beq rbds_next
    sta $0E00,x
    bra rbds_append
rbds_code_changed:
    sta $0A00,x
    lda $4C00,x
    sta $0E00,x
rbds_append:
    ldx $0160
    lda $015C
    sta $1A00,x
    inx
    inx
    stx $0160
rbds_next:
    iny
    iny
    cpy $0158
    bne rbds_cell
    lda $0160
    jsr rmb_bg_changed_publish
    cmp #$0100
    bcc rbds_done
    jsr rmb_prepare_bg
rbds_done:
    jml.l $9EDCDE
rbds_clean:
    ; This helper is assembled as bank $00 and packed into bank $9E, so the
    ; bank byte cannot come from the local symbol.  Keep the packed target
    ; explicit and let build_interp_rom.py prove it still equals
    ; rmb_bg_clean after every manifest-layout change.
    jml.l $9EDCB2
rbds_default:
    jml.l $9EDC32
render_bg_dirty_sparse_end:

; Compact only the two fixed top-HUD rows into the narrower SNES window.
; Masking bit $10 makes $E2 and $F2 one comparison.  Candidates which are not
; on those rows replay the original centered-crop predicate exactly.
.org $E320
.a16
.i16
rox_top_x:
    lda $3000,x
    xba
    and #$00EF
    cmp #$00E2
    bne rox_top_fallback
    lda $014E
    and #$01FF
    cmp #$0040
    bcs rox_top_right
rox_top_left:
    lda $014E
    clc
    adc #$0030
    xba
    sec
    rts
rox_top_right:
    cmp #$0120
    bcc rox_top_fallback
    cmp #$0170
    bcs rox_top_reject
    lda $014E
    sec
    sbc #$0030
    xba
    sec
    rts
rox_top_fallback:
    lda $014E
    and #$01FF
    cmp #$0031
    bcc rox_top_reject
    cmp #$0140
    bcs rox_top_reject
    lda $4400,x
    sec
    rts
rox_top_reject:
    clc
    rts
rox_top_x_end:

.org $E400
.a8
.i16
h158_ylist_stage:
    ; Called with M=8 after the staged chunk reached both shadow consumers.
    ; Reject every non-Y destination before touching private workspace.
    rep #$20
.a16
    lda $92
    cmp #$3002
    beq hyl_active
    cmp #$3202
    beq hyl_active
    sep #$20
.a8
    rtl

hyl_active:
.a16
.i16
    ; Preserve native registers plus the outer $158E snapshot cells.  Force
    ; DBR=0 so the compact output at $0100,Y is indisputably IRAM.
    phb
    phx
    phy
    lda $9C
    pha
    lda $9E
    pha
    sep #$20
.a8
    lda #$00
    pha
    plb
    rep #$20
.a16
    lda $92
    cmp #$3002
    bne hyl_second

hyl_first:
.a16
.i16
    lda #$0000
    sta $410158
    sta $41015A

    ; Slot zero is the untouched word immediately before the copied interior.
    sep #$20
.a8
    lda.l $413001
    beq hyl_first_boundary_done
    cmp #$F0
    bcs hyl_first_boundary_done
    rep #$20
.a16
    lda #$0000
    ldx #$0000
    sta.l $411600,x
    lda #$0002
    sta.l $410158
    sep #$20
.a8
hyl_first_boundary_done:
    rep #$20
.a16
    lda #$FF01                 ; $0101 + $FF01 = source offset $0002
    sta $9C
    lda #$0301                 ; 256 staged low-Y bytes consumed
    sta $9E
    bra hyl_scan_setup

hyl_second:
    rep #$20
.a16
.i16
    lda #$0101                 ; $0101 + $0101 = source offset $0202
    sta $9C
    lda #$02FD                 ; 254 staged low-Y bytes consumed
    sta $9E

hyl_scan_setup:
    rep #$20
.a16
.i16
    ; Compact 16-bit source offsets over the already-consumed staging bytes.
    ; Output advances by at most two bytes per two-byte source word and begins
    ; one byte behind the first low-Y read, so it can never overtake input.
    ldy #$0000
    ldx #$0101                 ; first low Y byte in the staged chunk
    sep #$20
.a8
hyl_loop:
    lda $00,x
    beq hyl_slot0_next
    cmp #$F0
    bcs hyl_slot0_next
    rep #$20
.a16
    txa
    clc
    adc $9C
    sta $0100,y
    iny
    iny
    sep #$20
.a8
hyl_slot0_next:
    inx
    inx

    lda $00,x
    beq hyl_slot1_next
    cmp #$F0
    bcs hyl_slot1_next
    rep #$20
.a16
    txa
    clc
    adc $9C
    sta $0100,y
    iny
    iny
    sep #$20
.a8
hyl_slot1_next:
    inx
    inx
    cpx $9E
    bne hyl_loop

    ; Publish the compacted chunk with one synchronous IRAM->BW-RAM DMA.
    rep #$20
.a16
    tya
    sta $9E                    ; compact chunk byte length
    beq hyl_chunk_published
    lda.l $410158
    clc
    adc #$1600
    sta $9C                    ; physical bank-$01 destination low word
    sep #$20
.a8
    lda #$20
    sta $220B
    lda #$86                   ; IRAM -> linear BW-RAM
    sta $2230
    stz $2232
    lda #$01
    sta $2233
    stz $2234
    lda $9E
    sta $2238
    lda $9F
    sta $2239
    lda $9C
    sta $2235
    lda $9D
    sta $2236
    lda #$01
    sta $2237                  ; synchronous trigger
    rep #$20
.a16
    lda.l $410158
    clc
    adc $9E
    sta.l $410158

hyl_chunk_published:
    rep #$20
.a16
    lda $92
    cmp #$3202
    bne hyl_restore

    ; Slot 511 is the other untouched boundary outside the interior copy.
    sep #$20
.a8
    lda.l $4133FF
    beq hyl_second_boundary_done
    cmp #$F0
    bcs hyl_second_boundary_done
    rep #$20
.a16
    lda.l $410158
    tax
    lda #$03FE
    sta.l $411600,x
    inx
    inx
    txa
    sta.l $410158
hyl_second_boundary_done:
    rep #$20
.a16
    lda #$A55A
    sta.l $41015A              ; publish only after the complete Y plane list
hyl_restore:
    rep #$20
.a16
    pla
    sta $9E
    pla
    sta $9C
    ply
    plx
    plb
    sep #$20
.a8
    rtl
h158_ylist_stage_end:

; Append one already-qualified active-OBJ record to the producer's private
; manifest workspace.  DBR=$41 and X remains the source byte offset.  The
; offset itself is not consumed after packing: preserving Y/code/X together is
; sufficient for both cache preflight and rendering.  When the 128th record
; fills the six-byte workspace, discard this helper's JSR return and leave the
; unrolled scan immediately; later source slots cannot be rendered under the
; established OAM cap.
.org $E540
.a16
.i16
rmb_obj_pack:
    ; The arcade title composes six long 8x8 text rows out of overlapping
    ; 16x16 OBJ records.  They exceed both the SNES 128-OBJ frame cap and its
    ; 34 OBJ tiles/scanline limit.  A title signature recorded at $0150 moves
    ; precisely those six rows to the 5A22 BG2 overlay; retain the logo, HUD,
    ; globe, and every non-title frame in their original source order.
    lda $0150
    beq rmb_obj_pack_bottom_status
    lda $3000,x
    xba
    cmp #$001A
    bcc rmb_obj_pack_bottom_status
    cmp #$0070
    bcs rmb_obj_pack_bottom_status
    and #$000F
    cmp #$000A
    beq rmb_obj_pack_reject

rmb_obj_pack_bottom_status:
    ; Source slot 2 and slot 36 are solid-black code-$0002 spacers behind
    ; the bottom CREDIT digit.  They were invisible over the arcade's black
    ; overscan, but the centered SNES crop places them over live artwork and
    ; produces the two-tile hole reported at the credited-player prompt.
    ; Reject those exact spacers only on the proven bottom row.
    ;
    ; Source slots 37-52 are the arcade's two bottom player-status fields.
    ; During one-player gameplay they contain off-window strings such as
    ; "INSERT COIN", "PUSH 2P BUTTON", and "GAME OVER".  Slots 53-56 are
    ; the adjacent off-window ROUND field; its first record at raw X=$138
    ; otherwise leaks the left half of an "R" through the centered crop.
    ; The independent CREDIT counter is slots 31-36, so reject only these
    ; fixed X1-001 HUD allocations on their proven bottom rows.
    cpx #$0004
    beq rmb_obj_pack_bottom_y
    cpx #$0048
    bcc rmb_obj_pack_x
    cpx #$0072
    bcs rmb_obj_pack_x
rmb_obj_pack_bottom_y:
    lda $3000,x
    cmp #$0A00
    beq rmb_obj_pack_reject
    cpx #$006A
    bcc rmb_obj_pack_x
    cmp #$1A00
    beq rmb_obj_pack_reject

rmb_obj_pack_x:
    ; Logical code $0020 is an entirely transparent 16x16 record.  The arcade
    ; top HUD nevertheless publishes several of them as spacing cells.  If
    ; retained as SNES OBJs they consume enough 8x8 tiles to exceed the
    ; hardware's 34-tile scanline limit and punch a horizontal hole through
    ; the right side of the credited prompt.  Reject only that proven-empty
    ; code on the two compacted top-HUD rows; ordinary records and every
    ; non-HUD use preserve their source order.
    lda $3000,x
    xba
    and #$00EF
    cmp #$00E2
    bne rmb_obj_pack_x_visible
    lda $4000,x
    xba
    and #$3FFF
    cmp #$0020
    beq rmb_obj_pack_reject
rmb_obj_pack_x_visible:
    ; The X1-001 treats bit 8 as a sign bit, then draws both 512px-wrapped
    ; copies.  For the centered arcade-X 64..319 crop that makes raw
    ; $031-$13F visible: a 16px sprite at raw X=49 first overlaps the left
    ; edge, while raw $100-$13F wraps back to arcade X=256..319. The helper
    ; also applies the narrow bottom-row credit-label translation.
    jsr rmb_obj_x_visible
    bcc rmb_obj_pack_reject
    sta $014E
    lda $3000,x
    sta $1600,y
    lda $4000,x
    sta $1602,y
    lda $014E
    sta $1604,y
    tya
    clc
    adc #$0006
    tay
    cpy #$0300
    bne rmb_obj_pack_done
    pla                 ; discard the helper JSR return (16-bit accumulator)
    jmp rmb_obj_fast_done
rmb_obj_pack_done:
    rts
rmb_obj_pack_reject:
    rts
rmb_obj_pack_end:

; Identify the exact post-TAITO title composition before the packed scan.  The
; signature spans one copyright glyph and two distant logo/text records so a
; gameplay row which happens to reuse an ASCII tile cannot enable BG2.  $0150
; was transient prepared-BG scratch earlier in this same boundary and becomes
; candidate metadata only after that work has returned.
.org $E5C0
.a8
.i16
rmb_title_detect:
    stz $0150
    stz $0151
    lda $4207                  ; slot 259: "T" in TAMERLANE, raw Y=$1A
    cmp #$54
    bne rmb_title_detect_done
    lda $3207
    cmp #$1A
    bne rmb_title_detect_done
    lda $408B                  ; slot 69: copyright glyph, raw Y=$6A
    cmp #$40
    bne rmb_title_detect_done
    lda $308B
    cmp #$6A
    bne rmb_title_detect_done
    lda $4256                  ; slot 299: first large SUPERMAN-logo tile
    cmp #$12
    bne rmb_title_detect_done
    lda $4257
    cmp #$A4
    bne rmb_title_detect_done
    lda $3257
    cmp #$D2
    bne rmb_title_detect_done
    lda #$01
    sta $0150
rmb_title_detect_done:
    rts
rmb_title_detect_end:

; Exact visible-OBJ scan for the six-byte production representation.  The
; common Y and wrapped-right-X filters stay eight-way unrolled; rmb_obj_pack
; rejects the X<49 left fringe and defensively enforces the complete
; $031-$13F interval. The remaining code test is performed in A8 before paying
; either a mode switch or helper call. This is
; semantically identical to the old A16 helper predicate:
;   raw code != $FFFF && (raw code & $3FFF) != 0.
; $9E:E600-$E7FF is a fixed zero-backed island; keep the entire body below the
; immutable BG-offset table at $9E:E800.
.org $E600
.a16
.i16
rmb_obj_fast_scan:
    ldx #$0000
    txy
    sep #$20
.a8
    jsr rmb_title_detect
rmb_obj_fast_loop:
    lda $3001,x
    cmp #$F3                  ; $F0-$F2 map to visible screen rows 2..0
    bcs rmb_obj_fast_slot0_next
    cmp #$01
    bcc rmb_obj_fast_slot0_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot0_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot0_next
rmb_obj_fast_slot0_code:
    lda $4001,x
    beq rmb_obj_fast_slot0_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot0_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot0_next
    bra rmb_obj_fast_slot0_visible
rmb_obj_fast_slot0_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot0_next
rmb_obj_fast_slot0_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot0_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot1_next
    cmp #$01
    bcc rmb_obj_fast_slot1_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot1_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot1_next
rmb_obj_fast_slot1_code:
    lda $4001,x
    beq rmb_obj_fast_slot1_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot1_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot1_next
    bra rmb_obj_fast_slot1_visible
rmb_obj_fast_slot1_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot1_next
rmb_obj_fast_slot1_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot1_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot2_next
    cmp #$01
    bcc rmb_obj_fast_slot2_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot2_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot2_next
rmb_obj_fast_slot2_code:
    lda $4001,x
    beq rmb_obj_fast_slot2_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot2_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot2_next
    bra rmb_obj_fast_slot2_visible
rmb_obj_fast_slot2_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot2_next
rmb_obj_fast_slot2_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot2_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot3_next
    cmp #$01
    bcc rmb_obj_fast_slot3_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot3_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot3_next
rmb_obj_fast_slot3_code:
    lda $4001,x
    beq rmb_obj_fast_slot3_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot3_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot3_next
    bra rmb_obj_fast_slot3_visible
rmb_obj_fast_slot3_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot3_next
rmb_obj_fast_slot3_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot3_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot4_next
    cmp #$01
    bcc rmb_obj_fast_slot4_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot4_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot4_next
rmb_obj_fast_slot4_code:
    lda $4001,x
    beq rmb_obj_fast_slot4_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot4_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot4_next
    bra rmb_obj_fast_slot4_visible
rmb_obj_fast_slot4_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot4_next
rmb_obj_fast_slot4_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot4_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot5_next
    cmp #$01
    bcc rmb_obj_fast_slot5_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot5_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot5_next
rmb_obj_fast_slot5_code:
    lda $4001,x
    beq rmb_obj_fast_slot5_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot5_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot5_next
    bra rmb_obj_fast_slot5_visible
rmb_obj_fast_slot5_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot5_next
rmb_obj_fast_slot5_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot5_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot6_next
    cmp #$01
    bcc rmb_obj_fast_slot6_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot6_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot6_next
rmb_obj_fast_slot6_code:
    lda $4001,x
    beq rmb_obj_fast_slot6_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot6_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot6_next
    bra rmb_obj_fast_slot6_visible
rmb_obj_fast_slot6_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot6_next
rmb_obj_fast_slot6_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot6_next:
    inx
    inx

    lda $3001,x
    cmp #$F3
    bcs rmb_obj_fast_slot7_next
    cmp #$01
    bcc rmb_obj_fast_slot7_next
    lda $4400,x
    lsr a
    bcc rmb_obj_fast_slot7_code
    lda $4401,x
    cmp #$70
    bcs rmb_obj_fast_slot7_next
rmb_obj_fast_slot7_code:
    lda $4001,x
    beq rmb_obj_fast_slot7_code_low_zero
    cmp #$FF
    bne rmb_obj_fast_slot7_visible
    lda $4000,x
    cmp #$FF
    beq rmb_obj_fast_slot7_next
    bra rmb_obj_fast_slot7_visible
rmb_obj_fast_slot7_code_low_zero:
    lda $4000,x
    and #$3F
    beq rmb_obj_fast_slot7_next
rmb_obj_fast_slot7_visible:
    rep #$20
.a16
    jsr rmb_obj_pack
    sep #$20
.a8
rmb_obj_fast_slot7_next:
    inx
    inx
    cpx #$0400
    beq rmb_obj_fast_done
    jmp rmb_obj_fast_loop
rmb_obj_fast_done:
    rep #$20
.a16
    jml.l $9EDDF6
rmb_obj_fast_scan_end:

; Poppy's .incbin emits bytes without advancing its logical PC.  Pin the end
; explicitly so the packer can byte-audit both this immutable lookup and the
; untouched 4 KiB zero source that follows at $9E:F000.
.org $E800
render_bg_offset_table:
    .incbin "render_bg_offsets.bin"
.org $EC00
render_bg_offset_table_end:

; =============================================================================
; Guarded production $00C0BC selector-0 tilemap initializer.
;
; The legal generated bank-$9D body remains the rejection path.  Organic
; gameplay uses selector zero, whose first thirteen $29B6 calls read fixed
; private-ROM rows.  The packer precomputes their two exact 56-byte shadow
; planes at $9F:8000.  Copy those rows with SA-1 DMA, then execute the real
; differential-tested final $29B6 callback.  That final call preserves the
; complete MOVEM.W sign-extension behavior, final stack residue, D7/CCR
; effects, dirty publication, and the fourteenth row without duplicating the
; callback's architectural contract here.
;
; Rejection is side-effect-free with respect to emulated state: canonical A5,
; stack range, selector, and callback pointer are checked before the first
; work-RAM write.  Selectors 1-4 and synthetic/aliasing states therefore keep
; using entry_c0bc_generated.
; =============================================================================
.org $EC00
.a16
.i16
hle_c0bc:
    rep #$30
    lda $34
    bne hc0bc_hle_reject
    lda $36
    cmp #$00F0
    bne hc0bc_hle_reject
    lda $3E
    cmp #$00F0
    bne hc0bc_hle_reject

    ; The final callback can touch [entry A7-$38, entry A7).  Admit only
    ; ranges wholly below the indirect target, between it and the row records,
    ; or above every modified metadata byte.  Production uses the first arm.
    lda $3C
    cmp #$0038
    bcc hc0bc_hle_reject
    cmp #$1CC3
    bcc hc0bc_hle_stack_ok
    sec
    sbc #$0038
    cmp #$1CC6
    bcc hc0bc_hle_reject
    lda $3C
    cmp #$29B3
    bcc hc0bc_hle_stack_ok
    sec
    sbc #$0038
    cmp #$2A48
    bcc hc0bc_hle_reject
hc0bc_hle_stack_ok:
    lda $401CC2                 ; logical callback $000029B6
    bne hc0bc_hle_reject
    lda $401CC4
    cmp #$B629
    bne hc0bc_hle_reject
    lda $402930                 ; logical selector zero is endian-invariant
    bne hc0bc_hle_reject
    bra hc0bc_hle_fast

hc0bc_hle_reject:
    jml.l entry_c0bc_generated

hc0bc_hle_fast:
    ; The first thirteen rows below bypass every mapped/native dirty helper.
    ; Preserve the conservative full-scan contract; the final $29B6 call must
    ; not incorrectly narrow this initializer to its own fourteenth row.
    lda #$FFFF
    sta $41014C

    ; Exact fixed-field initialization.  Byte $2A36 and the trailing word of
    ; every eight-byte row record remain caller-owned as in the arcade body.
    lda #$0000
    sta $402A32
    lda #$A001                  ; logical big-endian word $01A0
    sta $402A34
    sep #$20
.a8
    lda #$01
    sta $402A37
    rep #$20
.a16
    lda #$0500                  ; logical pointer $00055FE4
    sta $402A38
    lda #$E45F
    sta $402A3A
    lda #$0000
    sta $402A3C
    lda #$0500                  ; logical pointer $0005708C
    sta $402A44
    lda #$8C70
    sta $402A46

    ; Fourteen records: D0.w, D1.w, D2.w, untouched trailing word.
    stz $80
    stz $82
    lda #$000E
    sta $84
    ldx #$29B2
hc0bc_hle_record_loop:
    lda $80
    xba
    sta $400000,x
    lda #$0000
    sta $400002,x
    lda $82
    xba
    sta $400004,x
    lda $80
    clc
    adc #$0020
    sta $80
    lda $82
    clc
    adc #$0040
    sta $82
    txa
    clc
    adc #$0008
    tax
    dec $84
    bne hc0bc_hle_record_loop

    ; First thirteen code-plane rows, then their color-plane partners.  The
    ; payload contains only each row's 56 changed bytes, preserving the eight
    ; untouched bytes between destination rows.
    lda #$8000
    sta $80
    lda #$009F
    sta $82
    lda #$4800
    sta $84
    lda #$000D
    sta $86
hc0bc_hle_code_dma_loop:
    jsr hc0bc_hle_dma56
    lda $80
    clc
    adc #$0038
    sta $80
    lda $82
    adc #$0000
    sta $82
    lda $84
    clc
    adc #$0040
    sta $84
    dec $86
    bne hc0bc_hle_code_dma_loop

    lda #$82D8                 ; $0D * $38 bytes after the code plane
    sta $80
    lda #$009F
    sta $82
    lda #$4C00
    sta $84
    lda #$000D
    sta $86
hc0bc_hle_color_dma_loop:
    jsr hc0bc_hle_dma56
    lda $80
    clc
    adc #$0038
    sta $80
    lda $82
    adc #$0000
    sta $82
    lda $84
    clc
    adc #$0040
    sta $84
    dec $86
    bne hc0bc_hle_color_dma_loop

    ; Architectural state immediately before iteration 13's JSR (A0).
    lda #$0500                  ; $2A38 = logical $00055FF0
    sta $402A38
    lda #$F05F
    sta $402A3A
    lda #$3800                  ; $2A3C = logical $0038
    sta $402A3C
    lda #$0500                  ; $2A44 = logical $00057092
    sta $402A44
    lda #$9270
    sta $402A46
    lda #$01A0
    sta $00                     ; D0.w
    stz $04                     ; D1.w
    lda #$0340
    sta $08                     ; D2.w
    lda #$0038
    sta $0C                     ; D3.w
    stz $18                     ; D6.w before final DBRA
    lda #$29B6
    sta $20                     ; A0 = callback
    stz $22
    lda #$786C
    sta $24                     ; A1 = final packed-ROM source $0004786C
    lda #$0004
    sta $26
    lda #$7092
    sta $28                     ; A2 = final tile-base pointer $00057092
    lda #$0005
    sta $2A
    lda #$2A1A
    sta $30                     ; A4 = $F029B2 + 13 * 8
    lda #$00F0
    sta $32

    ; Build the final call's exact 14-byte argument block at A7-14.
    lda $3C
    sec
    sbc #$000E
    sta $3C
    tax
    lda #$4003                  ; logical row $0340
    sta $400000,x
    lda #$0098                  ; logical tile base $9800
    sta $400002,x
    lda #$0000
    sta $400004,x
    sta $400006,x
    lda #$0400                  ; logical source long $0004786C
    sta $400008,x
    lda #$6C78
    sta $40000A,x
    lda #$0000
    sta $40000C,x

    ; $29B6 already has a proven bank-$9D return router.  Return through the
    ; four-byte bank-$9D trampoline, then continue at the fixed $9E:EE00 seam.
    lda #c0bc_hle_29b6_return
    sta $54
    lda #$00F8
    sta $56
    jsl.l push32_l
    jml.l entry_29b6_fast
hc0bc_hle_main_end:

; Keep the post-callback seam fixed so the bank-$9D trampoline has no generated
; cross-bank symbol dependency.
.org $EE00
.a16
.i16
hc0bc_hle_after_29b6:
    rep #$30
    ; Replace the native marker at [entry A7-18,entry A7-14) with the original
    ; MC68000 JSR (A0) return $00:C134.  The final callback owns every lower
    ; LINK/MOVEM byte.
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$0000
    sta $400000,x
    lda #$C134
    xba
    sta $400002,x

    lda $3C
    clc
    adc #$000E
    sta $3C
    lda $3E
    adc #$0000
    sta $3E
    lda #$7000
    sta $402A3C                ; final logical offset $0070
    lda #$01C0
    sta $00
    lda #$0380
    sta $08
    lda #$FFFF
    sta $18
    lda #$2A22
    sta $30

    ; Final ADDI.W #$40,D2 is positive/nonzero with no carry or overflow.
    stz $A2
    stz $70
    stz $60
    stz $72
    stz $6E

    ; The prepared renderer payload is exact only when no live code exists in
    ; the 120 cells outside this initializer's fixed 14x28 footprint.  Random
    ; differential preimages and any retained scene data therefore leave the
    ; token clear and use the ordinary dynamic preparation.  Empty-cell color
    ; words are intentionally irrelevant to the renderer's code-zero test.
    lda #$0000
    sta $41014A
    ldx #$0038
    lda #$000E
    sta $88
hc0bc_hle_probe_gap:
    lda.l $414800,x
    ora.l $414802,x
    ora.l $414804,x
    ora.l $414806,x
    bne hc0bc_hle_done
    txa
    clc
    adc #$0040
    tax
    dec $88
    bne hc0bc_hle_probe_gap
    ldx #$0380
hc0bc_hle_probe_tail:
    lda.l $414800,x
    bne hc0bc_hle_done
    inx
    inx
    cpx #$0400
    bne hc0bc_hle_probe_tail
    jsr hc0bc_token_snapshot
    lda #$C0BC
    sta $41014A
hc0bc_hle_done:
    lda #$C170
    sta $40
    stz $42
    jml.l inext
hc0bc_hle_after_end:

; Snapshot the exact live code/color planes paired with the C0BC token.  The
; manifest later distinguishes the expected title->gameplay baseline delta
; from a genuine writer that ran after publication.  Preserve DBR/X/Y; A is
; immediately overwritten by the caller's token load.
.org $EEA0
.a16
.i16
hc0bc_token_snapshot:
    phb
    phx
    phy
    lda #$03FF
    ldx #$4800
    ldy #$A000
    mvn $41,$41
    lda #$03FF
    ldx #$4C00
    ldy #$A400
    mvn $41,$41
    ply
    plx
    plb
    rts
hc0bc_token_snapshot_end:

; One precomputed 56-byte row from bank-$9F PRG ROM to physical BW-RAM bank 1.
; $80/$82=source, $84=destination.
.org $EF00
.a16
.i16
hc0bc_hle_dma56:
    sep #$20
.a8
    lda #$20
    sta $220B
    lda #$84                   ; PRG ROM -> BW-RAM
    sta $2230
    lda $80
    sta $2232
    lda $81
    sta $2233
    lda $82
    sta $2234
    lda #$38
    sta $2238
    stz $2239
    lda $84
    sta $2235
    lda $85
    sta $2236
    lda #$01
    sta $2237                  ; physical BW-RAM bank 1; trigger
    lda #$20
    sta $220B
    stz $2230
    rep #$20
.a16
    rts

; Generic $9F PRG-ROM -> physical bank-1 BW-RAM DMA for the guarded prepared
; renderer payload.  Entry A=length, X=source low word, Y=destination.
.org $EF40
.a16
.i16
rpb_c0bc_rom_dma:
    rep #$30
    sta $0150
    stx $0152
    sty $0154
    phb
    sep #$20
.a8
    lda #$00
    pha
    plb
    lda #$20
    sta $220B
    lda #$84
    sta $2230
    lda $410152
    sta $2232
    lda $410153
    sta $2233
    lda #$9F
    sta $2234
    lda $410150
    sta $2238
    lda $410151
    sta $2239
    lda $410154
    sta $2235
    lda $410155
    sta $2236
    lda #$01
    sta $2237
    lda #$20
    sta $220B
    stz $2230
    plb
    rep #$20
.a16
    rts
rpb_c0bc_rom_dma_end:
hc0bc_hle_end:

escbank8_physical_end:
