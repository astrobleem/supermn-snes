; esc_udiv — bank-$98 LOCAL copy of the escbank2 unsigned 32/16 divider (transpiled DIVU.w emits a
; same-bank `jsr esc_udiv`; jsr cannot cross banks). in: $50/$52 = dividend lo/hi (shifts up as the
; quotient forms in $50), $54 = divisor; out: $50=quotient, $94=remainder. Verbatim from escbank2.
esc_udiv:
    rep #$30
    stz $94
    ldy #$0020
esud_l:
    asl $50
    rol $52
    rol $94
    bcs esud_sub
    lda $94
    cmp $54
    bcc esud_no
esud_sub:
    lda $94
    sec
    sbc $54
    sta $94
    inc $50
esud_no:
    dey
    bne esud_l
    rts

; --- entry_d96t: SAME-BANK --table-convention variant of the $000D96 renderer for the F1 guarded
; direct-link from entry_1e7c0 (jsr (a4)): the $92 entry_d96 is an OLD-convention body (extra
; prologue pushes + popped-PC jml inext exit) that CANNOT take a bridge-to-escape sentinel.
; Regen: transpile.py 000D96 --bank2 --table | sed FD->FB + entry_d96->entry_d96t.
; --- transpiled from $000D96 (60 instrs) by tools/transpile.py [bank1] ---
entry_d96t:
    rep #$30
    ; Hand-written hot renderer.  The generated body below is semantically sound
    ; for registers/RAM but spends most of its time rebuilding 32-bit addresses
    ; and calling rdw_ea_l for every sprite word.  This path directly maps the
    ; production ROM stream (68K $000000-$07FFFF -> SA-1 $C1-$C8) or a bounded
    ; work-RAM stream, and retains the generated body for every unusual layout.
    ;
    ; The guards precede all emulated-memory/register writes.  In particular,
    ; stack/source/output ranges are disjoint, so reading the two-word header
    ; before materializing LINK/MOVEM stack residue is observationally exact.
    lda $34              ; a5 must be the canonical $00F00000 work base
    beq hd96_g_a5lo
    jmp d96_cold
hd96_g_a5lo:
    lda $36
    cmp #$00F0
    beq hd96_g_a5hi
    jmp d96_cold
hd96_g_a5hi:
    lda $3E              ; caller frame must live wholly in work RAM
    cmp #$00F0
    beq hd96_g_spbank
    jmp d96_cold
hd96_g_spbank:
    lda $3C
    cmp #$0040           ; room for LINK + MOVEM residue below A7
    bcs hd96_g_splow
    jmp d96_cold
hd96_g_splow:
    cmp #$FFE0           ; return + seven-word argument frame cannot wrap
    bcc hd96_g_sphigh
    jmp d96_cold
hd96_g_sphigh:
    cmp #$1C00           ; keep the save frame away from the output planes
    bcc hd96_args
    cmp #$3000
    bcs hd96_args
    jmp d96_cold

hd96_args:
    tax
    lda $400004,x        ; [a7+4] output cursor / signed destination offset
    xba
    sta $88
    lda $400006,x        ; [a7+6] Y/attribute word
    xba
    sta $8A
    lda $400008,x        ; [a7+8] row Y
    xba
    sta $8C
    lda $40000A,x        ; [a7+A] row X
    xba
    sta $8E
    lda $40000C,x        ; [a7+C] frame pointer high word
    xba
    sta $96
    lda $40000E,x        ; [a7+E] frame pointer low word
    xba
    sta $94
    lda $400010,x        ; [a7+10] output capacity minus one
    xba
    sta $90

    ; Cursor is a byte offset into three $03FC-byte parallel output planes.
    lda $88
    and #$0001
    beq hd96_g_cursor_even
hd96_guard_fail:
    jmp d96_cold
hd96_g_cursor_even:
    lda $88
    bpl hd96_g_cursor_range
    cmp #$FF00                      ; bounded signed negative cursor (>= -$100)
    bcs hd96_g_cursor_range
    jmp d96_cold
hd96_g_cursor_range:
    lda $90
    bmi hd96_g_capacity             ; negative capacity performs no output stores
    cmp #$01FE                      ; at most 510 words when cursor == 0
    bcc hd96_g_capmax
    jmp d96_cold
hd96_g_capmax:
    inc a
    asl a
    clc
    adc $88
    ldx $88
    bpl hd96_g_sum_nonnegative
    bcs hd96_g_sum_nonnegative      ; negative cursor + output bytes crossed zero
    jmp d96_cold
hd96_g_sum_nonnegative:
    cmp #$03FD                      ; cursor + 2*(capacity+1) <= $03FC
    bcc hd96_g_capacity
    jmp d96_cold

hd96_g_capacity:
    lda $94
    sta $80                         ; native 24-bit source pointer low word
    lda $96
    cmp #$0008
    bcc hd96_source_rom
    cmp #$00F0
    beq hd96_source_work
    jmp d96_cold
hd96_source_rom:
    cmp #$0007                      ; reserve worst-case 32x32-word stream room
    bne hd96_source_rom_map
    lda $94
    cmp #$F7F0
    bcc hd96_source_rom_last_ok
    jmp d96_cold
hd96_source_rom_last_ok:
    lda $96
hd96_source_rom_map:
    clc
    adc #$00C1                     ; flat 68K ROM -> SA-1 $C1-$C8
    sta $82
    bra hd96_source_header
hd96_source_work:
    lda $94                         ; bounded above all three output planes
    cmp #$2A00
    bcs hd96_source_work_low
    jmp d96_cold
hd96_source_work_low:
    cmp #$3000
    bcc hd96_source_work_high
    jmp d96_cold
hd96_source_work_high:
    lda $3C                         ; a high synthetic stack must clear max stream end
    cmp #$1C00
    bcc hd96_source_work_stack_ok
    cmp #$3900
    bcs hd96_source_work_stack_ok
    jmp d96_cold
hd96_source_work_stack_ok:
    lda #$0040
    sta $82

hd96_source_header:
    jsr hd96_read_word              ; outer DBRA initial value
    sta $84
    cmp #$0020
    bcc hd96_outer_ok
    jmp d96_cold
hd96_outer_ok:
    jsr hd96_read_word              ; inner DBRA initial value
    sta $86
    cmp #$0020
    bcc hd96_header_ok
    jmp d96_cold

hd96_header_ok:
    ; Materialize the exact LINK/MOVEM save image.  MOVEM.W restoration later
    ; sign-extends D0-D6; preserving this residue is part of the 68K contract.
    lda $3C
    sec
    sbc #$0026
    tax
    lda $00                          ; D0-D6 words, ascending at A7-$26..A7-$1A
    xba
    sta $400000,x
    inx
    inx
    lda $04
    xba
    sta $400000,x
    inx
    inx
    lda $08
    xba
    sta $400000,x
    inx
    inx
    lda $0C
    xba
    sta $400000,x
    inx
    inx
    lda $10
    xba
    sta $400000,x
    inx
    inx
    lda $14
    xba
    sta $400000,x
    inx
    inx
    lda $18
    xba
    sta $400000,x
    inx
    inx
    lda $22                          ; A0-A4 longs, high word then low word
    xba
    sta $400000,x
    inx
    inx
    lda $20
    xba
    sta $400000,x
    inx
    inx
    lda $26
    xba
    sta $400000,x
    inx
    inx
    lda $24
    xba
    sta $400000,x
    inx
    inx
    lda $2A
    xba
    sta $400000,x
    inx
    inx
    lda $28
    xba
    sta $400000,x
    inx
    inx
    lda $2E
    xba
    sta $400000,x
    inx
    inx
    lda $2C
    xba
    sta $400000,x
    inx
    inx
    lda $32
    xba
    sta $400000,x
    inx
    inx
    lda $30
    xba
    sta $400000,x
    inx
    inx
    lda $3A                          ; LINK saved old A6 at A7-$04
    xba
    sta $400000,x
    inx
    inx
    lda $38
    xba
    sta $400000,x

    ; Keep the routine's live word registers and output pointers in native
    ; scratch.  D0-D6/A0-A4/A6 were saved above only to reproduce the exact
    ; dead stack image; leaving their architectural cells untouched removes
    ; nineteen BW-RAM reads from every return.  D7 is not in the original
    ; MOVEM mask, so its final low word is copied back at hd96_hot_done.
    lda #$00EA
    sec
    sbc $8C                          ; original $C(a6): screen X argument
    sta $8C                          ; scratch d1 = $EA - X
    lda #$1CF6
    clc
    adc $88
    sta $52                          ; scratch a4 = X plane
    lda #$20F2
    clc
    adc $88
    sta $50                          ; scratch a3 = Y/attribute plane
    lda #$24EE
    clc
    adc $88
    sta $9E                          ; scratch a2 = tile plane

    ; Two immutable 5x5 ROM shapes dominate the organic table calls.  Their
    ; exact capacities leave fill slots after every nonzero tile.  Specialize
    ; only when all five X rows and all nonzero Y columns are on screen; every
    ; other source/layout continues through the generic renderer unchanged.
    lda $96
    cmp #$0003
    bne hd96_outer_loop
    lda $90
    cmp #$0011
    bne hd96_outer_loop
    lda $8C                          ; row-0 X is already $EA - arg
    cmp #$0040                       ; row 4 must remain nonnegative
    bcc hd96_outer_loop
    cmp #$00FA
    bcs hd96_outer_loop
    lda $8E                          ; highest used column is +$40
    cmp #$0140
    bcs hd96_outer_loop
    lda $94
    cmp #$37F0
    bne hd96_shape_check_33c0a
    jmp hd96_shape_337f0
hd96_shape_check_33c0a:
    cmp #$3C0A
    bne hd96_outer_loop
    jmp hd96_shape_33c0a

hd96_outer_loop:
    lda #$00FA
    sta $9A                          ; d5 = hidden X unless d1 is in (-6,$FA)
    lda $8C
    bmi hd96_x_negative
    cmp #$00FA
    bcs hd96_x_ready
    bra hd96_x_visible
hd96_x_negative:
    cmp #$FFFB
    bcc hd96_x_ready
hd96_x_visible:
    sta $9A
hd96_x_ready:
    lda $9A
    sta $9C                          ; d6 = row X
    lda $86
    sta $94                          ; d2 = inner count
    asl a
    asl a
    asl a
    asl a                            ; d4 = d2 << 4 (temporary in A)
    sta $98
    lda $8E                          ; original $E(a6): screen Y argument
    clc
    adc $98
    sta $96                          ; scratch d3 = Y + inner*16
    bcc hd96_init_x_clear
    lda #$0001                      ; ADD.W is the last X setter before first tile
    sta $A2
    bra hd96_inner_loop
hd96_init_x_clear:
    stz $A2

hd96_inner_loop:
    lda $9C
    sta $9A                          ; d5 = row X for this sprite
    jsr hd96_read_word
    sta $98                          ; d4 = source tile word, (a1)+
    beq hd96_after_sprite

    lda $96                          ; clip Y outside signed (-16,384)
    bmi hd96_y_negative
    cmp #$0180
    bcc hd96_y_ready
    bra hd96_y_hidden
hd96_y_negative:
    cmp #$FFF1
    bcs hd96_y_ready
hd96_y_hidden:
    lda #$00FA
    sta $9A
hd96_y_ready:
    lda $90                          ; negative d7 exits before this sprite is emitted
    bpl hd96_emit
    jmp hd96_exit_negative

hd96_emit:
    lda $98
    clc
    adc #$A000
    ldx $9E
    xba
    sta $400000,x                    ; (a2)+ = tile+$A000
    inc $9E
    inc $9E

    lda $9A
    ldx $52
    xba
    sta $400000,x                    ; (a4)+ = clipped X
    inc $52
    inc $52

    lda $96
    and #$01FF
    ora $8A
    ldx $50
    xba
    sta $400000,x                    ; (a3)+ = (Y&$1FF)|attribute
    inc $50
    inc $50
    dec $90                          ; subq.w #1,d7 (X is superseded below)

hd96_after_sprite:
    lda $96
    sec
    sbc #$0010
    sta $96
    bcs hd96_d3_no_borrow
    lda #$0001                      ; SUBI.W borrow is 68K X=1
    sta $A2
    bra hd96_d3_x_done
hd96_d3_no_borrow:
    stz $A2
hd96_d3_x_done:
    dec $94                          ; DBRA d2
    lda $94
    cmp #$FFFF
    beq hd96_inner_done
    jmp hd96_inner_loop

hd96_inner_done:
    lda $8C
    sec
    sbc #$0010
    sta $8C
    bcs hd96_d1_no_borrow
    lda #$0001                      ; final row subtraction supplies exit X
    sta $A2
    bra hd96_d1_x_done
hd96_d1_no_borrow:
    stz $A2
hd96_d1_x_done:
    dec $84                          ; DBRA d0
    lda $84
    cmp #$FFFF
    beq hd96_rows_done
    jmp hd96_outer_loop

hd96_rows_done:
    lda $90
    bpl hd96_fill_setup
hd96_exit_negative:
    lda #$0001                      ; final TST.W d7: N=1,Z=V=C=0, X retained
    sta $70
    stz $60
    stz $72
    stz $6E
    jmp hd96_hot_done

hd96_fill_setup:
    lda #$00FA
    sta $84
hd96_fill_loop:
    lda $84
    ldx $52
    xba
    sta $400000,x
    inc $52
    inc $52
    dec $90                          ; DBRA d7
    lda $90
    cmp #$FFFF
    bne hd96_fill_loop
    stz $70                          ; final MOVE.W #$FA: N=Z=V=C=0, X retained
    stz $60
    stz $72
    stz $6E

hd96_hot_done:
    lda $90                          ; D7.w remains live across the original MOVEM
    sta $1C
    ; MOVEM.W sign-extends the restored D0-D6 low words.  Their low cells were
    ; never clobbered, so repair only the seven high words directly in DP.
    ldx #$0000
hd96_sign_extend:
    lda $00,x
    and #$8000
    beq hd96_sign_zero
    lda #$FFFF
hd96_sign_zero:
    sta $02,x
    inx
    inx
    inx
    inx
