; Read one big-endian word from the pre-mapped native 24-bit pointer at $80,
; advance it by two bytes, and return the logical 68K word in 16-bit A.
hd96_read_word:
    ldy #$0000
    sep #$20
    lda [$80],y
    xba
    iny
    lda [$80],y
    rep #$20
    pha
    lda $80
    clc
    adc #$0002
    sta $80
    bcc hd96_read_nowrap
    inc $82
hd96_read_nowrap:
    pla
    rts

; Guarded fixed-shape renderer.  The three output planes advance in parallel,
; so native Y is a shared byte offset into three direct-page long pointers.
; hd96_shape_emit receives row X in A, column Y in native X, and tile+$A000
; in $50.  The original tile order is retained exactly.
hd96_shape_prepare:
.a16
.i16
    lda $9E                          ; tile plane
    sta $54
    lda #$0040
    sta $56
    lda $52                          ; X plane
    sta $58
    lda #$0040
    sta $5A
    lda $50                          ; Y/attribute plane
    sta $5C
    lda #$0040
    sta $5E

    lda $8C
    sta $80                          ; row 0 X
    sec
    sbc #$0010
    sta $82                          ; row 1 X
    sec
    sbc #$0010
    sta $84                          ; row 2 X
    sec
    sbc #$0010
    sta $86                          ; row 3 X
    sec
    sbc #$0010
    sta $88                          ; row 4 X
    sec
    sbc #$0010                      ; final row SUBI.W supplies exit X
    bcs hd96_shape_x_clear
    lda #$0001
    sta $A2
    bra hd96_shape_x_done
hd96_shape_x_clear:
    stz $A2
hd96_shape_x_done:
    lda $8E
    clc
    adc #$0040
    sta $94                          ; source column 0 Y
    sec
    sbc #$0010
    sta $96                          ; source column 1 Y
    sec
    sbc #$0010
    sta $98                          ; source column 2 Y
    sec
    sbc #$0010
    sta $9A                          ; source column 3 Y
    sec
    sbc #$0010
    sta $9C                          ; source column 4 Y
    ldy #$0000
    rts

