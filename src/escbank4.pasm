    sta $1C
    lda $1C
    pha
    lda $3C
    sec
    sbc #$0002
    sta $3C
    lda $3E
    sbc #$0000
    sta $3E
    lda $3C
    tax
    pla
    xba
    sta $400000,x
    xba
    lda $34
    clc
    adc #$351E
    tax
    lda $400000,x
    xba
    pha
    lda $3C
    sec
    sbc #$0002
    sta $3C
    lda $3E
    sbc #$0000
    sta $3E
    lda $3C
    tax
    pla
