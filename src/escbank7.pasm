; <<< ESCBANK7_ENTRY_INIT_BODIES <<<

; ============================================================================
; Bank-$00 absolute-long JSR scan continued from bank $92's fixed jx_b0 stub.
;
; Entry state is identical to jah2_ext: target low word in $52, the genuine
; caller return in $42:$54, and [JSL return, saved flags] on the native stack.
; Existing callable escapes retain their original call-convention handoff.
; $091E is a table-convention body, so explicitly push the genuine 68K return
; before entering it.  A miss exactly reproduces jx_real (PLP; JML jsrabs_hook).
; ============================================================================
    .org $FB00
jah2_b0_ext:
    lda $52
    cmp #$091E
    bne jx9_91e
    inc $0764
    plp
    pla
    lda $42
    sta $56
    jsl.l push32_l
    jmp entry_91et
jx9_91e:
    ; >>> JAH2_EXT_SCAN — deploy_escape inserts bank-$00 scan arms here <<<
    cmp #$C9A6
    bne jx9_c9a6
    ldx $073E
    bne jx9_c9a6
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_c9a6
jx9_c9a6:
    cmp #$1008
    bne jx9_1008
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_1008
jx9_1008:
    cmp #$2DF0
    bne jx9_2df0
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_2df0
jx9_2df0:
    cmp #$4178
    bne jx9_4178
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_4178
jx9_4178:
    cmp #$3A92
    bne jx9_3a92
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_3a92
jx9_3a92:
    cmp #$096A
    bne jx9_96a
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_96a
jx9_96a:
    cmp #$09EA
    bne jx9_real
    inc $0764
    plp
    pla
    lda $54
    sta $40
    jml.l entry_9ea
jx9_real:
    plp
    jml.l jsrabs_hook
jah2_b0_ext_end:

; ============================================================================
; Guarded exact $0029B6 tilemap callback used by the $C0BC gameplay initializer.
;
; This is the $29B6 analogue of bank $99's differential-tested $2742 HLE.  It
; copies 28 packed-ROM words into the two interleaved $E0 shadow planes, applies
; $29B6's binary $9000/tile-base attribute rule, reproduces all LINK/MOVEM stack
; residue, restores/sign-extends D0-D6, leaves D7=4, materializes the exact final
; X/N/Z/V/C, and consumes the table caller's real/sentinel return.  Any stack,
; row, or source shape outside the proved mapping reaches the established
; legal interpreter before architectural state changes.
; ============================================================================
    .org $FC00
entry_29b6_fast:
.a16
.i16
    rep #$30

    lda $3E
    cmp #$00F0
    bne h29b6_reject_near
    lda $3C
    cmp #$0026
    bcc h29b6_reject_near
    cmp #$FFEF
    bcs h29b6_reject_near
    tax

    ; Signed row must keep E00800+row and E00C00+row inside bank $E0.
    lda $400004,x
    xba
    sta $84
    cmp #$8000
    bcc h29b6_row_ok
    cmp #$F800
    bcc h29b6_reject_near
h29b6_row_ok:

    ; All 56 source bytes must live in the packed 512 KiB arcade image.
    lda $40000C,x
    xba
    sta $86
    cmp #$0008
    bcs h29b6_reject_near
    cmp #$0007
    bne h29b6_fast
    lda $40000E,x
    xba
    cmp #$FFC9
    bcc h29b6_fast
h29b6_reject_near:
    jmp h29b6_reject

h29b6_fast:
    lda #$FFFF
    sta $410144                  ; invalidate the $20E8 final-payload provenance
    lda #$0000
    sta $41014A                  ; direct row write invalidates prepared-image provenance
    lda $84
    bit #$0001
    bne h29b6_bg_unknown
    cmp #$03CA                   ; 28 words through offset $03FE
    bcs h29b6_bg_unknown
    tax
    lda #$001C
    jsr producer_bg_append_range
    bra h29b6_bg_published
h29b6_bg_unknown:
    lda #$FFFF                   ; retain the old full-scan safety net
    sta $41014C
h29b6_bg_published:
    lda #$0001
    sta $410140                  ; direct bank-$41 stores bypass map_snes
    ldx $3C
    lda $400006,x
    xba
    sta $82                         ; tile-base argument
    lda $40000E,x
    xba
    sta $66                         ; packed-ROM low word
    lda $86
    clc
    adc #$00C1
    sta $68                         ; packed-ROM long-indirect bank
    lda $84
    clc
    adc #$0800
    sta $84                         ; first bank-$41 shadow offset

    ldx $84
    ldy #$0000
    stz $8E
h29b6_column:
    lda #$000D
    sta $8C
h29b6_copy_word:
    lda [$66],y
    xba
    sta $80
    and #$1FFF
    xba
    sta $414000,x
    lda $80
    lsr a
    lsr a
    and #$F800
    beq h29b6_tile_base
    lda #$9000
    bra h29b6_attr_ready
h29b6_tile_base:
    lda $82
h29b6_attr_ready:
    xba
    sta $414400,x
    inx
    inx
    inx
    inx
    iny
    iny
    dec $8C
    bpl h29b6_copy_word
    lda $8E
    bne h29b6_copy_done
    inc $8E
    lda $84
    inc a
    inc a
    tax
    bra h29b6_column
h29b6_copy_done:

    ; Exact 38-byte LINK/MOVEM residue below the unchanged entry A7.
    lda $3C
    sec
    sbc #$0026
    tax
    lda $00
    xba
    sta $400000,x
    inx
    inx
    lda $04
    xba
    sta $400000,x
    inx
    inx
    lda $08
    xba
    sta $400000,x
    inx
    inx
    lda $0C
    xba
    sta $400000,x
    inx
    inx
    lda $10
    xba
    sta $400000,x
    inx
    inx
    lda $14
    xba
    sta $400000,x
    inx
    inx
    lda $18
    xba
    sta $400000,x
    inx
    inx
    lda $22
    xba
    sta $400000,x
    inx
    inx
    lda $20
    xba
    sta $400000,x
    inx
    inx
    lda $26
    xba
    sta $400000,x
    inx
    inx
    lda $24
    xba
    sta $400000,x
    inx
    inx
    lda $2A
    xba
    sta $400000,x
    inx
    inx
    lda $28
    xba
    sta $400000,x
    inx
    inx
    lda $2E
    xba
    sta $400000,x
    inx
    inx
    lda $2C
    xba
    sta $400000,x
    inx
    inx
    lda $32
    xba
    sta $400000,x
    inx
    inx
    lda $30
    xba
    sta $400000,x
    inx
    inx
    lda $3A
    xba
    sta $400000,x
    inx
    inx
    lda $38
    xba
    sta $400000,x

    ; MC68000 MOVEM.W sign-extends each restored data register.
    ldx #$0000
    ldy #$0007
h29b6_sign_extend:
    lda $00,x
    bpl h29b6_sign_positive
    lda #$FFFF
    bra h29b6_sign_store
h29b6_sign_positive:
    lda #$0000
h29b6_sign_store:
    sta $02,x
    inx
    inx
    inx
    inx
    dey
    bne h29b6_sign_extend
    lda #$0004
    sta $1C
    stz $1E

    ; Final LSR.W #2 controls X; final MOVE.W controls N/Z and clears V/C.
    ldy #$0036
    lda [$66],y
    xba
    sta $88
    and #$0002
    lsr a
    sta $A2                         ; X = original source bit 1
    lda $88
    lsr a
    lsr a
    and #$F800
    beq h29b6_final_base
    lda #$9000
    bra h29b6_final_ready
h29b6_final_base:
    lda $82
h29b6_final_ready:
    sta $80
    beq h29b6_final_zero
    stz $60
    bra h29b6_final_n
h29b6_final_zero:
    lda #$0001
    sta $60
h29b6_final_n:
    lda $80
    and #$8000
    sta $70
    stz $72
    stz $6E

    ; Faithful table RTS through the bank-aware sentinel router.
    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    lda $3E
    adc #$0000
    sta $3E
    jml.l ors_pre

h29b6_reject:
    ; Starting again at $29B6 would be recaptured by its established xlat
    ; table entry.  Execute only LINK.W A6,#0 exactly, then let the legal
    ; interpreter own every remaining instruction from $29BA onward.
    lda $3C
    sec
    sbc #$0004
    sta $3C
    tax
    lda $3E
    sbc #$0000
    sta $3E
    lda $3A
    xba
    sta $400000,x
    inx
    inx
    lda $38
    xba
    sta $400000,x
    lda $3C
    sta $38
    lda $3E
    sta $3A
    lda #$29BA
    sta $40
    stz $42
    jml.l inext
entry_29b6_fast_end:

escbank7_end:
