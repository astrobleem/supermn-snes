; <<< ESCBANK7_DA_TASK_BODIES <<<

; Compact direct-dispatch island for the sparse bank-$00 $D7/$D8/$D9/$DA/$DC
; pages.  A dense $96 xlat sub-table consumes 768 bytes per page, while these
; eight entries need only the exact comparisons below.  $94:F900 admits only
; those four high-byte pages; an unknown PC rejoins the ordinary lookup/miss
; path with the original $40/$42 target intact.
    .org $DA00
xlat_da_dispatch:
    rep #$30
    lda $42
    cmp #$0002
    beq xdd_bank2
    cmp #$0000
    bne xdd_miss
    lda $40
    cmp #$D7BE
    beq xdd_d7be
    cmp #$091E
    beq xdd_91e
    cmp #$C0BC
    beq xdd_c0bc
    cmp #$DA72
    beq xdd_da72
    cmp #$D8B4
    beq xdd_d8b4
    cmp #$D9CC
    beq xdd_d9cc
    cmp #$DC44
    beq xdd_dc44
    cmp #$DA44
    beq xdd_da44
    cmp #$DA9E
    beq xdd_da9e
    cmp #$DAF4
    beq xdd_daf4
    cmp #$DC2E
    beq xdd_dc2e
    ; Pages $76/$77 hold the one-shot task fan-out and its genuine-return
    ; continuations.  Keep their exact scan in the same bank as the bodies.
    xba
    and #$00FF
    cmp #$0076
    bcc xdd_miss
    cmp #$0078
    bcs xdd_miss
    jml.l $9EA700
xdd_miss:
    jml.l xd_table
xdd_d7be:
    jml.l $9ED800       ; entry_d7be (pinned in escbank8)
xdd_91e:
    jmp entry_91et
xdd_c0bc:
    jmp entry_c0bc
xdd_da72:
    jmp entry_da72
xdd_d8b4:
    jmp entry_d8b4
xdd_d9cc:
    jmp entry_d9cct
xdd_dc44:
    jmp entry_dc44t
xdd_da44:
    jmp entry_da44t
xdd_da9e:
    jmp entry_da9et
xdd_daf4:
    jmp entry_daf4t
xdd_dc2e:
    jmp entry_dc2et
xdd_bank2:
    lda $40
    cmp #$4D28
    bne xdd_bank2_24d64
    jml.l $9E9800       ; entry_24d28 (pinned in escbank8)
xdd_bank2_24d64:
    cmp #$4D64
    bne xdd_bank2_existing
    jml.l $9E9C00       ; entry_24d64 (pinned in escbank8)
xdd_bank2_existing:
    cmp #$4920
    beq xdd_24920
    cmp #$4956
    beq xdd_24956
    cmp #$4AA8
    beq xdd_24aa8
    cmp #$8F92
    beq xdd_28f92
    cmp #$A190
    beq xdd_2a190
    cmp #$AD4C
    beq xdd_2ad4c
    cmp #$A86E
    bne xdd_miss
xdd_2a86e:
    jmp entry_2a86et
xdd_2ad4c:
    jmp entry_2ad4ct
xdd_24aa8:
    jmp entry_24aa8t
xdd_28f92:
    jmp entry_28f92t
xdd_2a190:
    jml.l entry_2a190
xdd_24920:
    jmp entry_24920t
xdd_24956:
    jmp entry_24956t
xlat_da_dispatch_end:

; ============================================================================
; Guarded fusion of the stable $00CD1A sprite-clear chain.
;
; entry_ce58 has already pushed its bank-$FE continuation and set the emulated
; PC to $00CD1A before jumping here.  CD1A tests the low four bits at A5+$2A49
; and conditionally calls the function pointer at A5+$1C9A four times.  In the
; proven gameplay shape that pointer is $00000FB8, whose complete effect per
; call is a nineteen-word fill plus register/stack residue.  Implement all
; sixteen skip patterns, including no calls at all.  Avoid interpreter bridges
; only when every address predicate is exact; otherwise restart $00CD1A before
; its first instruction with untouched emulated state.
;
; The public address is pinned because bank $92 is assembled before this bank
; and therefore jumps to literal $9D:E000.  The ROM packer verifies that jump,
; this entry, the free seam before it, and the bank end after it.
; ============================================================================
    .org $E000
hcd1a_fb8:
    rep #$30
    .a16
    .i16

    ; Direct work-RAM assumptions used by every load/store below.
    lda $34
    bne hcd1a_cold
    lda $36
    cmp #$00F0
    bne hcd1a_cold
    lda $3E
    cmp #$00F0
    bne hcd1a_cold
    lda $3C
    cmp #$0014
    bcc hcd1a_cold
    cmp #$FFFC
    bcs hcd1a_cold

    ; All four dynamic calls must resolve to the exact native fill helper.
    ldx #$1C9A
    lda $400000,x
    bne hcd1a_cold
    lda $400002,x
    cmp #$B80F              ; raw LE view of emulated BE word $0FB8
    bne hcd1a_cold

    bra hcd1a_hot

hcd1a_cold:
    lda #$CD1A
    sta $40
    stz $42
    jml.l inext

hcd1a_hot:
    ; Convert the raw little-endian native view back to the emulated word and
    ; retain only the low flag byte that the original four BTST instructions
    ; observe.  $9A is interpreter scratch, not architectural 68K state.
    ldx #$2A48
    lda $400000,x
    xba
    and #$00FF
    sta $9A

    ; Raw $FA00 stores are emulated big-endian $00FA words.  Each executed
    ; callback uses DBRA count $0012, hence nineteen stores per region.
    lda $9A
    and #$0001
    bne hcd1a_skip_1
    lda #$FA00
    ldx #$1EAC             ; $1CF6 + $01B6
    ldy #$0013
hcd1a_fill_1:
    sta $400000,x
    inx
    inx
    dey
    bne hcd1a_fill_1

hcd1a_skip_1:
    lda $9A
    and #$0002
    bne hcd1a_skip_2
    lda #$FA00
    ldx #$20A2             ; $1CF6 + $03AC
    ldy #$0013
hcd1a_fill_2:
    sta $400000,x
    inx
    inx
    dey
    bne hcd1a_fill_2

hcd1a_skip_2:
    lda $9A
    and #$0004
    bne hcd1a_skip_3
    lda #$FA00
    ldx #$1ED4             ; $1CF6 + $01DE
    ldy #$0013
hcd1a_fill_3:
    sta $400000,x
    inx
    inx
    dey
    bne hcd1a_fill_3

hcd1a_skip_3:
    lda $9A
    and #$0008
    bne hcd1a_skip_4
    lda #$FA00
    ldx #$20CA             ; $1CF6 + $03D4
    ldy #$0013
hcd1a_fill_4:
    sta $400000,x
    inx
    inx
    dey
    bne hcd1a_fill_4

hcd1a_skip_4:
    ; Select the last callback that actually ran.  The calls reuse the same
    ; twenty bytes below A7, so only its return PC and offset distinguish the
    ; final LINK/MOVEM/JSR/argument residue.  If all four bits were set, CD1A
    ; made no call and must leave D7, A0, and below-stack bytes untouched.
    lda $9A
    and #$0008
    beq hcd1a_residue_4
    lda $9A
    and #$0004
    beq hcd1a_residue_3
    lda $9A
    and #$0002
    beq hcd1a_residue_2
    lda $9A
    and #$0001
    beq hcd1a_residue_1
    jmp hcd1a_clear

hcd1a_residue_1:
    lda #$30CD             ; return $CD30, byte-swapped
    sta $9C
    lda #$B601             ; offset $01B6, byte-swapped
    sta $9E
    bra hcd1a_residue
hcd1a_residue_2:
    lda #$4ACD             ; return $CD4A, byte-swapped
    sta $9C
    lda #$AC03             ; offset $03AC, byte-swapped
    sta $9E
    bra hcd1a_residue
hcd1a_residue_3:
    lda #$64CD             ; return $CD64, byte-swapped
    sta $9C
    lda #$DE01             ; offset $01DE, byte-swapped
    sta $9E
    bra hcd1a_residue
hcd1a_residue_4:
    lda #$7ECD             ; return $CD7E, byte-swapped
    sta $9C
    lda #$D403             ; offset $03D4, byte-swapped
    sta $9E

hcd1a_residue:
    lda $3C
    sec
    sbc #$0014
    tax
    lda $02                ; saved D0 high word
    xba
    sta $400000,x
    lda $00                ; saved D0 low word
    xba
    sta $400002,x
    lda #$0000             ; saved A0 high word ($00000FB8)
    sta $400004,x
    lda #$B80F             ; saved A0 low word, byte-swapped
    sta $400006,x
    lda $3A                ; saved A6 high word
    xba
    sta $400008,x
    lda $38                ; saved A6 low word
    xba
    sta $40000A,x
    lda #$0000             ; final indirect-JSR return high word
    sta $40000C,x
    lda $9C                ; final return low word, byte-swapped
    sta $40000E,x
    lda $9E                ; final offset, byte-swapped
    sta $400010,x
    lda #$1200             ; final DBRA count $0012, byte-swapped
    sta $400012,x

    ; Observable register state after at least one $0FB8 call.  D0/A6 and
    ; D7's high word remain untouched.
    lda #$FFFF
    sta $1C
    lda #$0FB8
    sta $20
    stz $22

hcd1a_clear:
    ; Every skip pattern ends with CLR.W $2A48(A5).
    lda #$0000
    sta $402A48
    lda #$0001
    sta $60                ; Z=1
    stz $6E                ; C=0 (X at $A2 is unchanged)
    stz $70                ; N=0
    stz $72                ; V=0

    ; Faithful CD1A RTS: pop entry_ce58's existing bank-$FE continuation and
    ; let ors_pre route it back to brce58_1 in bank $92.
    ldx $3C
    lda $400000,x
    xba
    sta $42
    lda $400002,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre
hcd1a_fb8_end:

; ============================================================================
; hce4_shape_try_ext — guarded late-game immutable-shape renderer.
;
; Bank $95's first CE4 island handles the six shapes captured near round
; start.  A continuous post-ordering Right+B capture found four more stable
; ROM streams ($00CA8E, $033F6E, $042A52, $042A9E) plus $03762E with every
; nonzero column above the top of the screen.  The first four consume their
; exact output capacity on their last nonzero tile, so their final D7/CCR/X
; state is invariant.  $03762E retains the original fill path and derives X
; from the final row subtraction.
;
; Entry is a bank-preserving JML from hce4_shape_miss while the original
; bank-$94 JSL return remains on the native stack.  hce4_entry has already
; validated/mapped the source, read its header, materialized the exact
; LINK/MOVEM residue, and prepared $88/$8A/$90/$92/$94/$96/$98.  Every miss
; below performs only loads/comparisons and returns C=0, leaving all scratch
; needed by the generic loop untouched.  Every hit writes the same three
; output streams, materializes final D7/CCR/X, and returns C=1 to the common
; bank-$94 epilogue.
; ============================================================================
    .org $E400
.a16
.i16
hce4_shape_try_ext:
    rep #$30
    lda $82
    cmp #$00C5
    bne hce4_ext_check_c4
    lda $80
    cmp #$2A56                       ; source $042A52 after its header
    bne hce4_ext_check_42a9e
    jmp hce4_ext_guard_42a52
hce4_ext_check_42a9e:
    cmp #$2AA2                       ; source $042A9E after its header
    bne hce4_ext_miss
    jmp hce4_ext_guard_42a9e

hce4_ext_check_c4:
    cmp #$00C4
    bne hce4_ext_check_c1
    lda $80
    cmp #$3F72                       ; source $033F6E after its header
    bne hce4_ext_check_3762e
    jmp hce4_ext_guard_33f6e
hce4_ext_check_3762e:
    cmp #$7632                       ; source $03762E after its header
    bne hce4_ext_miss
    jmp hce4_ext_guard_3762e_hidden

hce4_ext_check_c1:
    cmp #$00C1
    bne hce4_ext_miss
    lda $80
    cmp #$CA92                       ; source $00CA8E after its header
    bne hce4_ext_miss
    jmp hce4_ext_guard_ca8e

hce4_ext_miss:
    clc
    rtl

; $042A52/$042A9E: six rows, five potentially live columns.  $88 is already
; d1=$EA-screenX; requiring $50..$F9 keeps every emitted row X visible.
hce4_ext_guard_42a52:
    lda $92
    cmp #$0012
    bne hce4_ext_guard_42a52_miss
    lda $88
    cmp #$0050
    bcc hce4_ext_guard_42a52_miss
    cmp #$00FA
    bcs hce4_ext_guard_42a52_miss
    lda $8A
    cmp #$0140                       ; column four remains below $0180
    bcs hce4_ext_guard_42a52_miss
    stz $6A                          ; base $042A52 variant
    jmp hce4_ext_shape_42a
hce4_ext_guard_42a52_miss:
    jmp hce4_ext_miss

hce4_ext_guard_42a9e:
    lda $92
    cmp #$0012
    bne hce4_ext_guard_42a9e_miss
    lda $88
    cmp #$0050
    bcc hce4_ext_guard_42a9e_miss
    cmp #$00FA
    bcs hce4_ext_guard_42a9e_miss
    lda $8A
    cmp #$0140
    bcs hce4_ext_guard_42a9e_miss
    lda #$0001
    sta $6A                          ; alternate $042A9E variant
    jmp hce4_ext_shape_42a
hce4_ext_guard_42a9e_miss:
    jmp hce4_ext_miss

; $033F6E: two rows by three columns; all six cells are nonzero.
hce4_ext_guard_33f6e:
    lda $92
    cmp #$0005
    bne hce4_ext_guard_33f6e_miss
    lda $88
    cmp #$0010
    bcc hce4_ext_guard_33f6e_miss
    cmp #$00FA
    bcs hce4_ext_guard_33f6e_miss
    lda $8A
    cmp #$0160                       ; column two remains below $0180
    bcs hce4_ext_guard_33f6e_miss
    jmp hce4_ext_shape_33f6e
hce4_ext_guard_33f6e_miss:
    jmp hce4_ext_miss

; $03762E has nonzero cells only in columns one and two.  For original Y <=
; -48, both columns are above the screen (less than -15) and therefore
; emit hidden X=$FA while retaining their wrapped nine-bit Y/attribute words.
hce4_ext_guard_3762e_hidden:
    lda $92
    cmp #$000F
    bne hce4_ext_guard_3762e_hidden_miss
    lda $8A
    cmp #$8000
    bcc hce4_ext_guard_3762e_hidden_miss
    cmp #$FFD1
    bcs hce4_ext_guard_3762e_hidden_miss
    jmp hce4_ext_shape_3762e_hidden
hce4_ext_guard_3762e_hidden_miss:
    jmp hce4_ext_miss

; $00CA8E: one row by four columns; all four cells are nonzero.
hce4_ext_guard_ca8e:
    lda $92
    cmp #$0003
    bne hce4_ext_guard_ca8e_miss
    lda $88
    cmp #$00FA
    bcs hce4_ext_guard_ca8e_miss
    lda $8A
    cmp #$0150                       ; column three remains below $0180
    bcs hce4_ext_guard_ca8e_miss
    jmp hce4_ext_shape_ca8e
hce4_ext_guard_ca8e_miss:
    jmp hce4_ext_miss

; Copy the three output pointers, derive six row-X and six column-Y words,
; and start a shared emitted-tile byte offset at zero.
hce4_ext_prepare:
    lda $98
    sta $54                          ; tile plane
    lda #$0040
    sta $56
    lda $94
    sta $58                          ; X plane
    lda #$0040
    sta $5A
    lda $96
    sta $5C                          ; Y/attribute plane
    lda #$0040
    sta $5E

    lda $88
    sta $80                          ; row 0
    sec
    sbc #$0010
    sta $82                          ; row 1
    sec
    sbc #$0010
    sta $84                          ; row 2
    sec
    sbc #$0010
    sta $86                          ; row 3
    sec
    sbc #$0010
    sta $88                          ; row 4
    sec
    sbc #$0010
    sta $8C                          ; row 5

    lda $8A
    sta $9A                          ; column 0
    clc
    adc #$0010
    sta $9C                          ; column 1
    clc
    adc #$0010
    sta $9E                          ; column 2
    clc
    adc #$0010
    sta $50                          ; column 3
    clc
    adc #$0010
    sta $52                          ; column 4
    clc
    adc #$0010
    sta $64                          ; column 5
    ldy #$0000
    rts

; $033F6E: [0730 0731 0732] / [0733 0734 0735].
hce4_ext_shape_33f6e:
    jsr hce4_ext_prepare
    lda $80
    sta $68
    lda #$2730
    ldx $9A
    jsr hce4_ext_emit
    lda #$2731
    ldx $9C
    jsr hce4_ext_emit
    lda #$2732
    ldx $9E
    jsr hce4_ext_emit
    lda $82
    sta $68
    lda #$2733
    ldx $9A
    jsr hce4_ext_emit
    lda #$2734
    ldx $9C
    jsr hce4_ext_emit
    lda #$2735
    ldx $9E
    jsr hce4_ext_emit
    jmp hce4_ext_exhausted

; $00CA8E: E07D-E080 wrap through the renderer's ADD.W #$2000.
hce4_ext_shape_ca8e:
    jsr hce4_ext_prepare
    lda $80
    sta $68
    lda #$007D
    ldx $9A
    jsr hce4_ext_emit
    lda #$007E
    ldx $9C
    jsr hce4_ext_emit
    lda #$007F
    ldx $9E
    jsr hce4_ext_emit
    lda #$0080
    ldx $50
    jsr hce4_ext_emit
    jmp hce4_ext_exhausted

; $03762E negative-Y class: all eight live cells emit hidden X=$FA.
hce4_ext_shape_3762e_hidden:
    jsr hce4_ext_prepare
    lda #$00FA
    sta $68
    lda #$2A76
    ldx $9C
    jsr hce4_ext_emit
    lda #$2A77
    ldx $9E
    jsr hce4_ext_emit
    lda #$2A78
    ldx $9C
    jsr hce4_ext_emit
    lda #$2A79
    ldx $9E
    jsr hce4_ext_emit
    lda #$2A7A
    ldx $9C
    jsr hce4_ext_emit
    lda #$2A7B
    ldx $9E
    jsr hce4_ext_emit
    lda #$2A7C
    ldx $9C
    jsr hce4_ext_emit
    lda #$2A7D
    ldx $9E
    jsr hce4_ext_emit

    ; The completed fourth row performs one final d1 subtraction before the
    ; original fill loop.  Preserve its borrow as X.
    lda $86
    sec
    sbc #$0010
    bcs hce4_ext_3762e_x_clear
    lda #$0001
    sta $A2
    bra hce4_ext_3762e_x_done
hce4_ext_3762e_x_clear:
    stz $A2
hce4_ext_3762e_x_done:
    ldx #$0007                       ; capacity 16 - eight live = eight fills
    jmp hce4_ext_fill

; $042A52 and $042A9E share rows zero, three, and four.  $6A selects the two
; immutable row-one/row-two tile variants.
hce4_ext_shape_42a:
    jsr hce4_ext_prepare
    lda $80
    sta $68
    lda #$21A7
    ldx $9C
    jsr hce4_ext_emit
    lda #$21A8
    ldx $9E
    jsr hce4_ext_emit
    lda #$21A9
    ldx $50
    jsr hce4_ext_emit
    lda #$21AA
    ldx $52
    jsr hce4_ext_emit

    lda $6A
    beq hce4_ext_shape_42a52_middle
    jmp hce4_ext_shape_42a9e_middle

hce4_ext_shape_42a52_middle:
    lda $82
    sta $68
    lda #$21AB
    ldx $9A
    jsr hce4_ext_emit
    lda #$21AC
    ldx $9C
    jsr hce4_ext_emit
    lda #$21AD
    ldx $9E
    jsr hce4_ext_emit
    lda #$21AE
    ldx $50
    jsr hce4_ext_emit
    lda $84
    sta $68
    lda #$21AF
    ldx $9A
    jsr hce4_ext_emit
    lda #$21B0
    ldx $9C
    jsr hce4_ext_emit
    jmp hce4_ext_shape_42a_middle_done

hce4_ext_shape_42a9e_middle:
    lda $82
    sta $68
    lda #$21BA
    ldx $9A
    jsr hce4_ext_emit
    lda #$21BB
    ldx $9C
    jsr hce4_ext_emit
    lda #$21BC
    ldx $9E
    jsr hce4_ext_emit
    lda #$21AE
    ldx $50
    jsr hce4_ext_emit
    lda $84
    sta $68
    lda #$21BD
    ldx $9A
    jsr hce4_ext_emit
    lda #$21BE
    ldx $9C
    jsr hce4_ext_emit

hce4_ext_shape_42a_middle_done:
    lda #$21B1
    ldx $9E
    jsr hce4_ext_emit
    lda #$21B2
    ldx $50
    jsr hce4_ext_emit
    lda #$21B3
    ldx $52
    jsr hce4_ext_emit

    lda $86
    sta $68
    lda #$21B4
    ldx $9A
    jsr hce4_ext_emit
    lda #$21B5
    ldx $9C
    jsr hce4_ext_emit
    lda #$21B6
    ldx $9E
    jsr hce4_ext_emit
    lda #$21B7
    ldx $50
    jsr hce4_ext_emit

    lda $88
    sta $68
    lda #$21B8
    ldx $9A
    jsr hce4_ext_emit
    lda #$21B9
    ldx $9E
    jsr hce4_ext_emit
    jmp hce4_ext_exhausted

; A=tile+attribute-base, native X=column Y, $68=row X, native Y=plane offset.
hce4_ext_emit:
    xba
    sta [$54],y
    lda $68
    xba
    sta [$58],y
    txa
    and #$01FF
    ora $90
    xba
    sta [$5C],y
    iny
    iny
    rts

; The four new shapes exhaust D7 on their final emitted tile.  SUBQ.W leaves
; N/C/X set, Z/V clear, and d7.w=$FFFF.
hce4_ext_exhausted:
    lda #$FFFF
    sta $92
    lda #$0001
    sta $70
    sta $6E
    sta $A2
    stz $60
    stz $72
    sec
    rtl

; Fill the remaining X-plane slots for the non-exhausting hidden $03762E
; class.  The last MOVE.W leaves N/Z/V/C clear and preserves X above.
hce4_ext_fill:
    lda #$00FA
    xba
hce4_ext_fill_loop:
    sta [$58],y
    iny
    iny
    dex
    bpl hce4_ext_fill_loop
    lda #$FFFF
    sta $92
    stz $70
    stz $60
    stz $72
    stz $6E
    sec
    rtl
hce4_shape_try_ext_end:

; ============================================================================
; $025110 stage-2 overlap response continuation.
;
; h25110_stage2_try reaches this body only after proving the canonical one-
; outer layout and all four inclusive signed rectangle overlap tests.  Native
; X is the current inner record, native Y is the remaining DBRA count, and
; $50/$52/$54/$56 hold the outer rectangle.  Reproduce the retained 68000
; response algorithm exactly, including conditional C/D byte writes, E-word
; type propagation, D0/D1 residue, and X.  Rectangle/filter fields never
; change, so returning to the guarded scan is equivalent to the original
; nested loop.  No unproved entry reaches this island.
; ============================================================================
    .org $E800
.a16
.i16
h25110_stage2_overlap:
    rep #$30
    stx $80                          ; current inner record

    ; X axis: D0=inner.x1, D1=inner.x2.  XOR $8000 maps signed comparisons
    ; to the native unsigned order without changing either architected word.
    ldx $80
    lda $400002,x
    xba
    sta $00
    eor #$8000
    sta $82
    lda $50
    eor #$8000
    sta $84
    lda $82
    cmp $84
    bcc h25s2_overlap_x_left

    ldx $80
    lda $400004,x
    xba
    sta $04
    eor #$8000
    sta $82
    lda $52
    eor #$8000
    sta $84
    lda $82
    cmp $84
    bcs h25s2_overlap_x_right_response
    jmp h25s2_overlap_x_clear

    ; Inner begins at/right of outer and reaches its right edge.
h25s2_overlap_x_right_response:
    lda $00
    sec
    sbc $52
    sta $00
    jsr h25s2_x_from_sub
    lda $00
    sec
    sbc #$0001
    sta $00
    jsr h25s2_x_from_sub
    ldx #$3A54
    lda $40000E,x
    xba
    bne h25s2_overlap_x_right_inner
    sep #$20
    lda $00
    sta $40000C,x
    rep #$20
h25s2_overlap_x_right_inner:
    ldx $80
h25s2_overlap_x_right_store_inner:
    lda $00
    eor #$FFFF
    inc a
    sta $00
    jsr h25s2_x_from_nonzero
    sep #$20
    lda $00
    sta $40000C,x
    rep #$20
    jmp h25s2_overlap_y_begin

h25s2_overlap_x_left:
    ldx $80
    lda $400004,x
    xba
    sta $04
    eor #$8000
    sta $82
    lda $52
    eor #$8000
    sta $84
    lda $82
    cmp $84
    beq h25s2_overlap_x_left_response
    bcs h25s2_overlap_x_clear
h25s2_overlap_x_left_response:
    lda $04
    sec
    sbc $50
    sta $04
    jsr h25s2_x_from_sub
    lda $04
    clc
    adc #$0001
    sta $04
    jsr h25s2_x_from_add
    ldx #$3A54
    lda $40000E,x
    xba
    bne h25s2_overlap_x_left_inner
    sep #$20
    lda $04
    sta $40000C,x
    rep #$20
h25s2_overlap_x_left_inner:
    ldx $80
    lda $04
    eor #$FFFF
    inc a
    sta $04
    jsr h25s2_x_from_nonzero
    sep #$20
    lda $04
    sta $40000C,x
    rep #$20
    jmp h25s2_overlap_y_begin

h25s2_overlap_x_clear:
    ldx #$3A54
    lda $40000E,x
    xba
    bne h25s2_overlap_x_clear_inner
    sep #$20
    .a8
    lda #$00
    sta $40000C,x
    rep #$20
    .a16
h25s2_overlap_x_clear_inner:
    ldx $80
    sep #$20
    .a8
    lda #$00
    sta $40000C,x
    rep #$20
    .a16

h25s2_overlap_y_begin:
    ; Y axis mirrors the original X-axis topology at offsets +6/+8/+D.
    ldx $80
    lda $400006,x
    xba
    sta $00
    eor #$8000
    sta $82
    lda $54
    eor #$8000
    sta $84
    lda $82
    cmp $84
    bcc h25s2_overlap_y_above

    ldx $80
    lda $400008,x
    xba
    sta $04
    eor #$8000
    sta $82
    lda $56
    eor #$8000
    sta $84
    lda $82
    cmp $84
    bcs h25s2_overlap_y_lower_response
    jmp h25s2_overlap_y_clear

    ; Inner begins at/below outer and reaches its lower edge.
h25s2_overlap_y_lower_response:
    lda $00
    sec
    sbc $56
    sta $00
    jsr h25s2_x_from_sub
    lda $00
    sec
    sbc #$0001
    sta $00
    jsr h25s2_x_from_sub
    ldx #$3A54
    lda $40000E,x
    xba
    bne h25s2_overlap_y_lower_inner
    sep #$20
    lda $00
    sta $40000D,x
    rep #$20
h25s2_overlap_y_lower_inner:
    ldx $80
h25s2_overlap_y_lower_store_inner:
    lda $00
    eor #$FFFF
    inc a
    sta $00
    jsr h25s2_x_from_nonzero
    sep #$20
    lda $00
    sta $40000D,x
    rep #$20
    jmp h25s2_overlap_meta

h25s2_overlap_y_above:
    ldx $80
    lda $400008,x
    xba
    sta $04
    eor #$8000
    sta $82
