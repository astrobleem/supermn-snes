    xba
    ; CALL-BRIDGE bsr.w $2ad4c -> ojmp_hook (callee --table escape, else interpret), resume br2a86e_9
    lda #br2a86e_9
    sta $54
    lda #$00F8
    sta $56
    jsl.l push32_l
    lda #$AD4C
    sta $40
    lda #$0002
    sta $42
    jml.l ojmp_hook
br2a86e_9:
    ; restore real 68K call return residue below A7: $02A954
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$0002
    xba
    sta $400000,x
    xba
    inx
    inx
    lda #$A954
    xba
    sta $400000,x
    xba
    jmp L2a86e_2a960
L2a86e_2a956:
    lda #$0006
    sep #$20
    sta $80
    rep #$20
    lda $30
    clc
    adc #$0016
    sta $54
    lda $32
    adc #$0000
    sta $52
    jsl.l writebyte_l
    lda #$0000
    sep #$20
    sta $80
    rep #$20
    lda $30
    clc
    adc #$0017
    sta $54
    lda $32
    adc #$0000
    sta $52
    jsl.l writebyte_l
L2a86e_2a960:
    ldx $3C
    lda $400000,x
    xba
    and #$00FF
    sta $42
    inx
    inx
    lda $400000,x
    xba
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre
entry_2a86et_end:
; <<< ESCBANK7_BODIES <<<

; ============================================================================
; $0020E8 guarded production tile-strip builder.
;
; The $00:DA62 indirect call enters the retained bank-$00 lowering, which
; builds its real LINK/MOVEM frame before reaching L20e8_2108.  The organic
; late-game shape is a fixed 64-word color strip plus one 16-cell code row
; sourced from immutable ROM descriptor $0366F2.  The generic lowering spends
; roughly 29.6K SA-1 cycles routing those writes through map_snes one word at a
; time.  Prove the complete argument/frame shape before the first write, then
; write the same big-endian shadow/work bytes in the same order and enter the
; untouched MOVEM/UNLK epilogue.  Every miss replays the four bytes replaced at
; L20e8_2108 and resumes the original implementation.
; ============================================================================
    .org $A000
h20e8_guard_fail0:
    .a16
    .i16
    jmp h20e8_fallback
h20e8_fast:
    rep #$30
    .a16
    .i16

    ; Canonical work base and a bounded LINK frame containing all six args.
    lda $34
    bne h20e8_guard_fail0
    lda $36
    cmp #$00F0
    bne h20e8_guard_fail0
    lda $3A
    cmp #$00F0
    bne h20e8_guard_fail0
    lda $38
    cmp #$FFE8
    bcs h20e8_guard_fail0

    ; State already derived by the retained prologue before this seam.
    lda $32
    cmp #$00E0
    bne h20e8_guard_fail0
    lda $30
    cmp #$0F80
    bne h20e8_guard_fail0
    lda $1C
    cmp #$003F
    bne h20e8_guard_fail0
    lda $00
    cmp #$2800
    bne h20e8_guard_fail0
    jmp h20e8_guard_args

h20e8_guard_fail1:
    .a16
    .i16
    jmp h20e8_fallback
h20e8_guard_args:
    .a16
    .i16
    ldx $38
    lda $400008,x             ; first video-shadow offset
    xba
    cmp #$0380
    bne h20e8_guard_fail1
    lda $40000A,x             ; color-strip word
    xba
    cmp #$2800
    bne h20e8_guard_fail1
    lda $40000C,x             ; row origin adjustment
    xba
    bne h20e8_guard_fail1
    lda $40000E,x             ; visible row coordinate
    xba
    ; The captured descriptor has three exact clipping results in the bounded
    ; nonnegative range: two visible halves below $0170, one visible half
    ; through $017F, and a blank row through $01FF.  Y selects the matching
    ; 64-byte DMA row.  Negative and larger coordinates retain the generic
    ; implementation because their signed-edge behavior is not proved here.
    cmp #$0200
    bcs h20e8_guard_fail1
    ldy #$A480                ; two visible halves
    cmp #$0170
    bcc h20e8_row_ok
    ldy #$A4C0                ; first half visible, second half clipped
    cmp #$0180
    bcc h20e8_row_ok
    ldy #$A500                ; both halves clipped
h20e8_row_ok:
    lda $400010,x             ; immutable descriptor high word
    xba
    cmp #$0003
    bne h20e8_guard_fail1
    lda $400012,x             ; immutable descriptor low word
    xba
    cmp #$66F2
    bne h20e8_guard_fail1
    lda $400014,x             ; color-strip DBRA count
    xba
    cmp #$003F
    bne h20e8_guard_fail1
    jmp h20e8_hot

h20e8_fallback:
    .a16
    .i16
    ; Exact replay of the size-neutral bank-$00 seam before its first write.
    lda $00
    sta $80
    jml.l h20e8_fill_resume

h20e8_hot:
    .a16
    .i16
    ; This guarded writer replaces the same fixed color strip and one of only
    ; three complete code rows on every call.  Preserve an exact provenance
    ; token for those final bytes: a repeated selector cannot change the BG
    ; shadow, while every other mapped/direct BG writer invalidates the token.
    ; The cumulative dirty bit itself is still cleared only after the 5A22
    ; accepts a complete candidate, so a dropped changed selector is retained.
    tya
    cmp $410144
    beq h20e8_shadow_stable
    sta $410144
    lda #$0000
    sta $41014A                  ; changed strip no longer matches $C0BC prepared image
    lda #$0001
    sta $410140                  ; DMA writes bypass map_snes: publish BG dirtiness
    phy
    ldx #$0380                   ; code $4B80-$4BBF + color $4F80-$4FFF
    lda #$0040                   ; exact union: 64 BG cells
    jsr producer_bg_append_range
    ply
h20e8_shadow_stable:
    ; E0:0F80 maps to the shared video shadow at $41:4F80.  XBA turns
    ; emulated D0=$2800 into raw bytes 28 00.  The guarded value is fixed, so
    ; publish the same 64 words from the private-derived bank-$9D payload.
    lda $00
    sta $80
    jsr h20e8_color_dma

    ; A5+$28EA+(arg8>>4) = $F02922.  Preserve the arcade big-endian words.
    ldx $38
    lda $40000E,x             ; raw BE argument bytes (logical row coordinate)
    sta $402922
    lda #$F900
    sta $402924

    ; Publish the selected full, half-clipped, or blank code row.  Each payload
    ; preserves the retained loops' interleaved write layout and clear tail.
    jsr h20e8_code_dma

    ; Recreate the live register/scratch residues at _20e8_t53.  The retained
    ; epilogue restores D0-D6/A0-A4 from the real emulated stack; D7 is the one
    ; architecturally visible register not covered by that MOVEM.
    lda #$FFFF
    sta $00                   ; D0.W exhausted zero-fill counter
    sta $08                   ; D2.W exhausted outer DBRA
    sta $0C                   ; D3.W exhausted tile counter
    lda #$203F
    sta $04                   ; final second-half tile in D1.W
    lda #$0019
    sta $10                   ; D4.W after fourteen SUB.W #$10
    ldx $38
    lda $40000E,x
    xba
    clc
    adc #$0020
    sta $14                   ; D5.W = input row + both half-row advances
    lda #$00F9
    sta $18                   ; D6.W row coordinate
    lda #$0004
    sta $1C                   ; MOVEQ #4,D7 result
    stz $1E
    lda #$0BC2
    sta $20                   ; final A0
    lda #$00E0
    sta $22
    lda #$672E
    sta $28                   ; final A2
    lda #$0003
    sta $2A
    lda #$66F2
    sta $2C                   ; A3 descriptor remains at its base
    lda #$0003
    sta $2E
    lda #$0BC0
    sta $30                   ; final A4
    lda #$00E0
    sta $32
    stz $80                   ; final generic write was a clear
    lda #$00E0
    sta $52
    lda #$0BBE
    sta $54
    lda #$4BBE
    sta $6A
    lda #$0001
    sta $C2
    lda #$0040
    sta $9A
    stz $9C
    ; The last architectural flag-setting instruction is ADD.W #$40,A4.
    ; For this guarded address range its result is positive/nonzero with no
    ; carry or overflow, so X/N/Z/V/C are all clear.  The old helper omitted
    ; this export even though its registers and writes matched the oracle.
    stz $A2
    stz $70
    stz $60
    stz $72
    stz $6E
    jml.l _20e8_t53

; Synchronous SA-1 DMA is safe here: production snapshots the live bank-$41
; shadow only while the SA-1 is asleep at the real $0818 boundary.  Both
; helpers acknowledge completion and disable DMA before returning.
h20e8_color_dma:
    sep #$20
    .a8
    .i16
    lda #$20
    sta $220B
    lda #$84                   ; PRG ROM -> physical BW-RAM bank 1
    sta $2230
    stz $2232                  ; source $9D:A400
    lda #$A4
    sta $2233
    lda #$9D
    sta $2234
    lda #$80                   ; 128 bytes
    sta $2238
    stz $2239
    lda #$80                   ; destination $41:4F80
    sta $2235
    lda #$4F
    sta $2236
    lda #$01
    sta $2237                  ; writing destination bank triggers DMA
    lda #$20
    sta $220B
    stz $2230
    rep #$20
    .a16
    rts

h20e8_code_dma:
    sep #$20
    .a8
    .i16
    lda #$20
    sta $220B
    lda #$84                   ; PRG ROM -> physical BW-RAM bank 1
    sta $2230
    sty $2232                  ; selected source $9D:A480/$A4C0/$A500
    lda #$9D
    sta $2234
    lda #$40                   ; 64 bytes
    sta $2238
    stz $2239
    lda #$80                   ; destination $41:4B80
    sta $2235
    lda #$4B
    sta $2236
    lda #$01
    sta $2237                  ; writing destination bank triggers DMA
    lda #$20
    sta $220B
    stz $2230
    rep #$20
    .a16
    rts
h20e8_fast_end:

; ============================================================================
; Guarded constant-list body for $00CAF6 list $032FCA.
;
; Bank $97's selector and address guards have already proved the immutable
; five-record arcade-ROM list, bounded A6 frame, all five A1 pointers, and A2
; output record before entering here.  The established $032F78 body cannot
; grow in its nine-byte bank-$95 tail, so keep this second exact list shape in
; the free portion of bank $9D.  The first record takes CB9E's TST-only return;
; the remaining four reproduce its positive path in original record order.
; ============================================================================
    .org $A200
hcaf6_32fca:
    rep #$30
    .a16
    .i16

    ; Frame invariants used by all five records.
    lda $38
    clc
    adc #$FFDE                    ; [A6-$22]
    tax
    lda $400000,x
    xba
    sta $80
    lda $38
    clc
    adc #$FFE2                    ; [A6-$1E]
    tax
    lda $400000,x
    xba
    sta $82
    lda $38
    sec
    sbc #$0024                    ; BTST #7,[A6-$24]
    tax
    lda $400000,x
    and #$0080
    sta $84
    lda $38
    clc
    adc #$FFAE                    ; low word of [A6-$54]
    tax
    lda $400000,x
    xba
    sta $28                       ; final/working A2 low
    lda #$00F0
    sta $2A
    lda $38
    clc
    adc #$FFCA                    ; first [A6-$38+offset] pointer low
    sta $86

    ; Record 0: offset 0, tuple (-64,-64,-32,-32,$80000000,$FFFF).
    ; Its freshly written $FFFF word makes CB9E return at the initial TST.
    jsr hcaf6_32fca_next_a1
    ldx $24
    lda #$FFFF
    sta $400000,x
    lda #$0000
    sta $40000E,x
    lda #$8000
    clc
    adc $18
    xba
    sta $40000A,x
    lda #$0000
    sta $40000C,x

    ; Records 1-4.  Parameters are x, y, local-x, local-y, and type.
    lda #$0007
    sta $88
    lda #$000F
    sta $8A
    lda #$FFE6
    sta $8C
    lda #$FFEC
    sta $8E
    stz $90
    jsr hcaf6_32fca_record

    lda #$FFFA
    sta $88
    lda #$0003
    sta $8A
    lda #$FFED
    sta $8C
    stz $8E
    lda #$0001
    sta $90
    jsr hcaf6_32fca_record

    lda #$FFE9
    sta $88
    lda #$FFFC
    sta $8A
    lda #$0001
    sta $8C
    lda #$0018
    sta $8E
    lda #$0002
    sta $90
    jsr hcaf6_32fca_record

    lda #$FFE9
    sta $88
    lda #$000D
    sta $8A
    lda #$FFE6
    sta $8C
    lda #$0018
    sta $8E
    lda #$0003
    sta $90
    jsr hcaf6_32fca_record

hcaf6_32fca_done:
    ; Five ADDA.L #$10,A0 operations and the exhausted DBRA residue.
    lda #$301C
    sta $20
    lda #$0003
    sta $22
    lda #$FFFF
    sta $1C
    jml.l Lcaf6_cb9c

hcaf6_32fca_next_a1:
    ldx $86
    lda $400000,x
    xba
    sta $24
    lda #$00F0
    sta $26
    lda $86
    clc
    adc #$0004
    sta $86
    rts

hcaf6_32fca_record:
    jsr hcaf6_32fca_next_a1
    ldx $24

    ; Outer CAF6 record copy: positive active word, cleared link, type+D6.
    lda #$0001
    xba
    sta $400000,x
    lda #$0000
    sta $40000E,x
    lda $90
    clc
    adc $18
    xba
    sta $40000A,x
    lda #$0000
    sta $40000C,x

    ; CB9E local bounds derived from [A6-$22].
    lda $80
    clc
    adc $8C
    xba
    sta $400006,x
    lda $80
    clc
    adc $8E
    xba
    sta $400008,x

    ; MOVE.B #0,D2 preserves D2's high byte from the preceding record.
    sep #$20
    stz $08
    rep #$20
    .a16
    lda $84
    bne hcaf6_32fca_mirrored
    lda $88
    sta $00
    lda $8A
    sta $04
    bra hcaf6_32fca_position_ready
hcaf6_32fca_mirrored:
    lda $8A
    eor #$FFFF
    inc a
    sta $00
    lda $88
    eor #$FFFF
    inc a
    sta $04
    lda $08
    eor #$FFFF
    inc a
    sta $08
    sep #$20
    .a8
    lda $08
    clc
    adc #$80
    sta $08
    rep #$20
    .a16

hcaf6_32fca_position_ready:
    ; D3 first holds X, then Y.  The second ADD.W supplies final X.
    lda $82
    clc
    adc $00
    sta $92
    ldx $24
    xba
    sta $400002,x
    lda $82
    clc
    adc $04
    sta $0C
    bcc hcaf6_32fca_x_clear
    lda #$0001
    sta $A2
    bra hcaf6_32fca_x_done
hcaf6_32fca_x_clear:
    stz $A2
hcaf6_32fca_x_done:
    lda $0C
    xba
    sta $400004,x
    sep #$20
    .a8
    lda $08
    sta $40000C,x
    rep #$20
    .a16

    ; A2 publication order is observable when output records alias.
    ldx $28
    lda #$0001
    xba
    sta $400000,x
    lda $0C
    xba
    sta $400004,x
    lda $92
    xba
    sta $400002,x

    ; Final MOVE.W flags come from [A1+2]; V/C clear and X is preserved.
    lda $92
    beq hcaf6_32fca_z_set
    stz $60
    bra hcaf6_32fca_z_done
hcaf6_32fca_z_set:
    lda #$0001
    sta $60
hcaf6_32fca_z_done:
    lda $92
    and #$8000
    sta $70
    stz $72
    stz $6E
    rts

hcaf6_32fca_end:

; Private-derived bytes generated by tools/gen_escbank7_bodies.py.  Keeping
; the payload in PRG ROM makes both fixed $20E8 shadow transfers synchronous
; SA-1 DMA operations without committing any arcade ROM material.
    .org $A400
h20e8_dma_data:
    .incbin "h20e8_dma_data.bin"
    ; Poppy emits .incbin bytes without advancing its logical PC.  Pin the
    ; first byte after this 320-byte payload explicitly so later .org blocks
    ; cannot silently overwrite it.
    .org $A540
h20e8_dma_data_end:

; Append one contiguous, even-aligned BG-cell range to the producer-owned
; cumulative touch list at $41:1200.  NMI clears this list only after it has
; copied and accepted a complete candidate, so busy/dropped candidates retain
; every cell needed relative to the accepted baseline.  Unknown writers set
; status $FFFF and make this helper a no-op; overflow does the same rather than
; risking a partial manifest.
;
; 65816 has no STA long,Y encoding: Poppy silently shortened the former
; `sta $411200,y` to `sta $1200,y`.  Native callers enter with DBR=$00, so that
; version advanced the published length without writing the bank-$41 list.
; Establish DBR=$41 explicitly around the absolute,Y loop and restore the
; caller's bank on every exit.
;
; in: X=first BG byte offset (0..$03FE), A=cell count
; out: A/X/Y and $8C scratch clobbered
producer_bg_append_range:
    rep #$30
    sta $8C
    phb
    sep #$20
.a8
    lda #$41
    pha
    plb
    rep #$20
.a16
    lda $41014C
    cmp #$FFFF
    beq pbar_done
    lda #$0001
    sta $41014C
    lda $41014E
    tay
pbar_loop:
    cpy #$0400
    bcs pbar_overflow
    txa
    sta $1200,y
    inx
    inx
    iny
    iny
    dec $8C
    bne pbar_loop
    tya
    sta $41014E
pbar_done:
    plb
    rts
pbar_overflow:
    lda #$FFFF
    sta $41014C
    bra pbar_done
producer_bg_append_range_end:

; ============================================================================
; $003C36 settled-gameplay state/update fast path.
;
; The production tick reaches this routine with the three input transition
; classes stable-high, both pulse counters idle, and the stage index below
; nine.  The generated implementation still routes that simple case through
; $3E32, three copies of the generic two-bit classifier, $3E88, $3EAC, and the
; general EA helpers.  This guarded path reproduces the resulting register
; file, CCR/X contract, C-Chip backing byte, and every generated native-stack
; residue.  Any other state resumes the untouched generated body before its
; first write.
; ============================================================================
    .org $A800
h3c36_fast:
    rep #$30
.a16
.i16

    ; Canonical work-RAM base and a non-wrapping task stack with room for the
    ; deepest generated $3E6A residue at entry A7-$14.
    lda $34
    bne h3c36_fast_guard_fail
    lda $36
    cmp #$00F0
    bne h3c36_fast_guard_fail
    lda $3E
    cmp #$00F0
    bne h3c36_fast_guard_fail
    lda $3C
    cmp #$0014
    bcc h3c36_fast_guard_fail
    sta $82

    ; This route ends by clearing C-Chip bits 2/3.  Stage nine instead sets
    ; them, while stages above nine leave through the caller's early branch.
    lda $401C62
    xba
    cmp #$0009
    bcs h3c36_fast_guard_fail

    ; $3E32 yields transition class one only when the previous and current
    ; samples are both set for bits 0, 1, and 2.  Prove that complete shape
    ; before replacing its three classifier calls.
    sep #$20
.a8
    lda $401C50
    and #$07
    cmp #$07
    rep #$20
.a16
    bne h3c36_fast_guard_fail
    lda $401C6C
    xba
    and #$0003
    cmp #$0003
    bne h3c36_fast_guard_fail
    lda $401C72
    xba
    and #$0004
    cmp #$0004
    bne h3c36_fast_guard_fail

    ; Both pulse state machines must take their immediate idle branches.
    lda $401C7C
    bne h3c36_fast_guard_fail
    bra h3c36_fast_hot

h3c36_fast_guard_fail:
    jmp h3c36_fast_cold

h3c36_fast_hot:
    ; Final $3E32 architectural state. MOVE.B preserves D0's other bytes;
    ; MOVE.W preserves D1/D2 high words; MOVE.B #2 preserves D3's other bytes.
    sep #$20
.a8
    lda $401C50
    sta $00
    lda #$02
    sta $0C
    rep #$20
.a16
    lda $401C72
    xba
    sta $04
    lda #$0001
    sta $08

    ; The current D0 word becomes both classifier histories.  Raw long stores
    ; are byte-swapped so the emulated 68K view remains big-endian.
    lda $00
    xba
    sta $401C6C
    sta $401C72
    lda #$0100                 ; logical big-endian word $0001
    sta $401C6E
    sta $401C70
    sta $401C74
    lda #$0000
    sta $401C7A               ; clear the adjacent $1C7A/$1C7B bytes

    ; Final address-register effects: A0=$F01C74 and A4=long(A5+$3EDE).
    lda #$1C74
    sta $20
    lda #$00F0
    sta $22
    lda $403EDE
    xba
    sta $32
    lda $403EE0
    xba
    sta $30

    ; $900007 is the C-Chip shared-RAM byte at $41:F007.  The two final BCLR
    ; instructions clear bits 2/3; only Z changes on the last BCLR.
    sep #$20
.a8
    lda $41F007
    sta $80
    and #$F3
    sta $41F007
    rep #$20
.a16
    stz $60
    lda $80
    and #$0008
    bne h3c36_fast_z_done
    lda #$0001
    sta $60
h3c36_fast_z_done:
    lda #$0001
    sta $70                    ; CMP.W stage-9 result is negative for 0..8
    sta $6E                    ; and carries a 68K borrow
    stz $72
                               ; BCLR leaves X untouched

    ; Recreate the below-A7 memory left by the generated native call tree:
    ;   A7-$14  D0 from the second $3E6A call
    ;   A7-$10  D0 from the inlined third classifier
    ;   A7-$0C  D1 from the inlined third classifier
    ;   A7-$08  native return sentinel for $3EAC -> br3c36_5
    ;   A7-$04  native return sentinel supplied by the $3A92 caller
    lda $82
    sec
    sbc #$0014
    tax
    lda $02
    xba
    sta $400000,x
    inx
    inx
    lda $00
    xba
    sta $400000,x

    lda $82
    sec
    sbc #$0010
    tax
    lda $02
    xba
    sta $400000,x
    inx
    inx
    lda $00
    xba
    sta $400000,x

    lda $82
    sec
    sbc #$000C
    tax
    lda $06
    xba
