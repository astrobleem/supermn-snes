; ============================================================================
; Shared paced-OBJ capture state reset.
;
; $41:0128 retains its legacy 1/2 alternating-buffer token while pacing is
; disabled. Under production pacing it instead carries $CA01=request,
; $CA03=capturing, or $CA02=ready. Every full or short OBJ transfer invalidates
; the prior token before guards/fallbacks, so a later NMI cannot consume a
; buffer from the wrong game tick.
; ============================================================================
    .org $87C0
hobj_capture_reset:
    rep #$30
    lda $0734
    beq hocr_done
    lda #$0000
    sta $410128
hocr_done:
