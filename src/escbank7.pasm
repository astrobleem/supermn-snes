hobj_capture_reset_end:

; ============================================================================
; Relocated $00158E sprite-shadow transfer.
;
; The unpaced path is the semantic implementation formerly at $99:F800: three
; 1020-byte work-RAM -> live-shadow transfers plus private alternating buffers.
; Production and unpaced execution both retain the proven SA-1 copy into the
; live shadow.  A synchronous 5A22 bank-$40 DMA experiment was rejected on
; 2026-07-20: its first organic captures drove the 5A22 stack through zero and
; into STP, while a same-state no-DMA acknowledge stayed balanced.  The rejected
; helper remains below only as a labelled negative-result artifact; it has no
; production caller.
; ============================================================================
    .org $8800
h158_esc7:
    rep #$30
    ; Local labels assemble in synthetic bank $00; force the mapped bank byte
    ; for this cross-island RTL helper just as external escape imports do.
    jsl.l $9D87C0

    ; Re-simulate the outer jsr return push skipped by the native call hook.
    lda $40
    sta $54
    lda $42
    sta $56
    jsl.l push32_l

    ; Fast path requires all three sources to remain inside 68K work RAM.
    lda $36
    cmp #$00F0
    beq h158_bank_ok
    jmp h158_fallback
h158_bank_ok:
    lda $34
    clc
    adc #$28EA
    bcc h158_hot_ready
    jmp h158_fallback
h158_hot_ready:

    ; Preserve the final inner-BSR return residue below the emulated A7.
    lda $3C
    sec
    sbc #$0004
    tax
    lda #$15AA
    jsl.l h158_dma_residue

h158_shadow_copy:
    ; Legacy/unpaced semantic transfer and immutable A/B snapshot publication.
    lda $3300
    inc a
    and #$0001
    beq h158_snapshot_a
    lda #$5C00
    sta $9A
    lda #$0002
    sta $9C
    bra h158_snapshot_ready
h158_snapshot_a:
    lda #$5000
    sta $9A
    lda #$0001
    sta $9C
h158_snapshot_ready:

    ldx #$3002
    lda $9A
    clc
    adc #$0002
    tay
    lda $34
    clc
    adc #$1CF6
    jsl.l h158_dma_1020

    ldx #$4402
    lda $9A
    clc
    adc #$0802
    tay
    lda $34
    clc
    adc #$20F2
    jsl.l h158_dma_1020

    ldx #$4002
    lda $9A
    clc
    adc #$0402
    tay
    lda $34
    clc
    adc #$24EE
    jsl.l h158_dma_1020

    lda $9C
    sta $410128
h158_copy_done:
    jsl.l h158_set_ccr

    ; Observable post-incremented 68K address registers.
    lda $34
    clc
    adc #$28EA
    sta $20
    lda $36
    adc #$0000
    sta $22
    lda #$03FE
    sta $24
    lda #$00E0
    sta $26

    ; Faithful 68K RTS: pop the big-endian return PC and advance emulated A7.
    ldx $3C
    sep #$20
    lda $400000,x
    xba
    lda $400001,x
    rep #$20
    sta $42
    inx
    inx
    sep #$20
    lda $400000,x
    xba
    lda $400001,x
    rep #$20
    sta $40
    lda $3C
    clc
    adc #$0004
    sta $3C
    jml.l ors_pre

h158_fallback:
    ; Return is already pushed. Emulate LEA $1CF6(a5),a0, then interpret from
    ; the next instruction so this cannot redispatch the fixed $99:F800 hook.
    lda $34
    clc
    adc #$1CF6
    sta $20
    lda $36
    adc #$0000
    sta $22
    lda #$1592
    sta $40
    stz $42
    jml.l inext

; REJECTED LAB HELPER — deliberately unreachable from h158_esc7.
; The request/ack protocol itself balanced when the DMA body was replaced by an
; immediate acknowledge, but the real three-plane bank-$40 DMA made the 5A22
; stack underflow and eventually execute STP.  Keep this body only so the raw
; negative evidence remains reproducible until the campaign ledger records it.
h158_paced_capture:
    php
    sei
    sep #$20
    lda #$80
    sta $220B
    sta $220A
    rep #$20
    lda $34
    sta $41012E
    lda #$CA01
    sta $410128          ; publish request only after the source base is stable
    sep #$20
    lda #$80
    sta $2209
h158_capture_wait:
    wai
    rep #$20
    lda $410128
    cmp #$CA02
    beq h158_capture_done
    sep #$20
    bra h158_capture_wait
h158_capture_done:
    sep #$20
    stz $2209
    stz $220A
    lda #$80
    sta $220B
    rep #$20
    plp
    rep #$30
    rts

