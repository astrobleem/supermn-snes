h25s2_qualifying:
    inc $5C
    lda $5C
    cmp #$0011
    bcc h25s2_count_ok
    jmp h25s2_fallback
h25s2_count_ok:
    ; Preserve the exact D0.W residue of the retained comparison order while
    ; keeping it speculative until the complete no-overlap proof succeeds.
    ; XOR $8000 maps signed 68K word order to unsigned 65816 order; the
    ; architected residue remains the original, unbiased outer edge in $5A.
    lda $50                  ; D0 = outer x1
    sta $5A
    eor #$8000
    sta $58
    lda $400004,x            ; inner x2 >= outer x1
    xba
    eor #$8000
    cmp $58
    bcc h25s2_next

    lda $52                  ; D0 = outer x2
    sta $5A
    eor #$8000
    sta $58
    lda $400002,x            ; outer x2 >= inner x1
    xba
    eor #$8000
    sta $5E
    lda $58
    cmp $5E
    bcc h25s2_next

    lda $54                  ; D0 = outer y1
    sta $5A
    eor #$8000
    sta $58
    lda $400008,x            ; inner y2 >= outer y1
    xba
    eor #$8000
    cmp $58
    bcc h25s2_next

    lda $56                  ; D0 = outer y2
    sta $5A
    eor #$8000
    sta $58
    lda $400006,x            ; outer y2 >= inner y1
    xba
    eor #$8000
    sta $5E
    lda $58
