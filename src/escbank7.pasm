    sta $56                  ; outer y2
    lda $00
    sta $5A                  ; speculative final D0.W
    stz $5C                  ; qualifying-inner count

    ldx #$3A74
    ldy #$0020
h25s2_scan:
    lda $400000,x
    xba
    beq h25s2_inactive
    bmi h25s2_inactive
    bra h25s2_type
h25s2_inactive:
