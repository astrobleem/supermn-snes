#Title Coin
#Composer Masahiko Takaki, Kazuyuki Ohnui, Shizuo Aizawa, Takami Asano
#Author vgm2mml (Superman YM2610 conversion)
#Tempo 76
#ZenLen 192

; Echo — tame defaults; tune to taste.
#EchoLength 32
#EchoFeedback 32
#EchoVolume 24
#FirFilter 64 0 0 0 0 0 0 0

; --- instrument bindings (STUBS — replace sources in the .terrificaudio) ---
@0 sm_fm0
@1 sm_fm1
@2 sm_fm2
@3 sm_fm3
@10 sm_drum_062a00
@11 sm_drum_06c500
@12 sm_drum_075800
@13 sm_drum_07b500

; ===== Voice A: FM0  (octaves 2-4) =====
