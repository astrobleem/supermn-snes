# ============================================================================
# Superman (Taito X) -> SNES/SA-1  —  .gitignore
#
# HARD RULE: never commit copyrighted arcade ROM material or anything derived
# from it (extracted 68K image, gfx/sprite/palette dumps, built ROMs that embed
# the 68K image). Contributors must supply their own legally-obtained ROMs.
# ============================================================================

# --- Copyrighted arcade ROM sets, recordings, and extracted data ---
*.zip
*.rom
*.smc
*.sfc
data/superman_m68k.bin
data/cchip_boot_response.bin

# --- All binaries: every *.bin here is generated by the build or extracted
#     from the arcade ROM. None are hand-authored source. ---
*.bin
*.pansy

# --- Data derived from the arcade ROM (traces, CDL, extracted gfx, save states,
#     disassembly of copyrighted code). All generated/extracted, none authored. ---
*.log
*.cdl
*.dasm
*.sta
*.cgram
*.palassign
*.tiles
*.wav
*.vgm
data/

# --- Build outputs ---
build/
distribution/
*.o
*.lst

# --- MAME / emulator working dirs and large trace corpora (extracted data) ---
.mame_mcp/
snap/
tools/mame-trace/*.bin
tools/mame-trace/traces/
tools/mame-trace/*.inp
# Input recordings: ignore the dir, but TRACK our own MAME-0.287 playthroughs (input
# timings only, no ROM data) used by the validation pipeline. Old cross-version
# recordings (0.185/0.193) won't replay on 0.287 and are not kept.
inp/*
!inp/superman_play.inp
!inp/vplay.inp

# --- Renders & screenshots (derivative arcade imagery / generated proofs) ---
*.png

# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo

# --- Transient analysis dumps / scratch ---
*.txt
*.lua
tmp*
/irq_probe.txt
/snd_status.txt
/spin*.txt
/sub*_regs.txt

# --- MAME per-run config (input/dip state; regenerable, not source) ---
tools/mame-trace/cfg*/

# --- Derivative audio (converted from the copyrighted game's music) ---
*.mml
*.terrificaudio

# --- Local editor / agent state ---
.claude/settings.local.json

# --- Audio working assets (large, extracted/derived) ---
audio/samples/
audio/songs/*.vgm

# Keep: requirements / lockfiles even though *.txt is ignored above
!requirements.txt
